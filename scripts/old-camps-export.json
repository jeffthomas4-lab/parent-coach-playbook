INSERT INTO "camps" ("id","slug","name","sport","age_min","age_max","start_date","end_date","address","city","state","zip","latitude","longitude","description","price_text","day_or_overnight","skill_level","spots_status","contact_email","contact_phone","website_url","lunch_included","aftercare_available","status","submitted_by_email","submitted_at","reviewed_by","reviewed_at","review_notes","verified","hero_photo_key","is_claimed","claimed_by_email","claim_paid_until","logo_key","gallery_keys","registration_url","last_edited_at","last_edited_by","program_type","registration_deadline","schedule_text","confidence","source_domain","reject_reason_code","url_health_status","url_last_checked_at","url_last_status_code","awaiting_review","featured","featured_order","featured_until") VALUES('64c7eb46-b824-4627-97d5-ed0fadfe2d87','nike-golf-camp-at-links-and-tees-golf-facility-june-8-12-2026','Nike Golf Camp at Links and Tees Golf Facility -  (June 8–12, 2026)','golf',7,17,'2026-06-08','2026-06-12','900 W Lake St','Addison','IL','60101',41.9459472,-88.0209721,'Get ready for an unforgettable summer golf experience with Nike Golf Camp director, Jake Thurm, at Links and Tees Golf Facility in Addison, Illinois! From beginners learning fundamentals to advanced juniors fine-tuning their competitive edge, each camper receives top-tier instruction in a fun, energetic environment. Come see why thousands of junior golfers nationwide have attended this program. WORLD CLASS INSTRUCTION Named one of Golf Digest’s “Best Young Teachers in America” for three consecutive years, Jake brings elite-level expertise and real tour experience to every session. His coaching background includes: 200+ PGA Tour events coached20+ Major ChampionshipsMultiple PGA Tour winnersMidwest Director for the USA Junior National Golf TeamHigh School State championsIllinois Open champions Parents can feel confident knowing their child is learning from some of the most qualified professionals in youth golf development. PERSONALIZED COACHING &amp; DEVELOPMENT PLANS Every camper receives a personalized swing video analysis during the camp. Using professional coaching software from V1 Sports, Jake records and breaks down each golfer’s swing to highlight strengths and identify key areas for improvement. Campers will receive their analysis and development plan to take home after camp, allowing them to review their swing, understand the coaching feedback, and continue improving long after the camp ends. DAILY INSTRUCTION All camp activities take place at Links &amp; Tees Golf Facility giving campers access to a unique training environment that includes an indoor hitting dome, expansive outdoor driving range, and short game practice areas. This program provides daily instruction covering all areas of the game, including putting, chipping, bunker play, and full swing mechanics. Campers receive hands-on coaching, engaging drills, tournament guidance, recruiting support and golf-specific strength, mobility and speed training. Half Day Camp: Monday-Friday, 9:00am-12:00pm (ages 7-13)Full Day Camp: Monday-Friday, 9:00am-3:00pm (ages 9-17) COURSE PLAY (FULL DAY CAMP ONLY) Full Day campers will have the opportunity to take their skills from the practice area onto the junior-friendly 9-hole course each afternoon. Coaches provide instruction throughout the round, helping players work on course strategy, AimPoint green reading, shot selection, mental performance and confidence. Please note: Lunch will NOT be provided for campers. Campers should bring their own lunch each day.','$499-$849','day','all','open','','','https://www.ussportscamps.com/golf/nike/nike-golf-camp-links-and-tees',0,0,'pending','parentcoachplaybook@gmail.com','2026-05-09T22:18:03.376Z',NULL,NULL,NULL,0,NULL,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'camp',NULL,NULL,'medium','ussportscamps.com',NULL,'live','2026-05-09T22:18:05.038Z',200,0,0,NULL,NULL);
