oric Parade Grounds in Brooklyn.','$399','day','all','open','','','https://www.ussportscamps.com/soccer/nike/nike-soccer-camp-brooklyn-new-york#session-84265-1220166',0,0,'approved','parentcoachplaybook@gmail.com','2026-05-09T15:07:00.240Z','support@parentcoachdesk.com','2026-05-09 15:11:25','Bulk approve ussportscamps harvester run',0,NULL,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'camp',NULL,NULL,'medium','ussportscamps.com',NULL,'live','2026-05-09T15:07:02.662Z',200,0,0,NULL,NULL);
