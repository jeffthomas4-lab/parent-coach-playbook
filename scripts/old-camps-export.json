INSERT INTO "camps" ("id","slug","name","sport","age_min","age_max","start_date","end_date","address","city","state","zip","latitude","longitude","description","price_text","day_or_overnight","skill_level","spots_status","contact_email","contact_phone","website_url","lunch_included","aftercare_available","status","submitted_by_email","submitted_at","reviewed_by","reviewed_at","review_notes","verified","hero_photo_key","is_claimed","claimed_by_email","claim_paid_until","logo_key","gallery_keys","registration_url","last_edited_at","last_edited_by","program_type","registration_deadline","schedule_text","confidence","source_domain","reject_reason_code","url_health_status","url_last_checked_at","url_last_status_code","awaiting_review","featured","featured_order","featured_until") VALUES('ffdf987b-711c-4a9b-a7d6-5307d66fd788','nike-golf-camp-at-peacock-gap-golf-club-full-day-camp-july-6-10-2026','Nike Golf Camp at Peacock Gap Golf Club - Full Day Camp (July 6–10, 2026)','golf',10,15,'2026-07-06','2026-07-10','333 Biscayne Drive','San Rafael','CA','94901',37.9967012,-122.4666769,'Get ready for an amazing experience in San Rafael! Join one of our top Nike Camp Directors, Val Verhunce, this summer at Peacock Gap Golf Club. This camp provides top-notch instruction, so come and see why thousands of campers have attended this junior golf program. Improve your game and have fun with our experienced teaching professionals this summer! Summer Full Day Full day campers receive three hours of instruction each day with emphasis on putting, chipping, bunker play and full swing. After morning instruction and a break for lunch, campers will get to apply what they have learned out on the course (course play when available). During course play our professionals teach strategy, etiquette and course management. The Full Day Camp is designed to create complete golfers and raise their game to the next level. Full Day Camps run Monday through Friday from 9:00am - 4:00pm and are open to players of all abilities, ages 10-15. Please note: Lunch is provided for full day campers each day. Summer Half Day 9:00am-12:00pm/1:00pm-4:00pm This program is designed to pique the interest of new golfers while also offering intermediate golfers the instruction needed to improve. Half day campers receive three hours of instruction each day with emphasis on putting, chipping, bunker play and full swing. Campers rotate between stations and participate in drills, skills challenges, and other games. Half Day Camps run Monday through Friday from 9:00am - 12:00pm and 1:00pm - 4:00pm and are open to players of all abilities, ages 5-15. Please note: Lunch is NOT provided for half day campers each day. Nike Camp Skills Challenge The Nike Camp Challenge is an amazing opportunity for your child to put the skills they’ve learned to the test! After participating in one of the full day summer sessions, our camp director will be putting on a Skills Challenge testing the skills of select campers. The top two winners* of the skills challenge will qualify and compete in an on-course tournament that afternoon. The Skills Challenge will be a competitive event with photo opportunities (parents are welcome to attend!) and chances to win special prizes. *Notes: Only campers who are registered for the Summer Full Day sessions and are selected at camp are eligible for the Skills Challenge.','$999','day','all','open','','','https://www.ussportscamps.com/golf/nike/nike-golf-camp-peacock-gap',0,0,'pending','parentcoachplaybook@gmail.com','2026-05-09T22:17:39.782Z',NULL,NULL,NULL,0,NULL,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'camp',NULL,NULL,'medium','ussportscamps.com',NULL,'live','2026-05-09T22:17:41.447Z',200,0,0,NULL,NULL);
