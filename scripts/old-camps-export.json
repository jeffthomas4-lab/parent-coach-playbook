mmer.','$299-$430','day','all','open','','','https://www.ussportscamps.com/soccer/nike/nike-soccer-camp-university-of-south-florida',0,0,'approved','parentcoachplaybook@gmail.com','2026-05-09T20:22:06.252Z',NULL,NULL,NULL,0,NULL,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'camp',NULL,NULL,'medium','ussportscamps.com',NULL,'live','2026-05-09T20:22:07.782Z',200,1,0,NULL,NULL);
