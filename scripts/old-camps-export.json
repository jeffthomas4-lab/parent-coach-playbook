ve spirit.','$379','day','all','open','','','https://www.ussportscamps.com/baseball/nike/nike-baseball-camp-toms-river',0,0,'approved','parentcoachplaybook@gmail.com','2026-05-09T18:33:15.125Z','support@parentcoachdesk.com','2026-05-09 18:36:46','Bulk approve ussportscamps run',0,NULL,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'camp',NULL,NULL,'medium','ussportscamps.com',NULL,'live','2026-05-09T18:33:15.438Z',200,0,0,NULL,NULL);
