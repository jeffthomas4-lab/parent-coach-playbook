INSERT INTO "camps" ("id","slug","name","sport","age_min","age_max","start_date","end_date","address","city","state","zip","latitude","longitude","description","price_text","day_or_overnight","skill_level","spots_status","contact_email","contact_phone","website_url","lunch_included","aftercare_available","status","submitted_by_email","submitted_at","reviewed_by","reviewed_at","review_notes","verified","hero_photo_key","is_claimed","claimed_by_email","claim_paid_until","logo_key","gallery_keys","registration_url","last_edited_at","last_edited_by","program_type","registration_deadline","schedule_text","confidence","source_domain","reject_reason_code","url_health_status","url_last_checked_at","url_last_status_code","awaiting_review","featured","featured_order","featured_until") VALUES('4112844d-476c-46f9-9c6e-f245440232cb','nike-baseball-camp-in-the-hamptons-aug-24-28-2026-no4k','Nike Baseball Camp in The Hamptons -  (Aug. 24–28, 2026)','baseball',8,18,'2026-08-24','2026-08-28','Mashashimuet Park- Sag Harbor','Sag Harbor','NY','11963',NULL,NULL,'Join Nike Baseball Camps in Mashashimuet Park (Sag Harbor), hosted by New York Empire Baseball. This intensive 5-day Camp will group players by both age and skill, and players will be trained by some of the most well-trained and certified coaches in youth baseball - using the most advanced technology and engaging and in-depth instruction available. The Camp will be led by New York Empire Baseball''s advanced instructional staff - one of the most highly trained and certified in the baseball industry. The coaching staff will be led by Director of Research &amp; Training, Coach Jordan Baltimore. Coach Baltimore was the world’s first coach to receive Driveline Certification, is on the Blast Motion Advisory Board, and is also certified by OnBaseU, K-Motion, and Rapsodo Sports. He''s also the PItching Consultant to the NYU Langone Sports Performance Center, and was named to the New York City Mayor''s Baseball Advisory Commission at the Office of Sports, Wellness, and Recreation. He was previously the New York Area Director for the National Pitching Association. Instructors will utilize New York Empire Baseball''s proprietary Player Development Platform along with Blast Motion Bat Sensors and high-speed video analysis, among other technologies, to measure, assess, and define unique development programs for every player. Players will begin their week-long experience with a complete Assessment and Baseline Hitting &amp; Pitching analysis before receiving their personalized Camp training program. All players will then engage in 5 days of small group sessions in Hitting, Throwing, Infielding, Outfielding, Baserunning, and Game Situations. Each day will focus on healthy athletic development and skill acquisition in a fun &amp; engaging environment that will also teach the mental/emotional approach needed to eliminate performance anxiety and fear of failure. Players will develop skills that scale, and receive an individualized post-Camp training routine to continue their own development.','$1269','day','all','open','','','https://www.ussportscamps.com/baseball/nike/nike-baseball-camp-the-hamptons',0,0,'approved','parentcoachplaybook@gmail.com','2026-05-09T18:42:25.927Z','support@parentcoachdesk.com','2026-05-09 18:51:04','Bulk approve ussportscamps full sweep',0,NULL,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'camp',NULL,NULL,'medium','ussportscamps.com',NULL,'live','2026-05-09T18:42:27.542Z',200,0,0,NULL,NULL);
