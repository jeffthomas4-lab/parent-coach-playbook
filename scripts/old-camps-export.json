h Kyle Jones: “We create an environment where players are challenged, supported, and inspired every day. Through high-quality coaching and a love for the game, our goal is to help each athlete build confidence, develop their skills, and leave camp better both on and off the field.”','$275','day','all','open','','','https://www.ussportscamps.com/soccer/nike/nike-soccer-camp-northbrook#session-85096-1221321',0,0,'approved','parentcoachplaybook@gmail.com','2026-05-09T15:09:33.380Z','support@parentcoachdesk.com','2026-05-09 15:11:25','Bulk approve ussportscamps harvester run',0,NULL,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'camp',NULL,NULL,'medium','ussportscamps.com',NULL,'live','2026-05-09T15:09:34.907Z',200,0,0,NULL,NULL);
