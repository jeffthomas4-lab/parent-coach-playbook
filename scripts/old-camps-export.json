mail.com','2026-05-09T18:33:36.071Z','support@parentcoachdesk.com','2026-05-09 18:36:46','Bulk approve ussportscamps run',0,NULL,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'camp',NULL,NULL,'medium','ussportscamps.com',NULL,'live','2026-05-09T18:33:36.555Z',200,0,0,NULL,NULL);
