e Soccer Camp at Winsor School – Boston!','$499','day','all','open','','','https://www.ussportscamps.com/soccer/nike/nike-soccer-camp-winsor-school',0,0,'approved','parentcoachplaybook@gmail.com','2026-05-09T20:33:51.013Z',NULL,NULL,NULL,0,NULL,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'camp',NULL,NULL,'medium','ussportscamps.com',NULL,'live','2026-05-09T20:33:51.291Z',200,1,0,NULL,NULL);
