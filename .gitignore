# build output
dist/
.output/
/coverage/

# dependencies
node_modules/
studio/node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment
.env
.env.production
.env.local
.env.*.local
.env.*
!.env.example
.dev.vars
*.pem
*.key
*session*.json
*cookies*.json

# editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# astro
.astro/

# wrangler local dev/build state (miniflare D1/KV/R2/cache simulation)
.wrangler/

# sanity
.sanity/
sanity-cli.json

# generated SQL imports (don't commit)
imports/out/

buildout/bmf/*.csv
activityradar-archive/seed/0006_orgs_irs_r*.sql

# D1 backups (local snapshots, too large for git, GitHub's 100MB limit)
backups/

# tsc scratch dumps left at repo root by ad-hoc typecheck debugging (27 were
# git-tracked before this pass; untracked via git rm --cached, kept on disk)
.tsc_*.txt

# proof collection pipeline: raw screenshots stay local, README stays tracked
proof-screenshots/*
!proof-screenshots/README.md

# Failing-gate build logs from scripts/cut-release-evidence.mjs. Local debug
# artifact only: can contain environment detail, never belongs in a commit.
coordination/release-evidence/logs/

# Ad-hoc build logs dropped at the repo root by Tee-Object during debugging.
# Scoped to the root on purpose: two intentional logs are tracked deeper in the
# tree (buildout/, imports/) and a blanket *.log would shadow that pattern.
/*.log

# Generated editorial refresh queue. Fully derived from src/ by
# scripts/editorial-refresh-queue.mjs, regenerated at the top of every build and
# on npm install, and imported by src/pages/admin/editorial/index.astro.
#
# Untracked on 2026-08-05 because tracking it was a merge landmine. Two branches
# that both touch src/ each regenerate it with a different `as_of` and
# `inventory_sha256`, so EVERY merge conflicted on those two lines, and the
# conflict markers turned it into invalid JSON. Because the admin page imports
# it, the resulting failure surfaced as an opaque vite-json parse error
# ("key must be a string at line 3 column 1") rather than as a merge problem.
# That cost an evening on 2026-08-05. Do not re-track it.
reports/editorial/editorial-refresh-queue.json
