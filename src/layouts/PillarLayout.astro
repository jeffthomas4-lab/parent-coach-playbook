---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ThreeDrivesNav from '../components/ThreeDrivesNav.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import Illo from '../components/Illo.astro';
import { PILLARS, SPORTS, AGE_BANDS, type PillarSlug } from '../data/site';
import { isLive, freshnessDate } from '../lib/publishFilter';

interface Props {
  pillar: PillarSlug;
}

const { pillar } = Astro.props;
const meta = PILLARS[pillar];
const seoTitles: Record<PillarSlug, string> = {
  'drive-there': 'Before the Game: Parent Guide',
  game: 'During the Game: Parent-Coach Guide',
  'drive-home': 'After the Game: Parent Guide',
  'team-parent': 'Team Parent Resources and Tools',
};
const seoDescriptions: Partial<Record<PillarSlug, string>> = {
  'drive-there': 'Prepare for youth sports with calmer pregame conversations, practical tryout guidance, family planning, and clear expectations before anyone takes the field.',
  game: 'Make better in-game coaching decisions with practical guidance on communication, substitutions, officials, pressure, and coaching your own child on a team.',
  'drive-home': 'Handle the ride home after youth sports with calmer conversations, practical scripts, and relationship-first guidance for wins, losses, mistakes, and silence.',
};

const articles = (await getCollection('articles', ({ data }) => isLive(data) && data.phase === pillar))
  .sort((a, b) => freshnessDate(b.data).getTime() - freshnessDate(a.data).getTime());

// Collect tags actually used in this pillar.
// Exclude 'multi-sport' and 'multi-activity' from the filter chips — those
// articles are general-purpose and should always be visible regardless of
// which sport filter is active (handled in the client script below).
const ALWAYS_VISIBLE_SPORTS = ['multi-sport', 'multi-activity', 'performing-arts'];
const sportsUsed = [...new Set(
  articles.map(a => a.data.sport).filter(s => s && !ALWAYS_VISIBLE_SPORTS.includes(s))
)] as string[];
const agesUsed = [...new Set(articles.map(a => a.data.age).filter(Boolean))] as string[];
---
<BaseLayout
  title={seoTitles[pillar]}
  description={seoDescriptions[pillar] ?? meta.blurb}
>
  <section
    class="border-b border-bone"
    style={`background: ${meta.accentBg};`}
  >
    <div class="container-px py-16 md:py-20 grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-8">
        <div
          class="t-section"
          style={`color: ${meta.accent};`}
        >
          {meta.eyebrow}
        </div>
        <h1 class="t-display t-h1 mt-4">
          {meta.label}
        </h1>
        <p class="t-dek mt-6 max-w-2xl">
          {meta.blurb}
        </p>
        {pillar === 'drive-there' && (
          <figure class="mt-10">
            <Illo
              base="pillar-drive-there"
              alt="Parent driving to youth sports at dawn with a gear bag in the back seat."
              class="w-full max-w-2xl rounded-card border border-line"
              sizes="(min-width: 1024px) 672px, 100vw"
              eager={true}
            />
          </figure>
        )}
        {pillar === 'drive-home' && (
          <figure class="mt-10">
            <Illo
              base="pillar-drive-home"
              alt="Parent driving home at dusk while a child sleeps in the back seat."
              class="w-full max-w-2xl rounded-card border border-line"
              sizes="(min-width: 1024px) 672px, 100vw"
              eager={true}
            />
          </figure>
        )}
      </div>
      <aside class="lg:col-span-4 lg:pl-8 lg:border-l lg:border-bone">
        <ThreeDrivesNav active={pillar} />
      </aside>
    </div>
  </section>

  {articles.length > 0 && (
    <section>
      <div class="container-px py-12">
        <div
          class="flex flex-wrap gap-2 mb-2"
          data-filter-bar
          style={`--pill-accent: ${meta.accent}; --pill-bg: ${meta.accentBg};`}
        >
          <button data-filter="all" class="tag-pill tag-pill-active min-h-11" type="button">All issues</button>
          {sportsUsed.map(s => (
            <button data-filter-sport={s} class="tag-pill tag-pill-outline min-h-11" type="button">
              {SPORTS.find(x => x.slug === s)?.label ?? s}
            </button>
          ))}
          {agesUsed.map(a => (
            <button data-filter-age={a} class="tag-pill tag-pill-outline min-h-11" type="button">
              Age {AGE_BANDS.find(x => x.slug === a)?.label ?? a}
            </button>
          ))}
        </div>

        <div data-article-list>
          {articles.map((a) => (
            <div data-sport={a.data.sport ?? ''} data-age={a.data.age ?? ''}>
              <ArticleCard
                href={`/${a.data.phase}/${a.id}/`}
                format={a.data.format}
                sport={a.data.sport}
                age={a.data.age}
                phase={a.data.phase}
                topic={a.data.topic}
                title={a.data.title}
                dek={a.data.dek}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {articles.length === 0 && (
    <section>
      <div class="container-px py-20">
        <p class="font-display text-ink-soft text-xl">First issue is in the chamber. Subscribe below to get it.</p>
      </div>
    </section>
  )}

  <NewsletterSignup />
</BaseLayout>

<script>
  const bar = document.querySelector('[data-filter-bar]');
  const list = document.querySelector('[data-article-list]');
  if (bar && list) {
    bar.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.tagName !== 'BUTTON') return;

      // Reset visual state. Every chip back to outline.
      bar.querySelectorAll('button').forEach((b) => {
        b.classList.remove('tag-pill-active');
        b.classList.add('tag-pill-outline');
      });
      target.classList.remove('tag-pill-outline');
      target.classList.add('tag-pill-active');

      const sport = target.getAttribute('data-filter-sport');
      const age = target.getAttribute('data-filter-age');
      const all = target.getAttribute('data-filter') === 'all';

      const ALWAYS_VISIBLE = ['multi-sport', 'multi-activity', 'performing-arts'];
      list.querySelectorAll('[data-sport]').forEach((row) => {
        const r = row as HTMLElement;
        if (all) {
          r.style.display = '';
          return;
        }
        if (sport) {
          // Always show general-purpose (multi-sport) articles alongside any specific sport
          const isMatch = r.dataset.sport === sport || ALWAYS_VISIBLE.includes(r.dataset.sport ?? '');
          r.style.display = isMatch ? '' : 'none';
        } else if (age) {
          r.style.display = r.dataset.age === age ? '' : 'none';
        }
      });
    });
  }
</script>
