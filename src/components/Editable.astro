---
// Inline editor: the editable-region marker.
//
// This renders the IN-REPO FALLBACK at build time. The site is `output: 'static'`,
// so this component runs during prerender, not per request, and cannot read KV
// here. The overlay value is substituted later by HTMLRewriter in the Worker
// (see src/lib/overlay-rewriter.ts), which streams the prerendered asset and
// swaps the inner HTML of any element carrying data-pcd-editable.
//
// Consequence worth knowing: the HTML that reaches the browser and the crawler
// already contains the final text. There is no client-side swap, so no flash of
// old copy and no SEO gap. Pages carrying editable regions must be listed in
// the Worker's route set (assets.run_worker_first) or the swap never runs and
// the fallback is what ships. The route-coverage test enforces that.
//
// If the key is not in the manifest this throws at BUILD time, which is the
// right moment to catch a typo.

import { getRegion } from '../lib/editable-regions';

interface Props {
  /** Manifest key. Must exist in src/lib/editable-regions.ts. */
  key: string;
  /** The in-repo string. Rendered when the overlay has no value for this key. */
  fallback: string;
  /** Element to render. Defaults to span so it stays inline-safe. */
  as?: 'span' | 'h1' | 'h2' | 'h3' | 'p' | 'div';
  class?: string;
  /** Passed through so wrapping an existing element does not drop its styling. */
  style?: string;
}

const { key, fallback, as: Tag = 'span', class: className, style } = Astro.props;

const region = getRegion(key);
if (!region) {
  throw new Error(
    `<Editable key="${key}"> is not in the manifest. Add it to src/lib/editable-regions.ts or fix the key.`,
  );
}

// richInline fallbacks may carry the allowed inline tags; text ones must not.
const allowsMarkup = region.kind === 'richInline';
---

<Tag
  class={className}
  style={style}
  data-pcd-editable={key}
  data-pcd-kind={region.kind}
  data-pcd-max={String(region.maxLength)}
  data-pcd-label={region.label}
>
  {allowsMarkup ? <Fragment set:html={fallback} /> : fallback}
</Tag>
