---
import Logo from './Logo.astro';
import { SITE } from '../data/site';

const year = new Date().getFullYear();
---
{/* Footer sits on white, not the grey-blue page background, so it reads as a
    distinct plane instead of blending into the last section. The 3px navy top
    rule is the design system's main structural accent and separates the footer
    even when the section above it is also white. */}
<footer class="mt-24 border-t-[3px] border-navy bg-surface">
  <div class="container-px py-16 grid gap-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo size={32} />
      <p class="font-body text-ink-soft text-lg mt-6 max-w-md leading-snug">
        <em class="text-rust font-semibold not-italic">{SITE.tagline}</em>
      </p>
      <p class="font-body text-ink-soft mt-3 max-w-md leading-snug">
        {SITE.shortPitch}
      </p>
      <a href="/newsletter/" class="inline-flex items-center min-h-11 mt-5 font-body text-rust font-medium hover:underline">
        → Get the Friday Letter
      </a>
    </div>

    <div class="md:col-span-4">
      <div class="t-label mb-4">Explore</div>
      <ul class="grid gap-2.5 font-body text-ink-soft">
        <li><a href="/start-here/" class="flex items-center min-h-11 hover:text-rust">Start here</a></li>
        <li><a href="/sports/" class="flex items-center min-h-11 hover:text-rust">By sport</a></li>
        <li><a href="/reads/" class="flex items-center min-h-11 hover:text-rust">Reads</a></li>
        <li><a href="/camps/" class="flex items-center min-h-11 hover:text-rust">Camps and leagues</a></li>
        <li><a href="/cost-calculator/" class="flex items-center min-h-11 hover:text-rust">Cost calculator</a></li>
        <li><a href="/season-calendar/" class="flex items-center min-h-11 hover:text-rust">Season calendar</a></li>
      </ul>
    </div>

    <div class="md:col-span-3">
      <div class="t-label mb-4">The Desk</div>
      <ul class="grid gap-2.5 font-body text-ink-soft">
        <li><a href="/about/" class="flex items-center min-h-11 hover:text-rust">About</a></li>
        <li><a href="/newsletter/" class="flex items-center min-h-11 hover:text-rust">Newsletter</a></li>
        <li><a href="/proof/" class="flex items-center min-h-11 hover:text-rust">Reviews</a></li>
        <li><a href="/search/" class="flex items-center min-h-11 hover:text-rust">Search</a></li>
        <li><a href={`mailto:${SITE.email}`} class="flex items-center min-h-11 hover:text-rust break-words">{SITE.email}</a></li>
      </ul>
    </div>
  </div>

  {/* Silver-green hairline + palest fill steps the legal/copyright base down in
      tone from the white footer body, so the footer reads as two zones rather
      than one flat slab. Silver green is decorative here (a 1px rule), never text. */}
  <div class="border-t border-silver bg-stripe">
    <div class="container-px py-4">
      <nav aria-label="Legal and policies" class="flex flex-wrap gap-x-4 gap-y-2 font-body text-ink-soft text-sm">
        <a href="/disclosure/" class="inline-flex items-center min-h-11 hover:text-rust">Privacy &amp; disclosure</a>
        <button type="button" data-privacy-choices class="inline-flex items-center min-h-11 hover:text-rust cursor-pointer">Privacy choices</button>
        <a href="/terms/" class="inline-flex items-center min-h-11 hover:text-rust">Terms of use</a>
        <a href="/ai-transparency/" class="inline-flex items-center min-h-11 hover:text-rust">AI transparency</a>
        <a href="/accessibility/" class="inline-flex items-center min-h-11 hover:text-rust">Accessibility</a>
        <a href="/trust/" class="inline-flex items-center min-h-11 hover:text-rust">Corrections &amp; removals</a>
        <a href="/rss.xml" class="inline-flex items-center min-h-11 hover:text-rust">RSS feed</a>
      </nav>
    </div>
  </div>

  <div class="border-t border-line bg-stripe">
    <div class="container-px py-6 grid gap-3 md:flex md:justify-between md:items-center">
      <div class="font-body text-muted text-sm">
        © {year} {SITE.name}.
      </div>
      <div class="font-body text-muted text-sm md:text-right max-w-md">
        Some links pay us when you buy. Affiliate relationships are disclosed. As an Amazon Associate we earn from qualifying purchases.
      </div>
      <div class="font-body text-muted text-sm md:text-right">
        Written by {SITE.byline}.
      </div>
    </div>
  </div>
</footer>
