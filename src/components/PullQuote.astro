---
interface Props {
  quote: string;
  attribution?: string;
}
const { quote, attribution } = Astro.props;
---
<figure class="my-12 max-w-measure mx-auto">
  <blockquote class="t-quote">
    <p>{quote}</p>
  </blockquote>
  {attribution && (
    <figcaption class="t-label text-ink-soft text-center mt-5">{attribution}</figcaption>
  )}
</figure>
