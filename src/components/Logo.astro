---
// Wordmark for Parent Coach Desk.
// Three words. "Parent Coach" navy, "Desk" accent-blue italic.
//
// Variants:
//   variant="dark"   — navy + accent blue (default, on light surfaces)
//   variant="light"  — white + silver-green (use on dark surfaces)
//   variant="solid"  — single-color navy (subtle contexts)

interface Props {
  variant?: 'dark' | 'light' | 'solid';
  size?: number;        // px font-size for the mark
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'dark',
  size = 22,
  ariaLabel = 'Parent Coach Desk',
  class: className = '',
} = Astro.props;

const baseColor =
  variant === 'light' ? 'var(--surface)' :
  'var(--navy)';

const accentColor =
  variant === 'light' ? 'var(--silver)' :
  variant === 'solid' ? 'var(--navy)' :
  'var(--accent)';
---
<a
  href="/"
  aria-label={ariaLabel}
  class={`group inline-flex items-baseline min-h-11 ${className}`}
  style="text-decoration: none; white-space: nowrap;"
>
  <span
    style={`
      font-family: 'Fraunces', Georgia, serif;
      font-style: italic;
      font-weight: 500;
      font-size: ${size}px;
      line-height: 1;
      letter-spacing: -0.005em;
      color: ${baseColor};
    `}
  >Parent Coach </span><span
    style={`
      font-family: 'Fraunces', Georgia, serif;
      font-style: italic;
      font-weight: 500;
      font-size: ${size}px;
      line-height: 1;
      letter-spacing: -0.005em;
      color: ${accentColor};
    `}
  >Desk</span>
</a>
