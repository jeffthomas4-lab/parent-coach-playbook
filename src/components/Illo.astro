---
// Responsive illustration image.
//
// Every file in public/illustrations/ is authored at 1536w. That is four times
// wider than a phone needs, and before this component the homepage shipped the
// full 1536w file to a 375px viewport — 134KB for the hero alone. The build
// step scripts/build-illustration-variants.py writes a -480.webp and a -960.webp
// next to each source file, and this component points srcset at them so a phone
// downloads ~22KB instead.
//
// Pass `base` as the filename with no extension and no path:
//   <Illo base="the-car-ride-home" alt="..." sizes="(min-width: 768px) 33vw, 100vw" />
//
// width/height are always emitted so the browser reserves the box before the
// bytes land. Missing intrinsic dimensions are the single most common cause of
// layout shift, and CLS is a Pillar 4 number, not a nicety.

interface Props {
  base: string;
  alt: string;
  /** Sizes hint. Default assumes the image spans the viewport on mobile. */
  sizes?: string;
  /** Intrinsic width of the source file. All current illustrations are 1536w. */
  width?: number;
  height?: number;
  class?: string;
  /** Set true only for the LCP image. Everything else stays lazy. */
  eager?: boolean;
  /**
   * Suppress the disclosure link when this component is already inside a
   * linked card. The adjacent label and AI-origin metadata are always kept.
   */
  detailsLink?: boolean;
  /** Position the disclosure over a fixed-aspect card image. */
  disclosure?: 'below' | 'overlay';
}

const {
  base,
  alt,
  sizes = '100vw',
  width = 1536,
  height = 1024,
  class: className = '',
  eager = false,
  detailsLink = true,
  disclosure = 'below',
} = Astro.props;

const src = `/illustrations/${base}.webp`;
const srcset = [
  `/illustrations/${base}-480.webp 480w`,
  `/illustrations/${base}-960.webp 960w`,
  `${src} ${width}w`,
].join(', ');
const disclosureId = `ai-illustration-${base.replace(/[^a-z0-9-]/gi, '-')}`;
---
<img
  src={src}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  aria-describedby={disclosureId}
  data-ai-origin="ai_generated"
  data-ai-disclosure-id="pcd-illustration-2026-08-03"
/>
<span
  id={disclosureId}
  class:list={[
    'ai-illustration-disclosure',
    { 'ai-illustration-disclosure--overlay': disclosure === 'overlay' },
  ]}
>
  AI-generated illustration. {detailsLink && <a href="/ai-transparency/">Details</a>}
</span>
<style>
  .ai-illustration-disclosure { display:block; padding:.35rem .1rem; color:var(--ink-soft); font-size:.78rem; line-height:1.35; }
  .ai-illustration-disclosure a { color:var(--rust); text-decoration:underline; }
  .ai-illustration-disclosure--overlay {
    position:absolute;
    left:.5rem;
    bottom:.5rem;
    z-index:1;
    width:max-content;
    max-width:calc(100% - 1rem);
    padding:.25rem .45rem;
    border:1px solid var(--line);
    border-radius:.25rem;
    background:var(--surface);
    box-shadow:0 1px 3px rgb(4 30 66 / .15);
  }
</style>
