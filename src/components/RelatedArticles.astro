---
import ArticleCard from './ArticleCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  articles: CollectionEntry<'articles'>[];
  pillarLabel?: string;
}

const { articles, pillarLabel } = Astro.props;
---
{articles.length > 0 && (
  <section class="rule-navy mt-20 pt-12">
    <div class="container-px">
      <div class="t-section mb-2">{pillarLabel ? `More from ${pillarLabel}` : 'Keep reading'}</div>
      <h2 class="t-display t-h2 mb-8">
        More from this <em>drive</em>
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {articles.slice(0, 3).map((a) => (
          <ArticleCard
            href={`/${a.data.phase}/${a.id}/`}
            format={a.data.format}
            sport={a.data.sport}
            age={a.data.age}
            phase={a.data.phase}
            topic={a.data.topic}
            title={a.data.title}
            dek={a.data.dek}
            variant="grid"
          />
        ))}
      </div>
    </div>
  </section>
)}
