---
// Newsletter signup CTA.
//
// We link out to Kit's hosted form rather than embed our own. The provider
// owns the subscription workflow. Read-only review on 2026-07-16 confirmed
// visible name/email fields and an unsubscribe notice; confirmation, redirect,
// suppression, delivery, and failure behavior remain launch-gated until a
// controlled provider proof is approved.
//
// To swap the destination form, change KIT_HOSTED_URL.

interface Props {
  variant?: 'inline' | 'card' | 'compact';
  headline?: string;
  blurb?: string;
  buttonLabel?: string;
  /** kept for back-compat with callers; not currently used */
  formId?: string;
  /** kept for back-compat with callers; not currently used */
  collectFirstName?: boolean;
}

const {
  variant = 'inline',
  headline = 'The Friday Letter',
  blurb = 'One short read every Friday from the Parent Coach Desk.',
  buttonLabel = 'Get the Friday Letter',
} = Astro.props;

const KIT_HOSTED_URL = 'https://parent-coach-playbook.kit.com/4b28f916b5';
const isCard = variant === 'card';
const isCompact = variant === 'compact';
---
{isCompact ? (
  <aside class="card card-rule p-5">
    <p class="t-section mb-1">
      The Friday Letter
    </p>
    <h3 class="t-h3 font-display text-ink leading-tight font-medium">
      {headline}
    </h3>
    <p class="font-display text-ink-soft text-sm mt-2 leading-snug">
      {blurb}
    </p>
    <a
      href={KIT_HOSTED_URL}
      class="btn-soft mt-4 inline-block"
    >
      {buttonLabel}
    </a>
    <p class="font-display italic text-ink-soft text-xs mt-3">
      Kit shows an unsubscribe option. By subscribing you agree to receive emails from
      Parent Coach Desk and to our <a href="/disclosure/" class="text-rust hover:underline">privacy notice</a>.
    </p>
  </aside>
) : (
  <section class={`${isCard ? 'card card-rule overflow-hidden' : 'rule-hair border-b border-line py-14'}`}>
    {isCard && (
      <figure class="border-b border-line">
        <img
          src="/illustrations/newsletter-banner.webp"
          alt="A rural mailbox at sunset with a folded copy of The Parent Coach Desk newspaper inside. A driveway leads to a small lit house in the distance."
          class="w-full h-48 md:h-64 object-cover"
          loading="lazy"
          decoding="async"
        />
      </figure>
    )}
    <div class={`${isCard ? 'p-6 md:p-8' : 'container-px'} grid md:grid-cols-12 gap-8 items-end`}>
      <div class="md:col-span-6">
        <p class="t-section mb-3">
          The Friday Letter
        </p>
        <h3 class="t-display t-h2">
          {headline}
        </h3>
        <p class="font-display text-ink-soft mt-3 leading-snug">
          {blurb}
        </p>
      </div>

      <div class="md:col-span-6">
        <a
          href={KIT_HOSTED_URL}
          data-newsletter-cta="site_banner"
          class="btn-soft inline-block"
        >
          {buttonLabel}
        </a>
        <p class="font-display italic text-ink-soft text-xs mt-3">
          Kit shows an unsubscribe option. By subscribing you
          agree to our <a href="/disclosure/" class="underline text-rust hover:opacity-80">privacy notice</a>.
        </p>
      </div>
    </div>
  </section>
)}
