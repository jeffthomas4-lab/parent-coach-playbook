---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import LeadMagnetCTA from '../components/LeadMagnetCTA.astro';
import Illo from '../components/Illo.astro';
import TopicIcon from '../components/TopicIcon.astro';
import { serializeJsonLd } from '../lib/jsonld';
import { PILLARS, EDITORIAL, TOPICS, SPORTS, SITE, SCHEMA_IDS } from '../data/site';
import { isLive, freshnessDate, wasUpdated } from '../lib/publishFilter';
import { renderTitle } from '../lib/title';

// "This Season" news items — 3 most recent non-draft entries.
const newsItems = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const NEWS_CATEGORY_LABELS: Record<string, string> = {
  'rule-change':  'Rule change',
  'equipment':    'Equipment',
  'registration': 'Registration',
  'season-dates': 'Season dates',
  'safety':       'Safety',
  'general':      'General',
};

// Each news category borrows an existing TopicIcon so the This Season cards
// read as three distinct things at a glance instead of three text blocks.
// Inline SVG, so this costs no network request.
const NEWS_CATEGORY_ICONS: Record<string, string> = {
  'rule-change':  'rules-of-play',
  'equipment':    'equipment',
  'registration': 'logistics',
  'season-dates': 'season-ops',
  'safety':       'body',
  'general':      'tools',
};

const all = (await getCollection('articles', ({ data }) => isLive(data)))
  .sort((a, b) => freshnessDate(b.data).getTime() - freshnessDate(a.data).getTime());

// Featured cornerstone — first essay marked featured, fallback to most recent.
const featured = all.find(a => a.data.featured && a.data.format === 'essay') ?? all[0];

// Latest 3 for the hero right-rail — excludes featured.
//
// Was 5. The rail is what sets the hero's height, and at 5 items it ran 744px
// against a 370px left column, so half the hero was empty on desktop. Three
// items bring the two columns within ~100px of each other and pull the This
// Season band up above the fold without moving any markup. The archive link
// under the rail is what carries the reader to the rest.
const latestRail = all.filter(a => a.id !== featured?.id).slice(0, 3);

// "Fresh at the Desk" — the newest pieces the hero rail is NOT already showing.
//
// This has to be computed after latestRail, and it has to subtract it. Both
// used to read off the top of the same sorted array, which is what put the
// same three headlines in both places. Shrinking the rail from 5 to 3 made
// that worse, not better: the overlap went from 3-of-5 to 3-of-3, an exact
// repeat. Excluding the rail's ids gives each section a real job — the rail is
// the newest three, this band is what came just before them.
//
// PINNED_SLUGS is an optional manual override: fill it with three slugs to
// hand-pick the band, or leave it empty to take the next three automatically.
const PINNED_SLUGS: string[] = [];
const pinned = PINNED_SLUGS
  .map(s => all.find(a => a.id === s))
  .filter(Boolean) as typeof all;
const railIds = new Set(latestRail.map(a => a.id));
const pinnedFinal = pinned.length === 3
  ? pinned
  : all.filter(a => !railIds.has(a.id) && a.id !== featured?.id).slice(0, 3);

// The "three drives" homepage section is specifically about the original
// drive-there/game/drive-home phases — team-parent is a separate content
// vertical with its own section elsewhere on this page, not a fourth drive.
const drives = [PILLARS['drive-there'], PILLARS.game, PILLARS['drive-home']];

const driveImages = [
  {
    base: 'walk-to-the-field',
    alt: 'A dad and son walking together through the parking lot toward the field at twilight.',
  },
  {
    base: 'coach-setting-cones',
    alt: 'A coach kneeling on the field at golden hour, setting up orange cones for a drill.',
  },
  {
    base: 'the-car-ride-home',
    alt: 'A dad driving with his young son in the passenger seat, soccer cleats in the foreground, sunset out the windshield.',
  },
];

// Each of the four tools gets an icon so the grid reads as four different
// things on a phone. The mobile card hides its description (see below), which
// left nothing but a title and an arrow — the icon is what carries it now.
// `title` is trusted authored markup, not user input — it carries the same
// <em> emphasis the rest of the page uses and is rendered with set:html.
const TOOL_CARDS = [
  {
    href: '/scripts/',
    icon: 'communication',
    eyebrow: 'Scripts',
    title: 'What to <em>actually</em> say.',
    blurb: 'The first 90 seconds after a bad game. The night before tryouts. The post-cut text.',
    cta: '→ Scripts',
  },
  {
    href: '/decisions/',
    icon: 'rec-vs-travel',
    eyebrow: 'Decisions',
    title: 'The big calls, walked through.',
    blurb: 'Travel ball or rec. Specialize or stay multi-sport. Quit or push through.',
    cta: '→ Decisions',
  },
  {
    href: '/youth-sports-pendulum/',
    icon: 'the-hard-stuff',
    eyebrow: 'Pendulum',
    title: 'Where is your family right now?',
    blurb: 'Fun-to-performance spectrum. The check-in that pulls families back from the edge.',
    cta: '→ Take the check-in',
  },
  {
    href: '/cost-calculator/',
    icon: 'money',
    eyebrow: 'Cost calculator',
    title: 'What does a year <em>actually</em> cost?',
    blurb: 'Pre-filled with national medians at every tier. Edit any line. Honest math either way.',
    cta: '→ Run your numbers',
  },
];

// Sport hub grid — top 8 by broad popularity for homepage teaser.
// Order matches what most families will recognize first.
const FEATURED_SPORTS = [
  'baseball', 'soccer', 'basketball', 'football',
  'softball', 'volleyball', 'swimming', 'lacrosse-girls',
];
const featuredSports = FEATURED_SPORTS
  .map(slug => SPORTS.find(s => s.slug === slug))
  .filter(Boolean) as typeof SPORTS[number][];

// One illustration per featured sport. On a phone this band was eight stacked
// text tiles and nothing else — the longest unbroken run of type on the page.
// The alt text is deliberately plain: the photo is the sport's visual label,
// not information the link text doesn't already carry.
const SPORT_THUMBS: Record<string, { base: string; alt: string }> = {
  'baseball':       { base: 'baseball-glove-ball-bench',      alt: 'A baseball glove and ball resting on a dugout bench.' },
  'soccer':         { base: 'soccer-ball-wet-grass',          alt: 'A soccer ball on wet morning grass.' },
  'basketball':     { base: 'basketball-hoop-outdoor-dusk',   alt: 'An outdoor basketball hoop at dusk.' },
  'football':       { base: 'football-helmets-on-grass',      alt: 'Football helmets lined up on the grass.' },
  'softball':       { base: 'softball-dugout-bench-gear',     alt: 'Softball gear packed along a dugout bench.' },
  'volleyball':     { base: 'volleyball-net-empty-gym',       alt: 'A volleyball net strung across an empty gym.' },
  'swimming':       { base: 'swimming-goggles-cap-deck',      alt: 'Swim goggles and a cap on the pool deck.' },
  'lacrosse-girls': { base: 'lacrosse-girls-sticks-fence',    alt: "Girls' lacrosse sticks leaning against a fence." },
};

// timeZone: 'UTC' required — publishedAt parses to midnight UTC.
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

// WebSite schema with SearchAction.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': SCHEMA_IDS.website,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  publisher: {
    '@type': 'Organization',
    '@id': SCHEMA_IDS.organization,
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE.url}/search/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---
<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={serializeJsonLd(websiteSchema)} />

  {/* ── HERO ─────────────────────────────────────────────────────────────── */}
  <section class="relative overflow-hidden">
    <Illo
      base="sports-family-sideline"
      alt="A family of four sitting close together on the sideline at a youth game, smiling."
      sizes="100vw"
      class="absolute inset-0 w-full h-full object-cover"
      eager
    />
    {/*
      70%, not 90%. At 90% the sideline photo was a barely-visible texture
      behind a near-solid white panel, which is a lot of bytes for something
      nobody can see. Measured against the actual image before loosening it:
      navy #041E42 on the composited background is 7.85:1 at its worst pixel
      under the text, which clears the 4.5:1 AA floor and the 7:1 AAA bar.
      Re-run that math if the hero image is ever swapped — a darker photo
      would not survive this opacity.
    */}
    <div class="absolute inset-0 bg-surface/70" aria-hidden="true"></div>
    <div class="container-px py-16 md:py-24 relative">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">

        {/* Hero copy */}
        <div class="lg:col-span-8">
          <p class="t-eyebrow mb-4">Hi. So glad you found us.</p>
          <h1 class="t-display t-h1">
            You're the coach <em>whether you asked for the job or not.</em>
          </h1>
          <p class="text-ink-soft text-lg md:text-xl mt-6 max-w-measure leading-relaxed">
            Every kid in every activity has a parent driving them home. That's the real game. Camps to find, gear that lasts, and what to say in the car.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/start-here/" class="btn">Start here</a>
            <a href="/sports/" class="btn btn-ghost">Browse by sport</a>
          </div>
          <p class="text-ink-soft text-base mt-5">
            {/* EDITORIAL.byline is already "the Parent Coach Desk", so a
                leading "the" here rendered "Written by the the Parent Coach
                Desk." Footer.astro and ArticleLayout.astro were always correct;
                this was the only call site with the extra article. */}
            Written by <a href="/about/" class="text-accent underline-offset-2 hover:underline hover:text-accent-hover">{EDITORIAL.byline}</a>.
          </p>
        </div>

        {/* Latest reads rail */}
        <aside class="lg:col-span-4 card card-rule p-6">
          <p class="t-section mb-2">Latest</p>
          <h2 class="t-h2 t-display leading-tight mb-4">
            Right off the <em>desk</em>
          </h2>
          <ul class="border-t border-line">
            {latestRail.map((a) => (
              <li>
                <a href={`/${a.data.phase}/${a.id}/`} class="block py-3 border-b border-line hover:bg-stripe transition-colors group -mx-2 px-2 rounded-btn min-h-11">
                  <p class="t-eyebrow">
                    {a.data.topic ? TOPICS.find(t => t.slug === a.data.topic)?.label : 'General'} · {wasUpdated(a.data) ? 'Updated ' : ''}{fmtDate(freshnessDate(a.data))}
                  </p>
                  <h3 class="t-card-title font-display text-ink leading-snug mt-1 group-hover:text-accent transition-colors font-medium" set:html={renderTitle(a.data.title)} />
                </a>
              </li>
            ))}
          </ul>
          <p class="t-cta mt-4">
            <a href="/reads/" class="inline-flex items-center min-h-11 hover:underline">→ Browse the full archive</a>
          </p>
        </aside>
      </div>
    </div>
  </section>

  {/* ── THIS SEASON (news) ───────────────────────────────────────────────── */}
  {newsItems.length > 0 && (
    <section class="band band-sunken">
      <div class="container-px">
        <div class="flex items-baseline justify-between mb-6 flex-wrap gap-3">
          <div>
            <p class="t-section mb-1">This Season</p>
            <h2 class="t-display t-h2">
              What's changing <em>right now</em>.
            </h2>
          </div>
          <a href="/news/" class="t-cta whitespace-nowrap inline-flex items-center min-h-11">
            All updates →
          </a>
        </div>
        <ul class="grid md:grid-cols-3 gap-4">
          {newsItems.map((item) => (
            <li>
              <a
                href={`/news/${item.id}/`}
                class="card card-hover group flex gap-4 items-start p-5 h-full rounded-card"
              >
                <TopicIcon
                  topic={NEWS_CATEGORY_ICONS[item.data.category] ?? 'tools'}
                  size={40}
                  class="shrink-0 mt-0.5"
                />
                <div>
                  <p class="t-eyebrow mb-2">
                    {NEWS_CATEGORY_LABELS[item.data.category] ?? item.data.category}
                    {item.data.sport && <span> · {item.data.sport}</span>}
                  </p>
                  <h3 class="t-card-title font-display text-ink leading-snug group-hover:text-accent transition-colors font-medium">
                    {item.data.headline}
                  </h3>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ── PINNED AT THE DESK ───────────────────────────────────────────────── */}
  {/*
    Still hidden below md, but the reason has changed and it is now a length
    call rather than a duplication one.

    Originally this band and the hero rail both read off the top of the same
    sorted list, so a phone (where the rail collapses to sit right above this
    band) showed the same three headlines twice about 950px apart. That is
    fixed at the source now: pinnedFinal subtracts the rail's ids, so the two
    sections carry different pieces on every breakpoint.

    It stays hidden on mobile because the phone page already runs ~9,600px and
    this band adds another ~950px of the same card pattern. That is a judgment
    about scroll length, not a bug, so unhiding it is a one-word change
    (`hidden md:block` → nothing) whenever the call goes the other way.
  */}
  <section class="band band-surface hidden md:block">
    <div class="container-px">
      <p class="t-section mb-2">Fresh at the Desk</p>
      <h2 class="t-display t-h2 max-w-2xl">
        What's <em>new</em> this week.
      </h2>
      <div class="mt-7 grid md:grid-cols-3 gap-4">
        {pinnedFinal.map((p) => (
          <a
            href={`/${p.data.phase}/${p.id}/`}
            class="card card-rule card-hover group block p-6 rounded-card"
          >
            <p class="t-eyebrow mb-2">New</p>
            <h3
              class="t-card-title font-display text-ink leading-tight group-hover:text-accent transition-colors font-medium"
              set:html={renderTitle(p.data.title)}
            />
            {p.data.dek && (
              <p class="text-ink-soft text-base mt-2 leading-snug">{p.data.dek}</p>
            )}
            <p class="t-eyebrow mt-3">
              {wasUpdated(p.data) ? 'Updated ' : ''}{fmtDate(freshnessDate(p.data))}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── BY SPORT ─────────────────────────────────────────────────────────── */}
  <section class="band band-sunken">
    <div class="container-px">
      <div class="flex items-end justify-between mb-8 flex-wrap gap-3">
        <div>
          <p class="t-section mb-2">26 sports and activities</p>
          <h2 class="t-display t-h2">
            Find your <em>sport</em>.
          </h2>
          <p class="t-dek mt-3 max-w-xl">
            Pick yours and the whole site filters to what's relevant.
          </p>
        </div>
        <a href="/sports/" class="t-cta whitespace-nowrap inline-flex items-center min-h-11">All 26 sports →</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {featuredSports.map((sport) => {
          const thumb = SPORT_THUMBS[sport.slug];
          return (
            <a
              href={`/sports/${sport.slug}/`}
              class="card card-hover group block overflow-hidden rounded-card min-h-11"
            >
              {thumb && (
                <div class="aspect-[3/2] overflow-hidden bg-stripe">
                  <Illo
                    base={thumb.base}
                    alt={thumb.alt}
                    sizes="(min-width: 640px) 25vw, 50vw"
                    class="w-full h-full object-cover rounded-t-card group-hover:scale-[1.02] transition-transform duration-500"
                  />
                </div>
              )}
              <div class="px-5 py-4">
                <h3 class="t-card-title font-display text-ink leading-tight group-hover:text-accent transition-colors font-medium">
                  {sport.label}
                </h3>
                <p class="t-cta mt-1 text-sm">→ Guide</p>
              </div>
            </a>
          );
        })}
      </div>
      <p class="text-ink-soft text-base mt-5">
        Don't see yours? <a href="/sports/" class="text-accent hover:underline hover:text-accent-hover">All sports including dance, theater, band, gymnastics, and more →</a>
      </p>
    </div>
  </section>

  {/* ── THREE DRIVES ─────────────────────────────────────────────────────── */}
  <section class="band band-surface">
    <div class="container-px">
      <div>
        <p class="t-section mb-2">What makes this site different</p>
        <h2 class="t-display t-h2">
          Every game is <em>three drives</em>.
        </h2>
        <p class="t-dek mt-3 max-w-2xl">
          The car ride there. The game itself. The car ride home. Most of the work happens before the game starts or after the final whistle.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 mt-8">
        {drives.map((p, i) => (
          <a
            href={`/${p.slug}/`}
            class="card card-rule card-hover group block overflow-hidden rounded-card"
          >
            <div class="aspect-[3/2] overflow-hidden bg-stripe">
              <Illo
                base={driveImages[i].base}
                alt={driveImages[i].alt}
                sizes="(min-width: 768px) 33vw, 100vw"
                class="w-full h-full object-cover rounded-t-card group-hover:scale-[1.02] transition-transform duration-500"
              />
            </div>
            <div class="p-6 md:p-8">
              <div class="flex items-baseline gap-3 mb-3">
                <span class="font-body text-sm font-medium" style={`color: ${p.accent};`}>
                  Drive {String(i + 1).padStart(2, '0')}
                </span>
                <span class="t-eyebrow">
                  {p.eyebrow}
                </span>
              </div>
              <h3 class="t-h3 font-display text-ink leading-tight group-hover:text-accent transition-colors font-medium">
                {p.label}
              </h3>
              <p class="text-ink-soft text-base mt-3 leading-snug">
                {p.blurb}
              </p>
              <p class="font-body text-sm mt-5 font-medium" style={`color: ${p.accent};`}>
                → Read the {p.label.toLowerCase()} pieces
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── PARENT-COACH ─────────────────────────────────────────────────────── */}
  <section class="band band-sunken relative overflow-hidden">
    <Illo
      base="empty-gym-after-practice"
      alt="An empty high school gym in late afternoon light: basketball on the floor near the bench, Teamwork Respect Integrity banner on the wall."
      sizes="100vw"
      class="absolute inset-0 w-full h-full object-cover opacity-20"
    />
    <div class="absolute inset-0 bg-surface-sunken/90" aria-hidden="true"></div>
    <div class="container-px relative">
      <div class="grid lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7">
          <p class="t-eyebrow mb-3">If you're also on the bench</p>
          <h2 class="t-display t-h2">
            Coaching your kid's team is its <em>own job</em>.
          </h2>
          <p class="t-dek mt-4 max-w-xl">
            Most clinics don't cover the part where it's also your kid. The lineup at midnight. The walk to the dugout. The drive home, knowing they're not getting the truth from anyone else either. This is where those pieces live.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/parent-coach/" class="btn">
              The parent-coach pieces
            </a>
            <a href="/coaching-tips/" class="btn btn-ghost">
              Drills you can run
            </a>
          </div>
        </div>
        <ul class="lg:col-span-5 card card-rule grid gap-1 p-6">
          <li>
            <a href="/game/coaching-your-own-kid-in-front-of-the-team/" class="block py-4 border-b border-line group transition-colors">
              <span class="t-eyebrow">Essay</span>
              <h3 class="t-card-title font-display text-ink leading-tight mt-1 font-medium group-hover:text-accent transition-colors">
                Coaching your own kid <em class="text-accent italic">in front of the team</em>
              </h3>
              <p class="text-ink-soft text-sm mt-1 leading-snug">
                I made the lineup at midnight. Five seasons later, I think I have it figured out. Sort of.
              </p>
            </a>
          </li>
          <li>
            <a href="/drive-home/three-drives-one-relationship/" class="block py-4 border-b border-line group transition-colors">
              <span class="t-eyebrow">Framework</span>
              <h3 class="t-card-title font-display text-ink leading-tight mt-1 font-medium group-hover:text-accent transition-colors">
                Three drives. <em class="text-accent italic">One relationship.</em>
              </h3>
              <p class="text-ink-soft text-sm mt-1 leading-snug">
                Why what happens in the car matters more than what happens on the field.
              </p>
            </a>
          </li>
          <li>
            <a href="/drive-home/the-you-should-be-assistant-coaching-pressure/" class="block py-4 group transition-colors">
              <span class="t-eyebrow">Decision</span>
              <h3 class="t-card-title font-display text-ink leading-tight mt-1 font-medium group-hover:text-accent transition-colors">
                The <em class="text-accent italic">"you should be assistant coaching"</em> pressure
              </h3>
              <p class="text-ink-soft text-sm mt-1 leading-snug">
                Coach asked. Two parents asked. You're considering it. Read this first.
              </p>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {/* ── TOOLS GRID ───────────────────────────────────────────────────────── */}
  <section class="band band-surface">
    <div class="container-px">
      <p class="t-section mb-2">For the moment you're in</p>
      <h2 class="t-display t-h2 max-w-3xl">
        Tools, not <em>advice columns</em>.
      </h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
        {TOOL_CARDS.map((tool) => (
          <a href={tool.href} class="card card-rule card-hover group block p-5 md:p-6 rounded-card">
            <TopicIcon topic={tool.icon} size={44} class="mb-3" />
            <p class="t-eyebrow">{tool.eyebrow}</p>
            <h3
              class="t-card-title font-display text-ink leading-tight mt-2 group-hover:text-accent transition-colors font-medium"
              set:html={tool.title}
            />
            <p class="text-ink-soft text-sm mt-3 leading-snug hidden md:block">
              {tool.blurb}
            </p>
            <p class="t-cta mt-4 text-sm">{tool.cta}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── FEATURED LONG READ ───────────────────────────────────────────────── */}
  {featured && (
    <section class="band band-sunken">
      <div class="container-px">
        <p class="t-section mb-3">If you only read one thing</p>
        <a href={`/${featured.data.phase}/${featured.id}/`} class="block group">
          <div class="grid md:grid-cols-12 gap-6 md:gap-10 items-center">
            <div class="md:col-span-5 md:order-2">
              <div class="aspect-[3/2] overflow-hidden rounded-card bg-stripe">
                <Illo
                  base="bleachers-two-parents-side"
                  alt="Two parents sitting side by side in the bleachers, watching a game."
                  sizes="(min-width: 768px) 40vw, 100vw"
                  class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                />
              </div>
            </div>
            <div class="md:col-span-7 md:order-1">
              <h2
                class="t-display t-h1 group-hover:text-accent transition-colors"
                set:html={renderTitle(featured.data.title)}
              />
              {featured.data.dek && (
                <p class="text-ink-soft text-xl mt-5 leading-snug max-w-2xl">
                  {featured.data.dek}
                </p>
              )}
              <div class="t-cta mt-6">Read it →</div>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  {/* ── NEWSLETTER (single ask — lead magnet includes the Friday Letter signup) ── */}
  <LeadMagnetCTA />
</BaseLayout>
