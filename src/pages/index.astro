---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import LeadMagnetCTA from '../components/LeadMagnetCTA.astro';
import { serializeJsonLd } from '../lib/jsonld';
import { PILLARS, EDITORIAL, TOPICS, SPORTS, SITE, SCHEMA_IDS } from '../data/site';
import { isLive, freshnessDate, wasUpdated } from '../lib/publishFilter';
import { renderTitle } from '../lib/title';

// "This Season" news items — 3 most recent non-draft entries.
const newsItems = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const NEWS_CATEGORY_LABELS: Record<string, string> = {
  'rule-change':  'Rule change',
  'equipment':    'Equipment',
  'registration': 'Registration',
  'season-dates': 'Season dates',
  'safety':       'Safety',
  'general':      'General',
};

const all = (await getCollection('articles', ({ data }) => isLive(data)))
  .sort((a, b) => freshnessDate(b.data).getTime() - freshnessDate(a.data).getTime());

// "Fresh at the Desk" — the newest published pieces, surfaced automatically.
// PINNED_SLUGS is an optional manual override: fill it with three slugs to
// hand-pick the band, or leave it empty to always show the freshest content.
const PINNED_SLUGS: string[] = [];
const pinned = PINNED_SLUGS
  .map(s => all.find(a => a.id === s))
  .filter(Boolean) as typeof all;
const pinnedFinal = pinned.length === 3 ? pinned : all.slice(0, 3);

// Featured cornerstone — first essay marked featured, fallback to most recent.
const featured = all.find(a => a.data.featured && a.data.format === 'essay') ?? all[0];

// Latest 5 for the hero right-rail — excludes featured.
const latestRail = all.filter(a => a.id !== featured?.id).slice(0, 5);

// The "three drives" homepage section is specifically about the original
// drive-there/game/drive-home phases — team-parent is a separate content
// vertical with its own section elsewhere on this page, not a fourth drive.
const drives = [PILLARS['drive-there'], PILLARS.game, PILLARS['drive-home']];

const driveImages = [
  {
    src: '/illustrations/walk-to-the-field.webp',
    alt: 'A dad and son walking together through the parking lot toward the field at twilight.',
  },
  {
    src: '/illustrations/coach-setting-cones.webp',
    alt: 'A coach kneeling on the field at golden hour, setting up orange cones for a drill.',
  },
  {
    src: '/illustrations/the-car-ride-home.webp',
    alt: 'A dad driving with his young son in the passenger seat, soccer cleats in the foreground, sunset out the windshield.',
  },
];

// Sport hub grid — top 8 by broad popularity for homepage teaser.
// Order matches what most families will recognize first.
const FEATURED_SPORTS = [
  'baseball', 'soccer', 'basketball', 'football',
  'softball', 'volleyball', 'swimming', 'lacrosse-girls',
];
const featuredSports = FEATURED_SPORTS
  .map(slug => SPORTS.find(s => s.slug === slug))
  .filter(Boolean) as typeof SPORTS[number][];

// timeZone: 'UTC' required — publishedAt parses to midnight UTC.
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

// WebSite schema with SearchAction.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': SCHEMA_IDS.website,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  publisher: {
    '@type': 'Organization',
    '@id': SCHEMA_IDS.organization,
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE.url}/search/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---
<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={serializeJsonLd(websiteSchema)} />

  {/* ── HERO ─────────────────────────────────────────────────────────────── */}
  <section class="relative overflow-hidden">
    <img
      src="/illustrations/sports-family-sideline.webp"
      alt="A family of four sitting close together on the sideline at a youth game, smiling."
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0 bg-surface/90" aria-hidden="true"></div>
    <div class="container-px py-16 md:py-24 relative">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">

        {/* Hero copy */}
        <div class="lg:col-span-8">
          <p class="t-eyebrow mb-4">Hi. So glad you found us.</p>
          <h1 class="t-display t-h1">
            You're the coach <em>whether you asked for the job or not.</em>
          </h1>
          <p class="text-ink-soft text-lg md:text-xl mt-6 max-w-measure leading-relaxed">
            Every kid in every activity has a parent driving them home. That's the real game. Camps to find, gear that lasts, and what to say in the car.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/start-here/" class="btn">Start here</a>
            <a href="/sports/" class="btn btn-ghost">Browse by sport</a>
          </div>
          <p class="text-ink-soft text-base mt-5">
            Written by the <a href="/about/" class="text-accent underline-offset-2 hover:underline hover:text-accent-hover">{EDITORIAL.byline}</a>.
          </p>
        </div>

        {/* Latest reads rail */}
        <aside class="lg:col-span-4 card card-rule p-6">
          <p class="t-section mb-2">Latest</p>
          <h2 class="t-display text-xl leading-tight mb-4">
            Right off the <em>desk</em>
          </h2>
          <ul class="border-t border-line">
            {latestRail.map((a) => (
              <li>
                <a href={`/${a.data.phase}/${a.id}/`} class="block py-3 border-b border-line hover:bg-stripe transition-colors group -mx-2 px-2 rounded-btn min-h-11">
                  <p class="t-eyebrow">
                    {a.data.topic ? TOPICS.find(t => t.slug === a.data.topic)?.label : 'General'} · {wasUpdated(a.data) ? 'Updated ' : ''}{fmtDate(freshnessDate(a.data))}
                  </p>
                  <h3 class="font-display text-ink text-sm leading-snug mt-1 group-hover:text-accent transition-colors font-medium" set:html={renderTitle(a.data.title)} />
                </a>
              </li>
            ))}
          </ul>
          <p class="t-cta mt-4">
            <a href="/reads/" class="hover:underline">→ Browse the full archive</a>
          </p>
        </aside>
      </div>
    </div>
  </section>

  {/* ── THIS SEASON (news) ───────────────────────────────────────────────── */}
  {newsItems.length > 0 && (
    <section class="band band-sunken">
      <div class="container-px">
        <div class="flex items-baseline justify-between mb-6 flex-wrap gap-3">
          <div>
            <p class="t-section mb-1">This Season</p>
            <h2 class="t-display t-h2">
              What's changing <em>right now</em>.
            </h2>
          </div>
          <a href="/news/" class="t-cta whitespace-nowrap">
            All updates →
          </a>
        </div>
        <ul class="grid md:grid-cols-3 gap-4">
          {newsItems.map((item) => (
            <li>
              <a
                href={`/news/${item.id}/`}
                class="card card-hover group block p-5 h-full rounded-card"
              >
                <p class="t-eyebrow mb-2">
                  {NEWS_CATEGORY_LABELS[item.data.category] ?? item.data.category}
                  {item.data.sport && <span> · {item.data.sport}</span>}
                </p>
                <h3 class="font-display text-ink text-base leading-snug group-hover:text-accent transition-colors font-medium">
                  {item.data.headline}
                </h3>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ── PINNED AT THE DESK ───────────────────────────────────────────────── */}
  <section class="band band-surface">
    <div class="container-px">
      <p class="t-section mb-2">Fresh at the Desk</p>
      <h2 class="t-display t-h2 max-w-2xl">
        What's <em>new</em> this week.
      </h2>
      <div class="mt-7 grid md:grid-cols-3 gap-4">
        {pinnedFinal.map((p) => (
          <a
            href={`/${p.data.phase}/${p.id}/`}
            class="card card-rule card-hover group block p-6 rounded-card"
          >
            <p class="t-eyebrow mb-2">New</p>
            <h3
              class="font-display text-ink text-xl leading-tight group-hover:text-accent transition-colors font-medium"
              set:html={renderTitle(p.data.title)}
            />
            {p.data.dek && (
              <p class="text-ink-soft text-base mt-2 leading-snug">{p.data.dek}</p>
            )}
            <p class="t-eyebrow mt-3">
              {wasUpdated(p.data) ? 'Updated ' : ''}{fmtDate(freshnessDate(p.data))}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── BY SPORT ─────────────────────────────────────────────────────────── */}
  <section class="band band-sunken">
    <div class="container-px">
      <div class="flex items-end justify-between mb-8 flex-wrap gap-3">
        <div>
          <p class="t-section mb-2">26 sports and activities</p>
          <h2 class="t-display t-h2">
            Find your <em>sport</em>.
          </h2>
          <p class="t-dek mt-3 max-w-xl">
            Pick yours and the whole site filters to what's relevant.
          </p>
        </div>
        <a href="/sports/" class="t-cta whitespace-nowrap">All 26 sports →</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {featuredSports.map((sport) => (
          <a
            href={`/sports/${sport.slug}/`}
            class="card card-hover group px-5 py-4 block rounded-card min-h-11"
          >
            <h3 class="font-display text-ink text-base leading-tight group-hover:text-accent transition-colors font-medium">
              {sport.label}
            </h3>
            <p class="t-cta mt-1 text-sm">→ Guide</p>
          </a>
        ))}
      </div>
      <p class="text-ink-soft text-base mt-5">
        Don't see yours? <a href="/sports/" class="text-accent hover:underline hover:text-accent-hover">All sports including dance, theater, band, gymnastics, and more →</a>
      </p>
    </div>
  </section>

  {/* ── THREE DRIVES ─────────────────────────────────────────────────────── */}
  <section class="band band-surface">
    <div class="container-px">
      <div>
        <p class="t-section mb-2">What makes this site different</p>
        <h2 class="t-display t-h2">
          Every game is <em>three drives</em>.
        </h2>
        <p class="t-dek mt-3 max-w-2xl">
          The car ride there. The game itself. The car ride home. Most of the work happens before the game starts or after the final whistle.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 mt-8">
        {drives.map((p, i) => (
          <a
            href={`/${p.slug}/`}
            class="card card-rule card-hover group block overflow-hidden rounded-card"
          >
            <div class="aspect-[3/2] overflow-hidden bg-stripe">
              <img
                src={driveImages[i].src}
                alt={driveImages[i].alt}
                class="w-full h-full object-cover rounded-t-card group-hover:scale-[1.02] transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-6 md:p-8">
              <div class="flex items-baseline gap-3 mb-3">
                <span class="font-body text-sm font-medium" style={`color: ${p.accent};`}>
                  Drive {String(i + 1).padStart(2, '0')}
                </span>
                <span class="t-eyebrow">
                  {p.eyebrow}
                </span>
              </div>
              <h3 class="font-display text-ink text-2xl md:text-3xl leading-tight group-hover:text-accent transition-colors font-medium">
                {p.label}
              </h3>
              <p class="text-ink-soft text-base mt-3 leading-snug">
                {p.blurb}
              </p>
              <p class="font-body text-sm mt-5 font-medium" style={`color: ${p.accent};`}>
                → Read the {p.label.toLowerCase()} pieces
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── PARENT-COACH ─────────────────────────────────────────────────────── */}
  <section class="band band-sunken relative overflow-hidden">
    <img
      src="/illustrations/empty-gym-after-practice.webp"
      alt="An empty high school gym in late afternoon light: basketball on the floor near the bench, Teamwork Respect Integrity banner on the wall."
      class="absolute inset-0 w-full h-full object-cover opacity-20"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-surface-sunken/90" aria-hidden="true"></div>
    <div class="container-px relative">
      <div class="grid lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7">
          <p class="t-eyebrow mb-3">If you're also on the bench</p>
          <h2 class="t-display t-h2">
            Coaching your kid's team is its <em>own job</em>.
          </h2>
          <p class="t-dek mt-4 max-w-xl">
            Most clinics don't cover the part where it's also your kid. The lineup at midnight. The walk to the dugout. The drive home, knowing they're not getting the truth from anyone else either. This is where those pieces live.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/parent-coach/" class="btn">
              The parent-coach pieces
            </a>
            <a href="/coaching-tips/" class="btn btn-ghost">
              Drills you can run
            </a>
          </div>
        </div>
        <ul class="lg:col-span-5 card card-rule grid gap-1 p-6">
          <li>
            <a href="/game/coaching-your-own-kid-in-front-of-the-team/" class="block py-4 border-b border-line group transition-colors">
              <span class="t-eyebrow">Essay</span>
              <h3 class="font-display text-ink text-xl leading-tight mt-1 font-medium group-hover:text-accent transition-colors">
                Coaching your own kid <em class="text-accent italic">in front of the team</em>
              </h3>
              <p class="text-ink-soft text-sm mt-1 leading-snug">
                I made the lineup at midnight. Five seasons later, I think I have it figured out. Sort of.
              </p>
            </a>
          </li>
          <li>
            <a href="/drive-home/three-drives-one-relationship/" class="block py-4 border-b border-line group transition-colors">
              <span class="t-eyebrow">Framework</span>
              <h3 class="font-display text-ink text-xl leading-tight mt-1 font-medium group-hover:text-accent transition-colors">
                Three drives. <em class="text-accent italic">One relationship.</em>
              </h3>
              <p class="text-ink-soft text-sm mt-1 leading-snug">
                Why what happens in the car matters more than what happens on the field.
              </p>
            </a>
          </li>
          <li>
            <a href="/drive-home/the-you-should-be-assistant-coaching-pressure/" class="block py-4 group transition-colors">
              <span class="t-eyebrow">Decision</span>
              <h3 class="font-display text-ink text-xl leading-tight mt-1 font-medium group-hover:text-accent transition-colors">
                The <em class="text-accent italic">"you should be assistant coaching"</em> pressure
              </h3>
              <p class="text-ink-soft text-sm mt-1 leading-snug">
                Coach asked. Two parents asked. You're considering it. Read this first.
              </p>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {/* ── TOOLS GRID ───────────────────────────────────────────────────────── */}
  <section class="band band-surface">
    <div class="container-px">
      <p class="t-section mb-2">For the moment you're in</p>
      <h2 class="t-display t-h2 max-w-3xl">
        Tools, not <em>advice columns</em>.
      </h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
        <a href="/scripts/" class="card card-rule card-hover group block p-5 md:p-6 rounded-card">
          <p class="t-eyebrow">Scripts</p>
          <h3 class="font-display text-ink text-lg md:text-xl leading-tight mt-2 group-hover:text-accent transition-colors font-medium">
            What to <em>actually</em> say.
          </h3>
          <p class="text-ink-soft text-sm mt-3 leading-snug hidden md:block">
            The first 90 seconds after a bad game. The night before tryouts. The post-cut text.
          </p>
          <p class="t-cta mt-4 text-sm">→ Scripts</p>
        </a>

        <a href="/decisions/" class="card card-rule card-hover group block p-5 md:p-6 rounded-card">
          <p class="t-eyebrow">Decisions</p>
          <h3 class="font-display text-ink text-lg md:text-xl leading-tight mt-2 group-hover:text-accent transition-colors font-medium">
            The big calls, walked through.
          </h3>
          <p class="text-ink-soft text-sm mt-3 leading-snug hidden md:block">
            Travel ball or rec. Specialize or stay multi-sport. Quit or push through.
          </p>
          <p class="t-cta mt-4 text-sm">→ Decisions</p>
        </a>

        <a href="/youth-sports-pendulum/" class="card card-rule card-hover group block p-5 md:p-6 rounded-card">
          <p class="t-eyebrow">Pendulum</p>
          <h3 class="font-display text-ink text-lg md:text-xl leading-tight mt-2 group-hover:text-accent transition-colors font-medium">
            Where is your family right now?
          </h3>
          <p class="text-ink-soft text-sm mt-3 leading-snug hidden md:block">
            Fun-to-performance spectrum. The check-in that pulls families back from the edge.
          </p>
          <p class="t-cta mt-4 text-sm">→ Take the check-in</p>
        </a>

        <a href="/cost-calculator/" class="card card-rule card-hover group block p-5 md:p-6 rounded-card">
          <p class="t-eyebrow">Cost calculator</p>
          <h3 class="font-display text-ink text-lg md:text-xl leading-tight mt-2 group-hover:text-accent transition-colors font-medium">
            What does a year <em>actually</em> cost?
          </h3>
          <p class="text-ink-soft text-sm mt-3 leading-snug hidden md:block">
            Pre-filled with national medians at every tier. Edit any line. Honest math either way.
          </p>
          <p class="t-cta mt-4 text-sm">→ Run your numbers</p>
        </a>
      </div>
    </div>
  </section>

  {/* ── FEATURED LONG READ ───────────────────────────────────────────────── */}
  {featured && (
    <section class="band band-sunken">
      <div class="container-px">
        <p class="t-section mb-3">If you only read one thing</p>
        <a href={`/${featured.data.phase}/${featured.id}/`} class="block group max-w-3xl">
          <h2
            class="t-display t-h1 group-hover:text-accent transition-colors"
            set:html={renderTitle(featured.data.title)}
          />
          {featured.data.dek && (
            <p class="text-ink-soft text-xl mt-5 leading-snug max-w-2xl">
              {featured.data.dek}
            </p>
          )}
          <div class="t-cta mt-6">Read it →</div>
        </a>
      </div>
    </section>
  )}

  {/* ── NEWSLETTER (single ask — lead magnet includes the Friday Letter signup) ── */}
  <LeadMagnetCTA />
</BaseLayout>
