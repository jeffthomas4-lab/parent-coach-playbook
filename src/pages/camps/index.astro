---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import Illo from '../../components/Illo.astro';
import { listApprovedCamps, listFeaturedCamps, type Camp } from '../../lib/camps-db';
import { CAMP_SPORTS } from '../../data/site';
import { env as cfEnv } from 'cloudflare:workers';
import { serializeJsonLd } from '../../lib/jsonld';
import { isRecentlyAdded, daysSinceAdded } from '../../lib/camp-freshness';
import { renderCardHtml, renderFeaturedCardHtml, RECENTLY_ADDED_WINDOW_DAYS } from '../../lib/camp-card';

// SSR. Pulls live from D1 each request, but the response is cached at
// Cloudflare's edge for 10 minutes (s-maxage=600), with stale-while-revalidate
// keeping the page snappy for up to 24 hours while a background refresh runs.
// Net effect: at typical traffic, ~1 D1 read per 10 minutes per Cloudflare PoP
// instead of 1 read per visit.
export const prerender = false;
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=600, stale-while-revalidate=86400',
);

const env = cfEnv as { DB: D1Database } | undefined;
let camps: Camp[] = [];
let dbAvailable = !!env?.DB;
if (env?.DB) {
  try {
    camps = await listApprovedCamps(env.DB);
  } catch (e) {
    console.error('listApprovedCamps failed', e);
  }
}

let featuredCamps: Camp[] = [];
if (env?.DB) {
  try {
    featuredCamps = await listFeaturedCamps(env.DB);
  } catch (e) {
    console.error('listFeaturedCamps failed', e);
  }
}

const PNW = new Set(['WA', 'OR', 'ID', 'MT', 'AK']);
const pnw = camps.filter(c => PNW.has(c.state));
const elsewhere = camps.filter(c => !PNW.has(c.state));

// "Recently added" — derived in-memory from the same `camps` array already
// fetched above. Does not issue a second D1 query and does not change what
// camps are eligible to appear anywhere else on this page; it only reorders
// a slice of the existing approved-camps result for display. Null-safe:
// camps with an unparseable date_added simply sort last / are excluded from
// the "added in the last 30 days" count below rather than throwing.
const RECENTLY_ADDED_CAP = 12;
const recentlyAddedCamps = [...camps]
  .filter((c) => daysSinceAdded(c.date_added) !== null)
  .sort((a, b) => (b.date_added || '').localeCompare(a.date_added || ''))
  .slice(0, RECENTLY_ADDED_CAP);
const recentlyAddedCount = camps.filter((c) => isRecentlyAdded(c.date_added, RECENTLY_ADDED_WINDOW_DAYS)).length;

// Card HTML rendering lives in src/lib/camp-card.ts now — shared with the
// client-side filter script below so a card built on the server and a card
// built in the browser are byte-identical. See that file's header comment
// for why (2026-07-31, Pillar 14 open item #74).
//
// This page still decides HOW MANY cards to hand the renderer. The Featured
// and Recently Added rails render in full — they're already small and
// bounded (a curated set, and RECENTLY_ADDED_CAP). The PNW and National
// grids are the ones that grow with the directory, so they render only a
// first window; the client renders the rest of the same campsLite data on
// "Show more" or when a filter changes. That's the actual fix: before this
// change every approved camp became a DOM node on every visit (323 nodes
// live at 603KB on 2026-07-31, on its way to far more as the directory
// grows), because the client filter only ever toggled display:none on cards
// that already existed. It never rendered a card itself. Now it can.
const CARD_WINDOW = 24;

// Mirrors the client's default filter state (state.showLeagues = false,
// state.showFull = false — see the client script below), so the server's
// first-paint window matches what the client shows once it takes over.
// Without this, a reader would see leagues and full programs in the first
// 24 cards for a moment, then watch them vanish once JS applies the real
// default filter.
const defaultVisible = (list: Camp[]) => list.filter((c) => c.program_type !== 'league' && c.spots_status !== 'full');
const pnwVisible = defaultVisible(pnw);
const nationalVisible = defaultVisible(elsewhere);
const pnwWindow = pnwVisible.slice(0, CARD_WINDOW);
const nationalWindow = nationalVisible.slice(0, CARD_WINDOW);
const pnwHasMore = pnwVisible.length > pnwWindow.length;
const nationalHasMore = nationalVisible.length > nationalWindow.length;
// True total match count under the default filter — reported on the results
// line and kept current by the client as filters change. Not the same as
// the rendered-card count once windowing is in play.
const totalVisibleDefault = pnwVisible.length + nationalVisible.length;

const featuredCardsHtml = featuredCamps.map((c) => renderFeaturedCardHtml(c, CAMP_SPORTS)).join('');
const recentlyAddedHtml = recentlyAddedCamps.map((c) => renderCardHtml(c, CAMP_SPORTS)).join('');
const pnwHtml = pnwWindow.map((c) => renderCardHtml(c, CAMP_SPORTS)).join('');
const nationalHtml = nationalWindow.map((c) => renderCardHtml(c, CAMP_SPORTS)).join('');

// Serialize camps for client-side JS — slim payload, not the full DB row.
// This is the data the map and the filters both work from; it stays
// comprehensive (bounded only by listApprovedCamps' hard cap, not by the
// CARD_WINDOW above) because the map needs a point for every matching camp
// even when only 24 of them are cards in the DOM. Extended 2026-07-31 with
// the four fields the shared card renderer needs that weren't here before:
// hero_photo_key, price_text, last_verified_at, date_added.
const campsLite = camps.map(c => ({
  id: c.id,
  name: c.name,
  slug: c.slug,
  sport: c.sport,
  age_min: c.age_min,
  age_max: c.age_max,
  age_known: c.age_known,
  start_date: c.start_date,
  end_date: c.end_date,
  city: c.city,
  state: c.state,
  day_or_overnight: c.day_or_overnight,
  spots_status: c.spots_status,
  verified: c.verified,
  last_verified_at: c.last_verified_at,
  program_type: c.program_type,
  latitude: c.latitude,
  longitude: c.longitude,
  description: (c.description || '').slice(0, 200),
  hero_photo_key: c.hero_photo_key,
  price_text: c.price_text,
  date_added: c.date_added,
}));
const campsJson = JSON.stringify(campsLite);
// CAMP_SPORTS already includes the camp-only options (multi-sport, outdoor, stem, general, etc).
const sportsListJson = JSON.stringify(CAMP_SPORTS);

// JSON-LD: this directory hub emitted nothing before this fix (2026-07
// audit: "Schema.org emission is unverified across the site" -- verified
// live 2026-07-15, this page had zero <script type="application/ld+json">
// tags). BreadcrumbList is free. ItemList covers the featured camps when
// any exist (a curated, stable subset -- the right fit for ItemList, which
// wants a meaningful ranked/ordered list, not a raw dump of 1,300+ rows
// that reshuffles every 10 minutes as D1 changes).
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://parentcoachdesk.com' },
    { '@type': 'ListItem', position: 2, name: 'Camps & Leagues' },
  ],
};
const itemListSchema = featuredCamps.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: featuredCamps.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    url: `https://parentcoachdesk.com/camps/${c.slug}/`,
  })),
} : null;
---
<BaseLayout
  title="Camps & Leagues"
  description="Youth camps and league signups we know about. Starting in the Pacific Northwest where we can verify programs personally. National listings welcome."
  ogImage="/illustrations/og-camps.jpg"
>
  <script slot="head" type="application/ld+json" set:html={serializeJsonLd(breadcrumbSchema)} />
  {itemListSchema && <script slot="head" type="application/ld+json" set:html={serializeJsonLd(itemListSchema)} />}
  <section class="section-band">
    <div class="container-px py-12 md:py-16">
      <p class="t-eyebrow mb-3">Camps & Leagues</p>
      <h1 class="t-h1-hero font-display text-ink leading-[1.0] font-medium">
        A directory of <em class="text-rust">camps and leagues</em> your kid can actually sign up for.
      </h1>
      <p class="font-display text-ink-soft text-xl md:text-2xl mt-6 max-w-2xl leading-snug">
        Youth camps and league signups, with the dates, ages, prices, and contact info you actually need to plan. Submitted by parents and program directors. Reviewed before they go live. Full programs and leagues are hidden by default. Flip the toggles to see them.
      </p>
      <p class="font-body text-ink-soft text-sm mt-4 max-w-2xl leading-relaxed">
        A “Verified” badge means our team compared the listed program details with its cited source. It does not mean PCD inspected the program or endorses its safety, quality, staff, insurance, or suitability for your child.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/camps/submit/" class="btn">Submit a program</a>
        <a href="#all-camps" class="btn btn-ghost">Browse the directory</a>
      </div>
    </div>
  </section>

  <!-- Honest scope disclosure -->
  <section class="section-band section-band-sunken">
    <div class="container-px py-8">
      <div class="grid md:grid-cols-12 gap-6 items-start">
        <div class="md:col-span-3">
          <p class="t-eyebrow">Where we are starting</p>
        </div>
        <div class="md:col-span-9 article-body">
          <p>We're starting in the Pacific Northwest where we can verify camps and leagues personally. National listings welcome but light coverage outside PNW for now. If you run a camp or league anywhere in the country and want it in the directory, <a href="/camps/submit/" class="text-rust hover:underline">submit it here</a>. We'll review and publish it. Just know of an organization but not the specifics? <a href="/camps/suggest/" class="text-rust hover:underline">Suggest it</a> and we'll look into it.</p>
          <p style="font-size: 0.875rem; color: var(--ink-soft);">Some programs don't have coordinates yet and won't appear on the map, but you'll find them in the directory below.</p>
        </div>
      </div>
    </div>
  </section>

  {featuredCamps.length > 0 && (
    <section class="section-band">
      <div class="container-px py-8">
        <p class="t-eyebrow mb-2">Featured</p>
        <h2 class="t-h2 font-display text-ink leading-tight font-medium mb-5">Featured camps</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" set:html={featuredCardsHtml} />
      </div>
    </section>
  )}

  {recentlyAddedCamps.length > 0 && (
    <section class="section-band">
      <div class="container-px py-8">
        <p class="t-eyebrow mb-2">Recently added</p>
        <h2 class="t-h2 font-display text-ink leading-tight font-medium mb-5">New in the directory</h2>
        <div id="recently-added-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" set:html={recentlyAddedHtml} />
      </div>
    </section>
  )}

  <section id="all-camps">
    <div class="container-px py-12">
      {dbAvailable && camps.length > 0 && (
        <p class="font-body text-muted text-sm mb-6">
          <span id="camps-results-count" aria-live="polite">{totalVisibleDefault} camp{totalVisibleDefault === 1 ? '' : 's'} listed</span> · {recentlyAddedCount} added in the last {RECENTLY_ADDED_WINDOW_DAYS} days
        </p>
      )}
      {/* Announces "Show more" loads to screen reader users — drawing new
          cards into the DOM is silent otherwise, so someone using a screen
          reader gets no signal that anything happened. Kept separate from
          #camps-results-count, which reports the filtered total, not what
          "Show more" just added. Visually hidden (Tailwind's sr-only). */}
      <div id="camps-load-announcer" aria-live="polite" class="sr-only"></div>
      {!dbAvailable ? (
        <div class="card p-6 max-w-xl">
          <p class="font-body text-ink-soft">Directory is warming up. Try again in a moment.</p>
        </div>
      ) : camps.length === 0 ? (
        <div class="card p-6 md:p-8">
          <Illo
            base="camps-empty-state"
            alt="A summer camp at golden hour: a wooded lakeside, a wooden dock, two canoes."
            class="w-full max-w-3xl mb-8 rounded-card"
            sizes="(min-width: 768px) 768px, 100vw"
          />
          <p class="t-eyebrow mb-3">Coming online</p>
          <h2 class="t-h2 font-display text-ink leading-tight max-w-2xl font-medium">
            No camps in the directory yet.
          </h2>
          <p class="font-display text-ink-soft mt-4 max-w-2xl leading-snug">
            We launched the directory recently. The first batch of Pacific-Northwest camps is being reviewed. If you run a camp or send your kid to one, you can <a href="/camps/submit/" class="text-rust hover:underline">submit it</a>. Submissions stay pending until a person reviews the available source evidence.
          </p>
        </div>
      ) : (
        <>
          {/* Map */}
          <div
            id="camps-map"
            class="mb-8 border border-bone rounded-card overflow-hidden"
            style="height: 400px; width: 100%; background: var(--stripe);"
            aria-label="Map showing all camps in the directory"
          ></div>

          {/* Filter Bar */}
          <div id="camp-filters" class="card mb-8 p-6">
            <div class="flex flex-wrap items-end gap-4 mb-6">
              {/* Search by name */}
              <div>
                <label for="filter-search" class="font-display italic text-rust text-xs block mb-2 font-medium">Search</label>
                <input
                  type="search"
                  id="filter-search"
                  placeholder="Camp name, org, or keyword"
                  class="min-h-11 font-display px-3 py-2 border border-input bg-paper-warm rounded-btn w-64"
                  style="min-height: 44px;"
                />
              </div>

              {/* Sport Dropdown */}
              <div>
                <label for="filter-sport" class="font-display italic text-rust text-xs block mb-2 font-medium">Sport</label>
                <select id="filter-sport" class="min-h-11 font-display px-3 py-2 border border-input bg-paper-warm rounded-btn" style="min-height: 44px;">
                  <option value="">All sports</option>
                </select>
              </div>

              {/* Age Range */}
              <div>
                <label for="filter-age-min" class="font-display italic text-rust text-xs block mb-2 font-medium">Age range</label>
                <div class="flex gap-2">
                  <input
                    type="number"
                    id="filter-age-min"
                    aria-label="Minimum age"
                    placeholder="Min"
                    min="3"
                    max="22"
                    class="min-h-11 font-display px-3 py-2 border border-input bg-paper-warm rounded-btn w-16"
                    style="min-height: 44px;"
                  />
                  <span class="text-ink-soft px-1">to</span>
                  <input
                    type="number"
                    id="filter-age-max"
                    aria-label="Maximum age"
                    placeholder="Max"
                    min="3"
                    max="22"
                    class="min-h-11 font-display px-3 py-2 border border-input bg-paper-warm rounded-btn w-16"
                    style="min-height: 44px;"
                  />
                </div>
              </div>

              {/* Date Range */}
              <div>
                <p class="font-display italic text-rust text-xs mb-2 font-medium">Date range</p>
                <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] gap-2 items-center max-w-full">
                  <input
                    type="date"
                    id="filter-date-start"
                    aria-label="Earliest start date"
                    class="min-h-11 font-display px-2 sm:px-3 py-2 border border-input bg-paper-warm rounded-btn w-full min-w-0"
                    style="min-height: 44px;"
                  />
                  <span class="text-ink-soft px-1">to</span>
                  <input
                    type="date"
                    id="filter-date-end"
                    aria-label="Latest end date"
                    class="min-h-11 font-display px-2 sm:px-3 py-2 border border-input bg-paper-warm rounded-btn w-full min-w-0"
                    style="min-height: 44px;"
                  />
                </div>
              </div>

              {/* Day/Overnight */}
              <div>
                <p class="font-display italic text-rust text-xs mb-2 font-medium">Format</p>
                <div class="flex gap-2">
                  <button type="button" data-filter-dayovernght="all" class="min-h-11 inline-flex items-center justify-center filter-toggle font-display px-3 py-2 border border-bone bg-paper-warm rounded-btn hover:bg-stripe transition-colors" data-active="true" style="min-height: 44px; background: var(--rust); color: white; border-color: var(--rust);">All</button>
                  <button type="button" data-filter-dayovernght="day" class="min-h-11 inline-flex items-center justify-center filter-toggle font-display px-3 py-2 border border-bone bg-paper-warm rounded-btn hover:bg-stripe transition-colors" style="min-height: 44px;">Day</button>
                  <button type="button" data-filter-dayovernght="overnight" class="min-h-11 inline-flex items-center justify-center filter-toggle font-display px-3 py-2 border border-bone bg-paper-warm rounded-btn hover:bg-stripe transition-colors" style="min-height: 44px;">Overnight</button>
                </div>
              </div>

              {/* Include hidden-by-default rows */}
              <div>
                <p class="font-display italic text-rust text-xs mb-2 font-medium">Include</p>
                <div class="flex gap-2">
                  <button type="button" id="filter-show-leagues" class="min-h-11 inline-flex items-center justify-center filter-toggle font-display px-3 py-2 border border-bone bg-paper-warm rounded-btn hover:bg-stripe transition-colors" style="min-height: 44px;">Leagues</button>
                  <button type="button" id="filter-show-full" class="min-h-11 inline-flex items-center justify-center filter-toggle font-display px-3 py-2 border border-bone bg-paper-warm rounded-btn hover:bg-stripe transition-colors" style="min-height: 44px;">Full programs</button>
                </div>
              </div>

              <div>
                <p class="font-display italic text-rust text-xs mb-2 font-medium">Trust & availability</p>
                <div class="flex gap-2">
                  <button type="button" id="filter-verified-only" class="min-h-11 inline-flex items-center justify-center filter-toggle font-display px-3 py-2 border border-bone bg-paper-warm rounded-btn hover:bg-stripe transition-colors" style="min-height: 44px;">Verified only</button>
                  <button type="button" id="filter-open-only" class="min-h-11 inline-flex items-center justify-center filter-toggle font-display px-3 py-2 border border-bone bg-paper-warm rounded-btn hover:bg-stripe transition-colors" style="min-height: 44px;">Open only</button>
                </div>
              </div>

              {/* State Dropdown */}
              <div>
                <label for="filter-state" class="font-display italic text-rust text-xs block mb-2 font-medium">State</label>
                <select id="filter-state" class="min-h-11 font-display px-3 py-2 border border-input bg-paper-warm rounded-btn" style="min-height: 44px;">
                  <option value="">All states</option>
                </select>
              </div>

              {/* Zip + Radius */}
              <form id="filter-zip-form" class="grid grid-cols-2 sm:flex gap-2 items-end w-full max-w-full">
                <div class="min-w-0">
                  <label for="filter-zip" class="font-display italic text-rust text-xs block mb-2 font-medium">Zip code</label>
                  <input
                    type="text"
                    id="filter-zip"
                    placeholder="e.g. 98101"
                    maxlength="10"
                    class="min-h-11 font-display px-3 py-2 border border-input bg-paper-warm rounded-btn w-full sm:w-32 min-w-0 max-w-full"
                    style="min-height: 44px;"
                  />
                </div>
                <div class="min-w-0">
                  <label for="filter-radius" class="font-display italic text-rust text-xs block mb-2 font-medium">Radius</label>
                  <select id="filter-radius" class="min-h-11 font-display px-3 py-2 border border-input bg-paper-warm rounded-btn w-full min-w-0 max-w-full" style="min-height: 44px;">
                    <option value="10">10 miles</option>
                    <option value="25">25 miles</option>
                    <option value="50">50 miles</option>
                    <option value="100">100 miles</option>
                    <option value="all">Any distance</option>
                  </select>
                </div>
                <button type="submit" class="btn col-span-2 sm:w-auto">Search</button>
              </form>
            </div>

            {/* Clear Filters */}
            <button id="clear-filters" class="font-display italic text-rust text-sm hover:underline font-medium px-2 inline-flex items-center" style="min-height: 44px;">Clear all filters</button>
          </div>

          {/* No JS on this page means no filtering, search, map, or "Show
               more" — all of that runs client-side (see the script below).
               Without JS the reader gets the first CARD_WINDOW matching
               cards per region, server-rendered, plus the Featured and
               Recently Added rails in full. The .js-show-more rule below
               hides the "Show more" buttons in that case instead of shipping
               a button that does nothing when clicked. */}
          <noscript><style>.js-show-more{display:none}</style></noscript>

          {/* Camps Grid — cards are pre-rendered as an HTML string by
               src/lib/camp-card.ts (much faster than per-element JSX over
               hundreds of rows) and injected via set:html. Only the first
               CARD_WINDOW matching cards per region render server-side; the
               client script renders the rest of the same campsLite data on
               "Show more" or when a filter changes, using the identical
               renderer so a card never looks different card to card. */}
          <div id="camps-directory">
            {pnw.length > 0 && (
              <div class="mb-12">
                <p class="t-eyebrow mb-3">Pacific Northwest</p>
                <div id="pnw-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" set:html={pnwHtml}></div>
                <div class="mt-6 text-center">
                  <button type="button" id="pnw-show-more" class="btn btn-ghost js-show-more" style="min-height: 44px;" hidden={!pnwHasMore}>Show more Pacific Northwest camps</button>
                </div>
                <noscript>
                  <p class="font-body text-ink-soft text-sm mt-4">Showing the first {pnwWindow.length} Pacific Northwest camps. Turn on JavaScript to filter, search by zip, see the map, or load more.</p>
                </noscript>
              </div>
            )}

            {elsewhere.length > 0 && (
              <div>
                <p class="t-eyebrow mb-3">National</p>
                <div id="national-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" set:html={nationalHtml}></div>
                <div class="mt-6 text-center">
                  <button type="button" id="national-show-more" class="btn btn-ghost js-show-more" style="min-height: 44px;" hidden={!nationalHasMore}>Show more National camps</button>
                </div>
                <noscript>
                  <p class="font-body text-ink-soft text-sm mt-4">Showing the first {nationalWindow.length} National camps. Turn on JavaScript to filter, search by zip, see the map, or load more.</p>
                </noscript>
              </div>
            )}
          </div>
        </>
      )}
    </div>
  </section>

  <NewsletterSignup
    headline="New camps as we verify them"
    blurb="Subscribe and we'll send a Friday note when new camps land in the directory."
  />


  {/* JSON data island — non-executable, exempt from script-src CSP. The
      bundled script below reads it via getElementById so we can remove
      is:inline + define:vars and eliminate that unsafe-inline vector. */}
  <script type="application/json" id="camps-data" set:html={serializeJsonLd({ camps: campsLite, sports: CAMP_SPORTS })} />

  <script>
    import L from 'leaflet';
    import 'leaflet/dist/leaflet.css';
    import 'leaflet.markercluster';
    import 'leaflet.markercluster/dist/MarkerCluster.css';
    import 'leaflet.markercluster/dist/MarkerCluster.Default.css';
    import { buildCampDemandPayload } from '../../lib/camp-demand';
    import { renderCardHtml, escHtml, type CardCamp, type SportOption } from '../../lib/camp-card';

    // Self-contained inline-SVG pin. The prior fix imported Leaflet's default
    // marker PNGs and pointed L.Icon.Default at them, but pins still didn't
    // render on the deployed site — the icon request resolved to the literal
    // URL /camps/[object%20Object] (a 404), because the imported PNG module
    // wasn't unwrapped to a plain string URL inside this bundled script. A
    // divIcon sidesteps the problem entirely: it's inline HTML/SVG, so
    // there's no image asset to resolve, hash, or 404 on.
    function campPinIcon() {
      const w = 26;
      const h = 38;
      return L.divIcon({
        className: 'camp-pin',
        html: `<svg width="${w}" height="${h}" viewBox="0 0 26 38" xmlns="http://www.w3.org/2000/svg" style="display:block; filter: drop-shadow(0 1px 2px rgba(4,30,66,0.45));">
          <path d="M13 0C5.82 0 0 5.82 0 13c0 9.75 13 25 13 25s13-15.25 13-25C26 5.82 20.18 0 13 0z" fill="var(--accent)"/>
          <circle cx="13" cy="13" r="5" fill="var(--surface)"/>
        </svg>`,
        iconSize: [w, h],
        iconAnchor: [w / 2, h],
        popupAnchor: [0, -h + 4],
      });
    }

    (function () {
      interface LiteCamp {
        id: string;
        name: string;
        slug: string;
        sport: string;
        age_min: number;
        age_max: number;
        age_known: 0 | 1;
        start_date: string;
        end_date: string;
        city: string;
        state: string;
        day_or_overnight: string;
        spots_status: string;
        verified: 0 | 1;
        last_verified_at: string | null;
        program_type: string | null;
        latitude: number | null;
        longitude: number | null;
        description: string;
        hero_photo_key: string | null;
        price_text: string | null;
        date_added: string | null;
      }
      // LiteCamp above must keep satisfying CardCamp (imported from
      // camp-card.ts) structurally — it's what gets handed to
      // renderCardHtml below. TypeScript enforces that at the call site.

      const dataEl = document.getElementById('camps-data');
      const _data = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};
      const camps: LiteCamp[] = _data.camps || [];
      const sportsList: SportOption[] = _data.sports || [];

      // Helper: get sport label (used by the map popup below; renderCardHtml
      // does its own lookup against the same sportsList internally).
      function sportLabel(slug: string): string {
        const match = sportsList.find(s => s.slug === slug);
        return match ? match.label : slug.split(/[\s_-]+/).map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      }

      const PNW = new Set(['WA', 'OR', 'ID', 'MT', 'AK']);
      const CARD_WINDOW = 24;

      // Pillar 14 QA (2026-07-31): the desktop CARD_WINDOW (24 per grid) at
      // 60 total first-paint cards (24 PNW + 24 National + 12 Recently
      // Added) projected to ~15,000-21,000px on a 390px viewport, still well
      // above the ~8,000px flag. This page is cached at Cloudflare's edge
      // (see the Cache-Control header up top) so the *server* can't render a
      // smaller window for phones without either breaking that shared cache
      // or adding Vary: viewport-width plumbing neither Cloudflare nor this
      // app has. But applyFilters() below already re-renders the grids from
      // campsLite on every load regardless of device, so the client can pick
      // a smaller starting window for narrow viewports without touching SSR
      // or the no-JS/crawler path at all. matches Tailwind's md breakpoint
      // (768px), same one .container-px and .t-card-title already use.
      const isMobileViewport = () => window.matchMedia('(max-width: 767px)').matches;
      // 6, not 24 — see the height arithmetic in
      // reports/CAMPS-RENDERING-REBUILD-2026-07-31.md. 6+6 grid cards + the
      // Recently Added rail capped to 3 on mobile (CSS, this file's
      // <style is:global> block) is what actually clears the ~8,000px flag
      // once the photo is also stripped on mobile; 8+8+4 (the first attempt)
      // still projected to ~8,400px, over the line.
      const CARD_WINDOW_MOBILE = 6;
      const activeCardWindow = () => (isMobileViewport() ? CARD_WINDOW_MOBILE : CARD_WINDOW);
      let pnwShown = activeCardWindow();
      let nationalShown = activeCardWindow();

      // Helper: haversine distance in miles
      function haversineMiles(lat1: number, lon1: number, lat2: number, lon2: number): number {
        const toRad = (d: number) => d * Math.PI / 180;
        const R = 3958.8;
        const dLat = toRad(lat2 - lat1);
        const dLon = toRad(lon2 - lon1);
        const a = Math.sin(dLat/2)**2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon/2)**2;
        return 2 * R * Math.asin(Math.sqrt(a));
      }

      // Helper: geocode zip via Nominatim. Uses structured query so the
      // country filter actually applies — `country=US` is silently ignored
      // when paired with free-text `q=`, which was causing "98101" to
      // resolve to a French postcode about 50% of the time. Falls back to
      // "ZIP, USA" free-text if structured returns nothing.
      async function geocodeZip(zip: string): Promise<{ lat: number; lon: number } | null> {
        // One user-triggered request only. Do not turn this into autocomplete
        // or add fallbacks: the public Nominatim service caps the application
        // at one request per second across all visitors.
        const url = `https://nominatim.openstreetmap.org/search?postalcode=${encodeURIComponent(zip)}&countrycodes=us&format=json&limit=1`;
        try {
          const r = await fetch(url, { headers: { 'Accept-Language': 'en' } });
          if (!r.ok) return null;
          const data = (await r.json()) as Array<{ lat: string; lon: string }>;
          if (!data.length) return null;
          const lat = parseFloat(data[0].lat);
          const lon = parseFloat(data[0].lon);
          if (Number.isFinite(lat) && Number.isFinite(lon)) return { lat, lon };
        } catch {
          // The directory remains usable through state and other filters.
        }
        return null;
      }

      // Filter state. showLeagues and showFull default to false so the page
      // opens with only camps that parents can actually sign up for right now.
      interface FilterState {
        search: string;
        sport: string;
        ageMin: number | null;
        ageMax: number | null;
        dateStart: string;  // ISO YYYY-MM-DD; empty means no lower bound
        dateEnd: string;    // ISO YYYY-MM-DD; empty means no upper bound
        dayOvernight: string;
        state: string;
        zipLat: number | null;
        zipLon: number | null;
        zipRadius: number;
        showLeagues: boolean;
        showFull: boolean;
        verifiedOnly: boolean;
        openOnly: boolean;
      }
      let state: FilterState = {
        search: '',
        sport: '',
        ageMin: null,
        ageMax: null,
        dateStart: '',
        dateEnd: '',
        dayOvernight: 'all',
        state: '',
        zipLat: null,
        zipLon: null,
        zipRadius: 10,
        showLeagues: false,
        showFull: false,
        verifiedOnly: false,
        openOnly: false,
      };

      let map: L.Map | null = null;
      let clusterGroup: L.MarkerClusterGroup | null = null;
      let visibleCamps: LiteCamp[] = [];
      let demandTimer: ReturnType<typeof setTimeout> | undefined;

      // Default-off at the endpoint. The client sends only the minimized
      // payload returned by buildCampDemandPayload; precise location state is
      // deliberately used for filtering and discarded before this boundary.
      function scheduleDemandEvent() {
        if (demandTimer) clearTimeout(demandTimer);
        demandTimer = setTimeout(() => {
          const payload = buildCampDemandPayload(state, visibleCamps.length);
          if (!payload) return;
          fetch('/api/search-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          }).catch(() => {});
        }, 600);
      }

      // Initialize map
      function initMap() {
        const mapEl = document.getElementById('camps-map');
        if (!mapEl || typeof L === 'undefined') return setTimeout(initMap, 100);

        const campsWithGeo = camps.filter(c => typeof c.latitude === 'number' && typeof c.longitude === 'number');

        // Default to a continental US frame so first paint shows the whole footprint,
        // not the math-centroid of all camps (which lands in Nebraska when most camps
        // are on the coasts).
        map = L.map(mapEl, { scrollWheelZoom: false, attributionControl: true })
          .setView([39.5, -98.5], 4);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '&copy; OpenStreetMap',
        }).addTo(map);

        // Cluster group replaces loose markers. Zoomed out shows count
        // bubbles; zooming in (or clicking a bubble) splits them down to
        // individual pins. Default cluster icons are pure CSS (no external
        // images), themed to the site's rust palette below.
        clusterGroup = L.markerClusterGroup({
          maxClusterRadius: 60,
          spiderfyOnMaxZoom: true,
          showCoverageOnHover: false,
          iconCreateFunction(cluster) {
            const count = cluster.getChildCount();
            const size = count < 10 ? 'small' : count < 100 ? 'medium' : 'large';
            return L.divIcon({
              html: `<div><span aria-label="${count} programs in this map area">${count}</span></div>`,
              className: `marker-cluster marker-cluster-${size}`,
              iconSize: L.point(40, 40),
            });
          },
        });
        map.addLayer(clusterGroup);

        // Then fit to actual camp bounds. fitBounds beats centroid+zoom because it
        // frames every pin regardless of how skewed the distribution is.
        if (campsWithGeo.length > 0) {
          const bounds = L.latLngBounds(campsWithGeo.map(c => [c.latitude, c.longitude] as [number, number]));
          map.fitBounds(bounds, { padding: [40, 40], maxZoom: 10 });
        }
      }

      // Render map markers
      function renderMap() {
        if (!map || !clusterGroup) return;
        const activeMap = map;
        const activeClusterGroup = clusterGroup;

        // Clear old markers — clearLayers empties the whole cluster group in
        // one call instead of removing pins one at a time.
        activeClusterGroup.clearLayers();

        // Track positions we've already pinned. Camps at the exact same coords get nudged
        // a tiny amount so all pins stay clickable instead of stacking under one another.
        const positionCounts: Record<string, number> = {};
        const jitterFor = (lat: number, lon: number): [number, number] => {
          const key = `${lat.toFixed(6)},${lon.toFixed(6)}`;
          const idx = positionCounts[key] || 0;
          positionCounts[key] = idx + 1;
          if (idx === 0) return [lat, lon];
          // ~0.0002 deg = ~70 ft. Spread overlapping pins in a small ring.
          const angle = (idx - 1) * (Math.PI * 2 / 6);
          const r = 0.00018;
          return [lat + r * Math.sin(angle), lon + r * Math.cos(angle)];
        };

        // Add markers for visible camps
        const pinnedCoords: [number, number][] = [];
        visibleCamps.forEach(c => {
          if (typeof c.latitude === 'number' && typeof c.longitude === 'number') {
            const [latJ, lonJ] = jitterFor(c.latitude, c.longitude);
            const marker = L.marker([latJ, lonJ], { icon: campPinIcon() });
            // Escaped exactly like renderCardHtml — camp name/city/state come
            // from public submissions and moderator review does not guarantee
            // a raw script/HTML string in one of those fields gets caught, so
            // this popup is as much a stored-XSS surface as a card. Found
            // unescaped in QA (2026-07-31) and fixed here; leaflet's
            // bindPopup renders whatever string it is handed as real HTML.
            const popup = `<div style="font-size: 14px;">
              <strong>${escHtml(c.name)}</strong><br/>
              ${escHtml(c.city)}, ${escHtml(c.state)}<br/>
              ${escHtml(sportLabel(c.sport))}<br/>
              <a href="/camps/${escHtml(c.slug)}/" style="color: var(--rust); text-decoration: none;">View camp ↗</a>
            </div>`;
            marker.bindPopup(popup);
            activeClusterGroup.addLayer(marker);
            pinnedCoords.push([c.latitude, c.longitude]);
          }
        });

        // Re-fit bounds to whatever's currently visible. If a ZIP filter is
        // active, the user's center matters more than every pin, so leave the
        // existing zoom alone. Otherwise frame the visible set.
        if (pinnedCoords.length > 0 && state.zipLat == null) {
          const bounds = L.latLngBounds(pinnedCoords);
          activeMap.fitBounds(bounds, { padding: [40, 40], maxZoom: 12 });
        }
      }

      // Apply all filters
      function applyFilters() {
        visibleCamps = camps.filter(c => {
          // Hide leagues unless toggled on. program_type may be undefined on
          // older rows imported before the schema was extended; treat those as 'camp'.
          const isLeague = c.program_type === 'league';
          if (isLeague && !state.showLeagues) return false;

          // Hide full programs unless toggled on.
          if (c.spots_status === 'full' && !state.showFull) return false;
          if (state.verifiedOnly && c.verified !== 1) return false;
          if (state.openOnly && c.spots_status !== 'open') return false;

          // Free-text search across name, city, and description. Case-insensitive
          // substring match. Empty string matches everything.
          if (state.search) {
            const q = state.search.toLowerCase();
            const haystack = `${c.name} ${c.city} ${c.description}`.toLowerCase();
            if (!haystack.includes(q)) return false;
          }

          // Sport
          if (state.sport && c.sport !== state.sport) return false;

          // Age range
          if ((state.ageMin !== null || state.ageMax !== null) && c.age_known !== 1) return false;
          if (state.ageMin !== null && c.age_max < state.ageMin) return false;
          if (state.ageMax !== null && c.age_min > state.ageMax) return false;

          // Date range — overlap test. Camp matches if any of its days fall
          // inside the requested window: camp.start <= filter.end AND
          // camp.end >= filter.start. Empty bound = no constraint on that side.
          if (state.dateStart && c.end_date < state.dateStart) return false;
          if (state.dateEnd && c.start_date > state.dateEnd) return false;

          // Day/overnight
          if (state.dayOvernight !== 'all' && c.day_or_overnight !== state.dayOvernight) return false;

          // State
          if (state.state && c.state !== state.state) return false;

          // Zip radius. Infinity means user picked "Any distance" — zip filter
          // is effectively off, all camps pass regardless of coordinates.
          if (state.zipLat !== null && state.zipLon !== null && Number.isFinite(state.zipRadius)) {
            if (typeof c.latitude !== 'number' || typeof c.longitude !== 'number') return false;
            const dist = haversineMiles(state.zipLat, state.zipLon, c.latitude, c.longitude);
            if (dist > state.zipRadius) return false;
          }

          return true;
        });

        // Featured and Recently Added stay fully rendered (small, bounded
        // rails) and just get toggled with display:none like before. PNW
        // and National are the windowed grids — renderGrids() below rebuilds
        // their contents outright instead of hiding pre-existing nodes, so
        // skip them here to avoid doing (and then immediately overwriting)
        // the same work twice.
        document.querySelectorAll<HTMLElement>('.camp-card').forEach(card => {
          if (card.closest('#pnw-grid') || card.closest('#national-grid')) return;
          const campId = card.getAttribute('data-camp-id');
          const isVisible = visibleCamps.some(c => c.id === campId);
          card.style.display = isVisible ? '' : 'none';
        });

        // A new filter result restarts each region's window at the first
        // activeCardWindow() matches (device-sized — see its definition
        // above). "Show more" bumps pnwShown/nationalShown directly and
        // calls renderGrids() without going through here, so it isn't reset
        // out from under itself.
        pnwShown = activeCardWindow();
        nationalShown = activeCardWindow();
        renderGrids();
        updateResultsCount();
        renderMap();
      }

      // Rebuilds the PNW and National grids from the current visibleCamps,
      // rendering only pnwShown / nationalShown cards per region through the
      // same renderCardHtml the server used for first paint. The map (see
      // renderMap) still gets every matching camp regardless of what's
      // rendered here — windowing is a DOM concern, not a data concern.
      function renderGrids() {
        const pnwMatches = visibleCamps.filter(c => PNW.has(c.state));
        const nationalMatches = visibleCamps.filter(c => !PNW.has(c.state));

        const pnwGrid = document.getElementById('pnw-grid');
        if (pnwGrid) pnwGrid.innerHTML = pnwMatches.slice(0, pnwShown).map(c => renderCardHtml(c, sportsList)).join('');

        const nationalGrid = document.getElementById('national-grid');
        if (nationalGrid) nationalGrid.innerHTML = nationalMatches.slice(0, nationalShown).map(c => renderCardHtml(c, sportsList)).join('');

        toggleShowMore('pnw-show-more', pnwMatches.length, pnwShown);
        toggleShowMore('national-show-more', nationalMatches.length, nationalShown);
      }

      function toggleShowMore(buttonId: string, totalMatches: number, shown: number) {
        const btn = document.getElementById(buttonId) as HTMLButtonElement | null;
        if (!btn) return;
        const remaining = totalMatches - shown;
        if (remaining > 0) {
          btn.hidden = false;
          btn.textContent = `Show ${Math.min(activeCardWindow(), remaining)} more (${remaining} left)`;
        } else {
          btn.hidden = true;
        }
      }

      // Screen-reader announcement for a "Show more" click — see the
      // #camps-load-announcer element in the markup above. renderGrids()
      // itself stays silent (it also runs from applyFilters(), which already
      // has its own results-count announcement) so only an actual "Show
      // more" click speaks up.
      function announceLoaded(label: string, added: number) {
        const el = document.getElementById('camps-load-announcer');
        if (el) el.textContent = `Showing ${added} more ${label} camps.`;
      }

      // Keeps the results line honest: the true total match count under the
      // current filters, not the number of cards actually in the DOM.
      function updateResultsCount() {
        const el = document.getElementById('camps-results-count');
        if (el) el.textContent = `${visibleCamps.length} camp${visibleCamps.length === 1 ? '' : 's'} listed`;
      }

      // Populate dropdowns
      function populateFilters() {
        // Sport options
        const sportSelect = document.getElementById('filter-sport') as unknown as HTMLSelectElement;
        const uniqueSports = [...new Set(camps.map(c => c.sport))].sort();
        uniqueSports.forEach(sport => {
          const opt = document.createElement('option');
          opt.value = sport;
          opt.textContent = sportLabel(sport);
          sportSelect.appendChild(opt);
        });

        // State options
        const stateSelect = document.getElementById('filter-state') as unknown as HTMLSelectElement;
        const uniqueStates = [...new Set(camps.map(c => c.state))].sort();
        uniqueStates.forEach(st => {
          const opt = document.createElement('option');
          opt.value = st;
          opt.textContent = st;
          stateSelect.appendChild(opt);
        });
      }

      // Event listeners
      function attachListeners() {
        // Free-text search
        (document.getElementById('filter-search') as HTMLInputElement).addEventListener('input', (e) => {
          state.search = (e.target as HTMLInputElement).value.trim();
          applyFilters();
        });

        // Sport
        (document.getElementById('filter-sport') as unknown as HTMLSelectElement).addEventListener('change', (e) => {
          state.sport = (e.target as HTMLSelectElement).value;
          applyFilters();
        });

        // Age min
        (document.getElementById('filter-age-min') as HTMLInputElement).addEventListener('input', (e) => {
          const v = (e.target as HTMLInputElement).value;
          state.ageMin = v ? parseInt(v, 10) : null;
          applyFilters();
        });

        // Age max
        (document.getElementById('filter-age-max') as HTMLInputElement).addEventListener('input', (e) => {
          const v = (e.target as HTMLInputElement).value;
          state.ageMax = v ? parseInt(v, 10) : null;
          applyFilters();
        });

        // Date start
        (document.getElementById('filter-date-start') as HTMLInputElement).addEventListener('change', (e) => {
          state.dateStart = (e.target as HTMLInputElement).value || '';
          applyFilters();
        });

        // Date end
        (document.getElementById('filter-date-end') as HTMLInputElement).addEventListener('change', (e) => {
          state.dateEnd = (e.target as HTMLInputElement).value || '';
          applyFilters();
        });

        // Visual helpers: filter toggle buttons need to *look* active when
        // pressed. Swap an inline style so the user gets feedback without
        // needing a CSS file change.
        const ACTIVE_STYLE = 'background: var(--rust); color: white; border-color: var(--rust);';
        function setToggleActive(btn: HTMLElement, active: boolean) {
          if (active) {
            btn.setAttribute('data-active', 'true');
            btn.style.cssText = ACTIVE_STYLE;
          } else {
            btn.removeAttribute('data-active');
            btn.style.cssText = '';
          }
        }

        // Day/overnight — single-select group
        document.querySelectorAll<HTMLElement>('[data-filter-dayovernght]').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll<HTMLElement>('[data-filter-dayovernght]').forEach(b => setToggleActive(b, false));
            setToggleActive(btn, true);
            state.dayOvernight = btn.getAttribute('data-filter-dayovernght') || 'all';
            applyFilters();
          });
        });

        // State
        (document.getElementById('filter-state') as unknown as HTMLSelectElement).addEventListener('change', (e) => {
          state.state = (e.target as HTMLSelectElement).value;
          applyFilters();
        });

        // Zip form. The submit button does the geocode; clearing the input
        // releases the filter automatically; changing the radius after a
        // successful search re-filters without requiring another click.
        (document.getElementById('filter-zip-form') as HTMLFormElement).addEventListener('submit', async (e) => {
          e.preventDefault();
          const zip = (document.getElementById('filter-zip') as HTMLInputElement).value.trim();
          if (!zip) {
            state.zipLat = null;
            state.zipLon = null;
            applyFilters();
            return;
          }

          const submitBtn = (e.target as HTMLFormElement).querySelector('button[type="submit"]') as HTMLButtonElement | null;
          const originalLabel = submitBtn ? submitBtn.textContent : null;
          if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Searching...'; }

          const geo = await geocodeZip(zip);

          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalLabel; }

          if (!geo) {
            alert('Zip code not found. Make sure it is a 5-digit US zip and try again.');
            return;
          }

          state.zipLat = geo.lat;
          state.zipLon = geo.lon;
          const radiusVal = (document.getElementById('filter-radius') as unknown as HTMLSelectElement).value;
          state.zipRadius = radiusVal === 'all' ? Infinity : parseInt(radiusVal, 10);
          applyFilters();
          scheduleDemandEvent();
        });

        // Clearing the zip input releases the radius filter immediately.
        (document.getElementById('filter-zip') as HTMLInputElement).addEventListener('input', (e) => {
          const v = (e.target as HTMLInputElement).value;
          if (!v.trim() && state.zipLat !== null) {
            state.zipLat = null;
            state.zipLon = null;
            applyFilters();
          }
        });

        // Changing the radius after a successful zip search re-filters in place.
        (document.getElementById('filter-radius') as unknown as HTMLSelectElement).addEventListener('change', (e) => {
          if (state.zipLat === null) return; // no active zip filter, nothing to do
          const v = (e.target as HTMLSelectElement).value;
          state.zipRadius = v === 'all' ? Infinity : parseInt(v, 10);
          applyFilters();
        });

        // Show leagues toggle (independent on/off)
        (document.getElementById('filter-show-leagues') as HTMLButtonElement).addEventListener('click', (e) => {
          state.showLeagues = !state.showLeagues;
          setToggleActive(e.currentTarget as HTMLElement, state.showLeagues);
          applyFilters();
        });

        // Show full toggle (independent on/off)
        (document.getElementById('filter-show-full') as HTMLButtonElement).addEventListener('click', (e) => {
          state.showFull = !state.showFull;
          setToggleActive(e.currentTarget as HTMLElement, state.showFull);
          applyFilters();
        });

        (document.getElementById('filter-verified-only') as HTMLButtonElement).addEventListener('click', (e) => {
          state.verifiedOnly = !state.verifiedOnly;
          setToggleActive(e.currentTarget as HTMLElement, state.verifiedOnly);
          applyFilters();
        });

        (document.getElementById('filter-open-only') as HTMLButtonElement).addEventListener('click', (e) => {
          state.openOnly = !state.openOnly;
          setToggleActive(e.currentTarget as HTMLElement, state.openOnly);
          applyFilters();
        });

        // Clear filters — resets to default which hides leagues + full programs.
        document.getElementById('clear-filters')!.addEventListener('click', () => {
          state = { search: '', sport: '', ageMin: null, ageMax: null, dateStart: '', dateEnd: '', dayOvernight: 'all', state: '', zipLat: null, zipLon: null, zipRadius: 10, showLeagues: false, showFull: false, verifiedOnly: false, openOnly: false };
          (document.getElementById('filter-search') as HTMLInputElement).value = '';
          (document.getElementById('filter-sport') as unknown as HTMLSelectElement).value = '';
          (document.getElementById('filter-age-min') as HTMLInputElement).value = '';
          (document.getElementById('filter-age-max') as HTMLInputElement).value = '';
          (document.getElementById('filter-date-start') as HTMLInputElement).value = '';
          (document.getElementById('filter-date-end') as HTMLInputElement).value = '';
          (document.getElementById('filter-state') as unknown as HTMLSelectElement).value = '';
          (document.getElementById('filter-zip') as HTMLInputElement).value = '';
          (document.getElementById('filter-radius') as unknown as HTMLSelectElement).value = '10';
          document.querySelectorAll<HTMLElement>('[data-filter-dayovernght]').forEach(b => setToggleActive(b, false));
          const allBtn = document.querySelector<HTMLElement>('[data-filter-dayovernght="all"]');
          if (allBtn) setToggleActive(allBtn, true);
          setToggleActive(document.getElementById('filter-show-leagues') as HTMLElement, false);
          setToggleActive(document.getElementById('filter-show-full') as HTMLElement, false);
          setToggleActive(document.getElementById('filter-verified-only') as HTMLElement, false);
          setToggleActive(document.getElementById('filter-open-only') as HTMLElement, false);
          applyFilters();
        });

        // "Show more" — bumps this region's window and re-renders just the
        // grids. Deliberately not applyFilters(): that recomputes
        // visibleCamps and resets both windows back to CARD_WINDOW, which
        // would undo the click that triggered it.
        document.getElementById('pnw-show-more')?.addEventListener('click', () => {
          const step = activeCardWindow();
          pnwShown += step;
          renderGrids();
          announceLoaded('Pacific Northwest', step);
        });
        document.getElementById('national-show-more')?.addEventListener('click', () => {
          const step = activeCardWindow();
          nationalShown += step;
          renderGrids();
          announceLoaded('National', step);
        });

        // Delegation observes user-driven filter changes after each control's
        // own handler updates state. Clear-all produces no event because the
        // minimized payload builder returns null for an unfiltered directory.
        const filterPanel = document.getElementById('camp-filters')!;
        filterPanel.addEventListener('input', scheduleDemandEvent);
        filterPanel.addEventListener('change', scheduleDemandEvent);
        filterPanel.addEventListener('click', scheduleDemandEvent);
      }

      // Initial setup
      populateFilters();
      attachListeners();
      initMap();
      renderMap();
      applyFilters();
    })();
  </script>

  <style is:global>
    /* Pillar 14 mobile-height fix (2026-07-31 QA). At 390px the 16:9 photo
       is the single largest thing in a card (~179px + margin) and a phone
       reader can find a camp fine from the title, dates, location, and CTA
       alone — the photo is decoration at this width, not information the
       card can't work without. Hidden below md (768px, same breakpoint
       .container-px already uses); untouched on tablet/desktop. Combined
       with the smaller mobile "Show more" window in the script below and
       the Recently Added cap right after this rule — see
       reports/CAMPS-RENDERING-REBUILD-2026-07-31.md for the full
       arithmetic behind these three changes together. */
    @media (max-width: 767px) {
      .camp-card-photo { display: none; }

      /* Recently Added duplicates camps that are already in the PNW/National
         grids below it — it's a preview rail, not the only place a given
         camp appears. Capping it to 3 on a phone (from 12) removes real
         height without removing a camp from the directory; the same camp
         is still reachable through the main grids and "Show more". */
      #recently-added-grid > .camp-card:nth-child(n+4) { display: none; }
    }

    /* Cluster bubbles themed to the site's navy/accent palette instead of
       leaflet.markercluster's default green/yellow/orange. Pure CSS —
       no external images, so nothing here can 404 like the old marker did. */
    .marker-cluster-small,
    .marker-cluster-medium,
    .marker-cluster-large {
      background-color: color-mix(in srgb, var(--accent) 25%, transparent);
    }
    .marker-cluster-small div,
    .marker-cluster-medium div,
    .marker-cluster-large div {
      background-color: var(--accent);
      color: var(--surface);
      font-family: inherit;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }
  </style>

</BaseLayout>
