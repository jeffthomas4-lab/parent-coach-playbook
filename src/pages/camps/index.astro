---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import Illo from '../../components/Illo.astro';
import { listApprovedCamps, listFeaturedCamps, slugifyCity, type Camp } from '../../lib/camps-db';
import { CAMP_SPORTS, AGE_BANDS } from '../../data/site';
import { env as cfEnv } from 'cloudflare:workers';
import { serializeJsonLd } from '../../lib/jsonld';
import { isRecentlyAdded, daysSinceAdded } from '../../lib/camp-freshness';
import { renderCardHtml, renderFeaturedCardHtml, RECENTLY_ADDED_WINDOW_DAYS } from '../../lib/camp-card';

// SSR. Pulls live from D1 each request, but the response is cached at
// Cloudflare's edge for 10 minutes (s-maxage=600), with stale-while-revalidate
// keeping the page snappy for up to 24 hours while a background refresh runs.
// Net effect: at typical traffic, ~1 D1 read per 10 minutes per Cloudflare PoP
// instead of 1 read per visit.
export const prerender = false;
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=600, stale-while-revalidate=86400',
);

const env = cfEnv as { DB: D1Database } | undefined;
let camps: Camp[] = [];
let dbAvailable = !!env?.DB;
if (env?.DB) {
  try {
    camps = await listApprovedCamps(env.DB);
  } catch (e) {
    console.error('listApprovedCamps failed', e);
  }
}

let featuredCamps: Camp[] = [];
if (env?.DB) {
  try {
    featuredCamps = await listFeaturedCamps(env.DB);
  } catch (e) {
    console.error('listFeaturedCamps failed', e);
  }
}

const PNW = new Set(['WA', 'OR', 'ID', 'MT', 'AK']);
const pnw = camps.filter(c => PNW.has(c.state));
const elsewhere = camps.filter(c => !PNW.has(c.state));

// "Recently added" — derived in-memory from the same `camps` array already
// fetched above. Does not issue a second D1 query and does not change what
// camps are eligible to appear anywhere else on this page; it only reorders
// a slice of the existing approved-camps result for display. Null-safe:
// camps with an unparseable date_added simply sort last / are excluded from
// the "added in the last 30 days" count below rather than throwing.
const RECENTLY_ADDED_CAP = 12;
const recentlyAddedCamps = [...camps]
  .filter((c) => daysSinceAdded(c.date_added) !== null)
  .sort((a, b) => (b.date_added || '').localeCompare(a.date_added || ''))
  .slice(0, RECENTLY_ADDED_CAP);
const recentlyAddedCount = camps.filter((c) => isRecentlyAdded(c.date_added, RECENTLY_ADDED_WINDOW_DAYS)).length;

// Card HTML rendering lives in src/lib/camp-card.ts now — shared with the
// client-side filter script below so a card built on the server and a card
// built in the browser are byte-identical. See that file's header comment
// for why (2026-07-31, Pillar 14 open item #74).
//
// This page still decides HOW MANY cards to hand the renderer. The Featured
// and Recently Added rails render in full — they're already small and
// bounded (a curated set, and RECENTLY_ADDED_CAP). The PNW and National
// grids are the ones that grow with the directory, so they render only a
// first window; the client renders the rest of the same campsLite data on
// "Show more" or when a filter changes. That's the actual fix: before this
// change every approved camp became a DOM node on every visit (323 nodes
// live at 603KB on 2026-07-31, on its way to far more as the directory
// grows), because the client filter only ever toggled display:none on cards
// that already existed. It never rendered a card itself. Now it can.
const CARD_WINDOW = 24;

// Mirrors the client's default filter state (state.showLeagues = false,
// state.showFull = false — see the client script below), so the server's
// first-paint window matches what the client shows once it takes over.
// Without this, a reader would see leagues and full programs in the first
// 24 cards for a moment, then watch them vanish once JS applies the real
// default filter.
const defaultVisible = (list: Camp[]) => list.filter((c) => c.program_type !== 'league' && c.spots_status !== 'full');
const pnwVisible = defaultVisible(pnw);
const nationalVisible = defaultVisible(elsewhere);
const pnwWindow = pnwVisible.slice(0, CARD_WINDOW);
const nationalWindow = nationalVisible.slice(0, CARD_WINDOW);
const pnwHasMore = pnwVisible.length > pnwWindow.length;
const nationalHasMore = nationalVisible.length > nationalWindow.length;
// True total match count under the default filter — reported on the results
// line and kept current by the client as filters change. Not the same as
// the rendered-card count once windowing is in play.
const totalVisibleDefault = pnwVisible.length + nationalVisible.length;

// Top city hubs for the shortened hero — parents should land on city pages.
const cityCounts = new Map();
for (const c of camps) {
  const key = `${c.state}|${c.city}`;
  cityCounts.set(key, (cityCounts.get(key) || 0) + 1);
}
const topCityHubs = [...cityCounts.entries()]
  .map(([key, count]) => {
    const [state, city] = key.split('|');
    return { state, city, count, href: `/camps/${state.toLowerCase()}/${slugifyCity(city)}/` };
  })
  .sort((a, b) => b.count - a.count)
  .slice(0, 6);
const escHub = (v: string) => v.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const topCityHubsHtml = topCityHubs
  .map((h) => `<a href="${escHub(h.href)}" class="text-rust hover:underline">${escHub(h.city)}, ${escHub(h.state)}</a>`)
  .join(' <span aria-hidden="true">·</span> ');

const featuredCardsHtml = featuredCamps.map((c) => renderFeaturedCardHtml(c, CAMP_SPORTS)).join('');
const recentlyAddedHtml = recentlyAddedCamps.map((c) => renderCardHtml(c, CAMP_SPORTS)).join('');
const pnwHtml = pnwWindow.map((c) => renderCardHtml(c, CAMP_SPORTS)).join('');
const nationalHtml = nationalWindow.map((c) => renderCardHtml(c, CAMP_SPORTS)).join('');

// The full campsLite dataset (every field the client's search, filters, and
// map read) no longer gets built or serialized here. Until 2026-07-31 this
// page built that array and inlined it as a JSON <script> island on every
// load (~253,500 bytes projected at 311 approved camps) even though nothing
// on the page needs it until JavaScript is ready to filter or map something
// — the server-rendered cards above need none of it. It now lives behind
// GET /api/camps/lite (src/pages/api/camps/lite.ts, sharing its projection
// with src/lib/camps-lite.ts), which the client script below fetches in the
// background after first paint. See
// reports/CAMPS-RENDERING-REBUILD-2026-07-31.md.

// JSON-LD: this directory hub emitted nothing before this fix (2026-07
// audit: "Schema.org emission is unverified across the site" -- verified
// live 2026-07-15, this page had zero <script type="application/ld+json">
// tags). BreadcrumbList is free. ItemList covers the featured camps when
// any exist (a curated, stable subset -- the right fit for ItemList, which
// wants a meaningful ranked/ordered list, not a raw dump of 1,300+ rows
// that reshuffles every 10 minutes as D1 changes).
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://parentcoachdesk.com' },
    { '@type': 'ListItem', position: 2, name: 'Camps & Leagues' },
  ],
};
const itemListSchema = featuredCamps.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: featuredCamps.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    url: `https://parentcoachdesk.com/camps/${c.slug}/`,
  })),
} : null;
---
<BaseLayout
  title="Youth Sports Camps and Leagues"
  description="Youth camps and league signups we know about. Starting in the Pacific Northwest where we can verify programs personally. National listings welcome."
  ogImage="/illustrations/og-camps.jpg"
>
  <script slot="head" type="application/ld+json" set:html={serializeJsonLd(breadcrumbSchema)} />
  {itemListSchema && <script slot="head" type="application/ld+json" set:html={serializeJsonLd(itemListSchema)} />}
  <section class="section-band">
    <div class="container-px py-8 md:py-10">
      <p class="t-eyebrow mb-2">Camps & Leagues</p>
      <h1 class="t-h1 font-display text-ink leading-tight font-medium">
        Find a camp your kid can actually do
      </h1>
      <p class="font-display text-ink-soft text-lg md:text-xl mt-3 max-w-2xl leading-snug">
        PNW-verified first · National listings growing. <a href="/camps/verification/" class="text-rust hover:underline">What Verified means</a>.
      </p>
      <p class="font-body text-ink-soft text-sm mt-2 max-w-2xl leading-relaxed">
        A “Verified” badge means our team compared the listed program details with its cited source. It does not mean PCD inspected the program or endorses its safety, quality, staff, insurance, or suitability for your child.
      </p>
      {topCityHubs.length > 0 && (
        <p class="font-body text-ink-soft text-sm mt-4 max-w-3xl">
          Browse top cities: <span set:html={topCityHubsHtml} />
        </p>
      )}
      <p class="font-body text-muted text-sm mt-3">
        <a href="/camps/submit/" class="text-rust hover:underline">I run a program → Submit</a>
        {' · '}
        <a href="/camps/suggest/" class="text-rust hover:underline">Suggest a program</a>
      </p>
    </div>
  </section>

  <section id="all-camps" class="section-band section-band-sunken">
    <div class="container-px py-8">
      {!dbAvailable ? (
        <div class="card p-6 max-w-xl">
          <p class="font-body text-ink-soft">Directory is warming up. Try again in a moment.</p>
        </div>
      ) : camps.length === 0 ? (
        <div class="card p-6 md:p-8">
          <Illo
            base="camps-empty-state"
            alt="A summer camp at golden hour: a wooded lakeside, a wooden dock, two canoes."
            class="w-full max-w-3xl mb-8 rounded-card"
            sizes="(min-width: 768px) 768px, 100vw"
          />
          <p class="t-eyebrow mb-3">Coming online</p>
          <h2 class="t-h2 font-display text-ink leading-tight max-w-2xl font-medium">
            No camps in the directory yet.
          </h2>
          <p class="font-display text-ink-soft mt-4 max-w-2xl leading-snug">
            We launched the directory recently. The first batch of Pacific-Northwest camps is being reviewed. If you run a camp or send your kid to one, you can <a href="/camps/submit/" class="text-rust hover:underline">submit it</a>. Submissions stay pending until a person reviews the available source evidence.
          </p>
        </div>
      ) : (
        <>
          <div
            id="camps-data-status"
            class="card p-4 mb-6 flex flex-wrap items-center gap-3 text-sm"
            aria-live="polite"
          >
            <span id="camps-data-status-text">Loading the full camp directory to power search and filters…</span>
            <button type="button" id="camps-data-retry" class="btn btn-ghost" style="min-height: 44px;" hidden>Try again</button>
          </div>
          <noscript><style>#camps-data-status{display:none}</style></noscript>

          {/* Find strip — primary parent path */}
          <div id="camp-filters" class="card mb-6 p-5 md:p-6">
            <form id="find-camp-form" class="space-y-4">
              <div class="flex flex-wrap items-end gap-3">
                <div class="flex-1 min-w-[12rem]">
                  <label for="filter-zip" class="font-display italic text-rust text-xs block mb-2 font-medium">Where</label>
                  <input
                    type="text"
                    id="filter-zip"
                    name="where"
                    placeholder="ZIP or city (e.g. 98406)"
                    maxlength="40"
                    autocomplete="postal-code"
                    class="min-h-11 font-display px-3 py-2 border border-input bg-paper-warm rounded-btn w-full min-w-0"
                    style="min-height: 44px;"
                  />
                </div>
                <div class="min-w-0">
                  <label for="filter-radius" class="font-display italic text-rust text-xs block mb-2 font-medium">Radius</label>
                  <select id="filter-radius" class="min-h-11 font-display px-3 py-2 border border-input bg-paper-warm rounded-btn w-full min-w-0" style="min-height: 44px;">
                    <option value="10">10 miles</option>
                    <option value="25" selected>25 miles</option>
                    <option value="50">50 miles</option>
                    <option value="100">100 miles</option>
                    <option value="all">Any distance</option>
                  </select>
                </div>
                <button type="submit" id="find-camp-submit" class="btn" style="min-height: 44px;">Search camps</button>
              </div>

              <div>
                <p class="font-display italic text-rust text-xs mb-2 font-medium" id="age-chips-label">Kid’s age</p>
                <div class="flex flex-wrap gap-2" role="group" aria-labelledby="age-chips-label">
                  <button type="button" data-age-chip="" class="tag-pill tag-pill-active age-chip" style="min-height: 44px;" data-active="true">Any</button>
                  {AGE_BANDS.map((b) => (
                    <button type="button" data-age-chip={b.slug} class="tag-pill tag-pill-outline age-chip" style="min-height: 44px;">{b.label}</button>
                  ))}
                </div>
                {/* Advanced min/max kept for accessibility contract + power users; visually in More filters too */}
                <div class="sr-only">
                  <label for="filter-age-min">Minimum age</label>
                  <input type="number" id="filter-age-min" aria-label="Minimum age" min="3" max="22" />
                  <label for="filter-age-max">Maximum age</label>
                  <input type="number" id="filter-age-max" aria-label="Maximum age" min="3" max="22" />
                </div>
              </div>

              <div>
                <p class="font-display italic text-rust text-xs mb-2 font-medium" id="when-chips-label">When <span class="font-body text-muted not-italic">(soft — many listings use placeholder dates)</span></p>
                <div class="flex flex-wrap gap-2" role="group" aria-labelledby="when-chips-label">
                  <button type="button" data-when-chip="" class="tag-pill tag-pill-active when-chip" style="min-height: 44px;" data-active="true">Any</button>
                  <button type="button" data-when-chip="this-month" class="tag-pill tag-pill-outline when-chip" style="min-height: 44px;">This month</button>
                  <button type="button" data-when-chip="next-month" class="tag-pill tag-pill-outline when-chip" style="min-height: 44px;">Next month</button>
                  <button type="button" data-when-chip="summer" class="tag-pill tag-pill-outline when-chip" style="min-height: 44px;">Summer</button>
                  <button type="button" data-when-chip="breaks" class="tag-pill tag-pill-outline when-chip" style="min-height: 44px;">Breaks</button>
                </div>
                <input type="hidden" id="filter-date-start" value="" />
                <input type="hidden" id="filter-date-end" value="" />
              </div>

              <div class="flex flex-wrap items-end gap-3">
                <div>
                  <label for="filter-sport" class="font-display italic text-rust text-xs block mb-2 font-medium">Activity <span class="font-body text-muted not-italic">(optional)</span></label>
                  <select id="filter-sport" class="min-h-11 font-display px-3 py-2 border border-input bg-paper-warm rounded-btn" style="min-height: 44px;">
                    <option value="">All activities</option>
                  </select>
                </div>
                <button type="button" id="toggle-more-filters" class="font-display italic text-rust text-sm hover:underline font-medium px-2" style="min-height: 44px;" aria-expanded="false" aria-controls="more-filters">More filters</button>
                <button type="button" id="clear-filters" class="font-display italic text-rust text-sm hover:underline font-medium px-2" style="min-height: 44px;">Clear all</button>
              </div>
            </form>

            <div id="more-filters" class="mt-5 pt-5 border-t border-bone space-y-4" hidden>
              <div class="flex flex-wrap items-end gap-4">
                <div>
                  <label for="filter-search" class="font-display italic text-rust text-xs block mb-2 font-medium">Camp name or org</label>
                  <input
                    type="search"
                    id="filter-search"
                    placeholder="Name, city, or keyword"
                    class="min-h-11 font-display px-3 py-2 border border-input bg-paper-warm rounded-btn w-64 max-w-full"
                    style="min-height: 44px;"
                  />
                </div>
                <div>
                  <label for="filter-state" class="font-display italic text-rust text-xs block mb-2 font-medium">State</label>
                  <select id="filter-state" class="min-h-11 font-display px-3 py-2 border border-input bg-paper-warm rounded-btn" style="min-height: 44px;">
                    <option value="">All states</option>
                  </select>
                </div>
                <div>
                  <p class="font-display italic text-rust text-xs mb-2 font-medium">Format</p>
                  <div class="flex gap-2">
                    <button type="button" data-filter-dayovernght="all" class="min-h-11 inline-flex items-center justify-center filter-toggle font-display px-3 py-2 border border-bone bg-paper-warm rounded-btn hover:bg-stripe transition-colors" data-active="true" style="min-height: 44px; background: var(--rust); color: white; border-color: var(--rust);">All</button>
                    <button type="button" data-filter-dayovernght="day" class="min-h-11 inline-flex items-center justify-center filter-toggle font-display px-3 py-2 border border-bone bg-paper-warm rounded-btn hover:bg-stripe transition-colors" style="min-height: 44px;">Day</button>
                    <button type="button" data-filter-dayovernght="overnight" class="min-h-11 inline-flex items-center justify-center filter-toggle font-display px-3 py-2 border border-bone bg-paper-warm rounded-btn hover:bg-stripe transition-colors" style="min-height: 44px;">Overnight</button>
                  </div>
                </div>
                <div>
                  <p class="font-display italic text-rust text-xs mb-2 font-medium">Include</p>
                  <div class="flex flex-wrap gap-2">
                    <button type="button" id="filter-show-leagues" class="min-h-11 inline-flex items-center justify-center filter-toggle font-display px-3 py-2 border border-bone bg-paper-warm rounded-btn hover:bg-stripe transition-colors" style="min-height: 44px;">Leagues</button>
                    <button type="button" id="filter-show-full" class="min-h-11 inline-flex items-center justify-center filter-toggle font-display px-3 py-2 border border-bone bg-paper-warm rounded-btn hover:bg-stripe transition-colors" style="min-height: 44px;">Include sold-out</button>
                  </div>
                </div>
              </div>
              <p class="font-body text-muted text-xs">Leagues and sold-out programs are hidden by default. Date pickers stay available for power users once date quality improves.</p>
              <div class="flex flex-wrap gap-3 items-end">
                <div>
                  <label for="filter-date-start-adv" class="font-display italic text-rust text-xs block mb-2 font-medium">Earliest start</label>
                  <input type="date" id="filter-date-start-adv" aria-label="Earliest start date" class="min-h-11 font-display px-2 py-2 border border-input bg-paper-warm rounded-btn" style="min-height: 44px;" />
                </div>
                <div>
                  <label for="filter-date-end-adv" class="font-display italic text-rust text-xs block mb-2 font-medium">Latest end</label>
                  <input type="date" id="filter-date-end-adv" aria-label="Latest end date" class="min-h-11 font-display px-2 py-2 border border-input bg-paper-warm rounded-btn" style="min-height: 44px;" />
                </div>
              </div>
              {/* Verified-only and Open-only hidden until data supports them (0 verified / all open today). */}
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <p class="font-body text-muted text-sm">
              <span id="camps-results-count" aria-live="polite">{totalVisibleDefault} camp{totalVisibleDefault === 1 ? '' : 's'} listed</span>
              <span id="camps-results-meta" class="text-ink-soft"></span>
              <span class="text-ink-soft"> · {recentlyAddedCount} added in the last {RECENTLY_ADDED_WINDOW_DAYS} days</span>
            </p>
            <div class="flex flex-wrap items-center gap-2">
              <div class="inline-flex border border-bone rounded-btn overflow-hidden" role="group" aria-label="Results view">
                <button type="button" id="view-list" class="min-h-11 px-3 font-display text-sm" data-active="true" style="min-height: 44px; background: var(--rust); color: white;">List</button>
                <button type="button" id="view-map" class="min-h-11 px-3 font-display text-sm bg-paper-warm" style="min-height: 44px;">Map</button>
              </div>
              <label for="filter-sort" class="sr-only">Sort</label>
              <select id="filter-sort" class="min-h-11 font-display px-3 py-2 border border-input bg-paper-warm rounded-btn text-sm" style="min-height: 44px;">
                <option value="newest">Newest</option>
                <option value="closest">Closest (needs ZIP)</option>
                <option value="starting">Starting soon</option>
              </select>
            </div>
          </div>
          <div id="camps-load-announcer" aria-live="polite" class="sr-only"></div>

          <div
            id="camps-map"
            class="mb-8 border border-bone rounded-card overflow-hidden flex items-center justify-center"
            style="height: 400px; width: 100%; background: var(--stripe);"
            aria-label="Map showing camps in the directory"
            hidden
          ><p class="font-body text-ink-soft text-sm px-4 text-center">Map loads when you choose Map view, after the camp directory is ready.</p></div>

          <div id="camps-empty-state" class="card p-6 mb-6 max-w-2xl" hidden>
            <h2 class="t-h3 font-display text-ink font-medium mb-2">No camps match</h2>
            <p id="camps-empty-copy" class="font-body text-ink-soft mb-4"></p>
            <div class="flex flex-wrap gap-2">
              <button type="button" id="empty-widen" class="btn btn-ghost" style="min-height: 44px;">Widen to 50 mi</button>
              <button type="button" id="empty-clear-when" class="btn btn-ghost" style="min-height: 44px;">Clear when</button>
              <a id="empty-browse-state" href="/camps/" class="btn btn-ghost" style="min-height: 44px; display: none;">Browse state</a>
              <a href="/camps/suggest/" class="btn btn-ghost" style="min-height: 44px;">Suggest a program</a>
            </div>
            <p class="font-body text-muted text-xs mt-4">We’re densest in the Pacific Northwest right now; national listings are lighter.</p>
          </div>

          <noscript><style>.js-show-more{display:none}</style></noscript>

          <div id="camps-directory">
            {pnw.length > 0 && (
              <div class="mb-12">
                <p class="t-eyebrow mb-3">Pacific Northwest</p>
                <div id="pnw-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" set:html={pnwHtml}></div>
                <div class="mt-6 text-center">
                  <button type="button" id="pnw-show-more" class="btn btn-ghost js-show-more" style="min-height: 44px;" hidden={!pnwHasMore}>Show more Pacific Northwest camps</button>
                </div>
                <noscript>
                  <p class="font-body text-ink-soft text-sm mt-4">Showing the first {pnwWindow.length} Pacific Northwest camps. Turn on JavaScript to filter, search by zip, see the map, or load more.</p>
                </noscript>
              </div>
            )}

            {elsewhere.length > 0 && (
              <div>
                <p class="t-eyebrow mb-3">National</p>
                <div id="national-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" set:html={nationalHtml}></div>
                <div class="mt-6 text-center">
                  <button type="button" id="national-show-more" class="btn btn-ghost js-show-more" style="min-height: 44px;" hidden={!nationalHasMore}>Show more National camps</button>
                </div>
                <noscript>
                  <p class="font-body text-ink-soft text-sm mt-4">Showing the first {nationalWindow.length} National camps. Turn on JavaScript to filter, search by zip, see the map, or load more.</p>
                </noscript>
              </div>
            )}
          </div>

          {(featuredCamps.length > 0 || recentlyAddedCamps.length > 0) && (
            <details class="mt-12 card p-5">
              <summary class="font-display text-ink font-medium cursor-pointer" style="min-height: 44px;">Featured & recently added</summary>
              {featuredCamps.length > 0 && (
                <div class="mt-6">
                  <p class="t-eyebrow mb-2">Featured</p>
                  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" set:html={featuredCardsHtml} />
                </div>
              )}
              {recentlyAddedCamps.length > 0 && (
                <div class="mt-8">
                  <p class="t-eyebrow mb-2">Recently added</p>
                  <div id="recently-added-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" set:html={recentlyAddedHtml} />
                </div>
              )}
            </details>
          )}
        </>
      )}
    </div>
  </section>

  <NewsletterSignup
    headline="New camps as we verify them"
    blurb="Subscribe and we'll send a Friday note when new camps land in the directory."
  />


  <script>
    // Leaflet + markercluster are dynamically imported when #camps-map
    // nears the viewport (see scheduleMapWhenVisible). Keeping them out of
    // the critical camps-index chunk saves a large map stack for readers
    // who never scroll to the map.
    import { buildCampDemandPayload } from '../../lib/camp-demand';
    import { renderCardHtml, escHtml, type SportOption } from '../../lib/camp-card';
    import type { Map as LeafletMap } from 'leaflet';

    // Leaflet module handle — set once ensureLeaflet() resolves.
    type LeafletNS = typeof import('leaflet')['default'];
    let L: LeafletNS | null = null;

    // Self-contained inline-SVG pin. The prior fix imported Leaflet's default
    // marker PNGs and pointed L.Icon.Default at them, but pins still didn't
    // render on the deployed site — the icon request resolved to the literal
    // URL /camps/[object%20Object] (a 404), because the imported PNG module
    // wasn't unwrapped to a plain string URL inside this bundled script. A
    // divIcon sidesteps the problem entirely: it's inline HTML/SVG, so
    // there's no image asset to resolve, hash, or 404 on.
    function campPinIcon() {
      if (!L) throw new Error('Leaflet not loaded');
      const w = 26;
      const h = 38;
      return L.divIcon({
        className: 'camp-pin',
        html: `<svg width="${w}" height="${h}" viewBox="0 0 26 38" xmlns="http://www.w3.org/2000/svg" style="display:block; filter: drop-shadow(0 1px 2px rgba(4,30,66,0.45));">
          <path d="M13 0C5.82 0 0 5.82 0 13c0 9.75 13 25 13 25s13-15.25 13-25C26 5.82 20.18 0 13 0z" fill="var(--accent)"/>
          <circle cx="13" cy="13" r="5" fill="var(--surface)"/>
        </svg>`,
        iconSize: [w, h],
        iconAnchor: [w / 2, h],
        popupAnchor: [0, -h + 4],
      });
    }

    (function () {
      interface LiteCamp {
        id: string;
        name: string;
        slug: string;
        sport: string;
        age_min: number;
        age_max: number;
        age_known: 0 | 1;
        start_date: string;
        end_date: string;
        city: string;
        state: string;
        day_or_overnight: string;
        spots_status: string;
        verified: 0 | 1;
        last_verified_at: string | null;
        program_type: string | null;
        latitude: number | null;
        longitude: number | null;
        description: string;
        hero_photo_key: string | null;
        price_text: string | null;
        date_added: string | null;
        registration_deadline: string | null;
        schedule_text: string | null;
      }
      // LiteCamp above must keep satisfying CardCamp (imported from
      // camp-card.ts) structurally — it's what gets handed to
      // renderCardHtml below. TypeScript enforces that at the call site.

      // Populated by loadCampsLite() below, in the background, after first
      // paint — not from an inline JSON island anymore. Every function in
      // this file that reads `camps` already ran fine with an empty array
      // before this change ever executed (nothing called them until the
      // bottom of this IIFE), so leaving them empty here and filling them in
      // once the fetch resolves is a safe default, not a special case.
      let camps: LiteCamp[] = [];
      let sportsList: SportOption[] = [];

      // Helper: get sport label (used by the map popup below; renderCardHtml
      // does its own lookup against the same sportsList internally).
      function sportLabel(slug: string): string {
        const match = sportsList.find(s => s.slug === slug);
        return match ? match.label : slug.split(/[\s_-]+/).map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      }

      const PNW = new Set(['WA', 'OR', 'ID', 'MT', 'AK']);
      const CARD_WINDOW = 24;

      // Pillar 14 QA (2026-07-31): the desktop CARD_WINDOW (24 per grid) at
      // 60 total first-paint cards (24 PNW + 24 National + 12 Recently
      // Added) projected to ~15,000-21,000px on a 390px viewport, still well
      // above the ~8,000px flag. This page is cached at Cloudflare's edge
      // (see the Cache-Control header up top) so the *server* can't render a
      // smaller window for phones without either breaking that shared cache
      // or adding Vary: viewport-width plumbing neither Cloudflare nor this
      // app has. But applyFilters() below already re-renders the grids from
      // campsLite on every load regardless of device, so the client can pick
      // a smaller starting window for narrow viewports without touching SSR
      // or the no-JS/crawler path at all. matches Tailwind's md breakpoint
      // (768px), same one .container-px and .t-card-title already use.
      const isMobileViewport = () => window.matchMedia('(max-width: 767px)').matches;
      // 6, not 24 — see the height arithmetic in
      // reports/CAMPS-RENDERING-REBUILD-2026-07-31.md. 6+6 grid cards + the
      // Recently Added rail capped to 3 on mobile (CSS, this file's
      // <style is:global> block) is what actually clears the ~8,000px flag
      // once the photo is also stripped on mobile; 8+8+4 (the first attempt)
      // still projected to ~8,400px, over the line.
      const CARD_WINDOW_MOBILE = 6;
      const activeCardWindow = () => (isMobileViewport() ? CARD_WINDOW_MOBILE : CARD_WINDOW);
      let pnwShown = activeCardWindow();
      let nationalShown = activeCardWindow();

      // Helper: haversine distance in miles
      function haversineMiles(lat1: number, lon1: number, lat2: number, lon2: number): number {
        const toRad = (d: number) => d * Math.PI / 180;
        const R = 3958.8;
        const dLat = toRad(lat2 - lat1);
        const dLon = toRad(lon2 - lon1);
        const a = Math.sin(dLat/2)**2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon/2)**2;
        return 2 * R * Math.asin(Math.sqrt(a));
      }

      // Helper: geocode zip via Nominatim. Uses structured query so the
      // country filter actually applies — `country=US` is silently ignored
      // when paired with free-text `q=`, which was causing "98101" to
      // resolve to a French postcode about 50% of the time. Falls back to
      // "ZIP, USA" free-text if structured returns nothing.
      async function geocodeZip(zip: string): Promise<{ lat: number; lon: number } | null> {
        // One user-triggered request only. Do not turn this into autocomplete
        // or add fallbacks: the public Nominatim service caps the application
        // at one request per second across all visitors.
        const url = `https://nominatim.openstreetmap.org/search?postalcode=${encodeURIComponent(zip)}&countrycodes=us&format=json&limit=1`;
        try {
          const r = await fetch(url, { headers: { 'Accept-Language': 'en' } });
          if (!r.ok) return null;
          const data = (await r.json()) as Array<{ lat: string; lon: string }>;
          if (!data.length) return null;
          const lat = parseFloat(data[0].lat);
          const lon = parseFloat(data[0].lon);
          if (Number.isFinite(lat) && Number.isFinite(lon)) return { lat, lon };
        } catch {
          // The directory remains usable through state and other filters.
        }
        return null;
      }

      // Filter state. showLeagues and showFull default to false so the page
      // opens with only camps that parents can actually sign up for right now.
      interface FilterState {
        search: string;
        sport: string;
        ageMin: number | null;
        ageMax: number | null;
        ageChip: string;
        dateStart: string;  // ISO YYYY-MM-DD; empty means no lower bound
        dateEnd: string;    // ISO YYYY-MM-DD; empty means no upper bound
        whenChip: string;
        dayOvernight: string;
        state: string;
        zipText: string;
        zipLat: number | null;
        zipLon: number | null;
        zipRadius: number;
        showLeagues: boolean;
        showFull: boolean;
        verifiedOnly: boolean;
        openOnly: boolean;
        sort: 'newest' | 'closest' | 'starting';
        view: 'list' | 'map';
      }
      const AGE_CHIP_RANGES: Record<string, [number, number]> = {
        '5-7': [5, 7], '8-10': [8, 10], '11-12': [11, 12], '13-14': [13, 14], '15-plus': [15, 22],
      };
      function ymd(d: Date): string {
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
      }
      function whenPresetRange(chip: string): { start: string; end: string } | null {
        if (!chip) return null;
        const now = new Date();
        const y = now.getFullYear();
        if (chip === 'this-month') {
          const start = new Date(y, now.getMonth(), 1);
          const end = new Date(y, now.getMonth() + 1, 0);
          return { start: ymd(start), end: ymd(end) };
        }
        if (chip === 'next-month') {
          const start = new Date(y, now.getMonth() + 1, 1);
          const end = new Date(y, now.getMonth() + 2, 0);
          return { start: ymd(start), end: ymd(end) };
        }
        if (chip === 'summer') {
          return { start: `${y}-06-01`, end: `${y}-08-31` };
        }
        if (chip === 'breaks') {
          // Soft: winter break + spring break window preference (Dec–Jan or Mar–Apr)
          // Implemented as OR via soft prefer — for filter we use Dec 15 – Apr 15 spanning school breaks.
          const startY = now.getMonth() >= 8 ? y : y - 1;
          return { start: `${startY}-12-15`, end: `${startY + 1}-04-15` };
        }
        return null;
      }
      let state: FilterState = {
        search: '',
        sport: '',
        ageMin: null,
        ageMax: null,
        ageChip: '',
        dateStart: '',
        dateEnd: '',
        whenChip: '',
        dayOvernight: 'all',
        state: '',
        zipText: '',
        zipLat: null,
        zipLon: null,
        zipRadius: 25,
        showLeagues: false,
        showFull: false,
        verifiedOnly: false,
        openOnly: false,
        sort: 'newest',
        view: 'list',
      };

      let map: LeafletMap | null = null;
      // Cluster group typed structurally — markercluster augments Leaflet at runtime.
      let clusterGroup: { clearLayers: () => void; addLayer: (layer: unknown) => void } | null = null;
      let mapInitStarted = false;
      let visibleCamps: LiteCamp[] = [];
      let demandTimer: ReturnType<typeof setTimeout> | undefined;

      // Default-off at the endpoint. The client sends only the minimized
      // payload returned by buildCampDemandPayload; precise location state is
      // deliberately used for filtering and discarded before this boundary.
      function scheduleDemandEvent() {
        if (demandTimer) clearTimeout(demandTimer);
        demandTimer = setTimeout(() => {
          const payload = buildCampDemandPayload(state, visibleCamps.length);
          if (!payload) return;
          fetch('/api/search-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          }).catch(() => {});
        }, 600);
      }

      async function ensureLeaflet() {
        if (L) return L;
        const leafletMod = await import('leaflet');
        await import('leaflet/dist/leaflet.css');
        // markercluster mutates the leaflet default export as a side effect.
        await import('leaflet.markercluster');
        await import('leaflet.markercluster/dist/MarkerCluster.css');
        await import('leaflet.markercluster/dist/MarkerCluster.Default.css');
        // Vite/ESM interop: prefer default, fall back to namespace.
        L = (leafletMod as { default?: LeafletNS }).default ?? (leafletMod as unknown as LeafletNS);
        return L;
      }

      // Initialize map once Leaflet is loaded. Safe to call repeatedly;
      // subsequent calls no-op after the first successful init.
      async function initMap() {
        const mapEl = document.getElementById('camps-map');
        if (!mapEl || map) return;

        const leaflet = await ensureLeaflet();

        // Leaflet does not clear a container's existing children on init —
        // it only errors if the container already holds a Leaflet map. The
        // "Map loads once..." fallback text (see the markup) is a real DOM
        // child of #camps-map, so it has to be cleared explicitly or it
        // would sit underneath the map panes Leaflet appends next.
        mapEl.innerHTML = '';

        const campsWithGeo = camps.filter(c => typeof c.latitude === 'number' && typeof c.longitude === 'number');

        // Default to a continental US frame so first paint shows the whole footprint,
        // not the math-centroid of all camps (which lands in Nebraska when most camps
        // are on the coasts).
        map = leaflet.map(mapEl, { scrollWheelZoom: false, attributionControl: true })
          .setView([39.5, -98.5], 4);

        leaflet.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '&copy; OpenStreetMap',
        }).addTo(map);

        // Cluster group replaces loose markers. Zoomed out shows count
        // bubbles; zooming in (or clicking a bubble) splits them down to
        // individual pins. Default cluster icons are pure CSS (no external
        // images), themed to the site's rust palette below.
        clusterGroup = leaflet.markerClusterGroup({
          maxClusterRadius: 60,
          spiderfyOnMaxZoom: true,
          showCoverageOnHover: false,
          iconCreateFunction(cluster) {
            const count = cluster.getChildCount();
            const size = count < 10 ? 'small' : count < 100 ? 'medium' : 'large';
            return leaflet.divIcon({
              html: `<div><span aria-label="${count} programs in this map area">${count}</span></div>`,
              className: `marker-cluster marker-cluster-${size}`,
              iconSize: leaflet.point(40, 40),
            });
          },
        });
        map.addLayer(clusterGroup);

        // Then fit to actual camp bounds. fitBounds beats centroid+zoom because it
        // frames every pin regardless of how skewed the distribution is.
        if (campsWithGeo.length > 0) {
          const bounds = leaflet.latLngBounds(campsWithGeo.map(c => [c.latitude, c.longitude] as [number, number]));
          map.fitBounds(bounds, { padding: [40, 40], maxZoom: 10 });
        }

        // Filters may have already computed visibleCamps before the map
        // library arrived; paint markers now.
        renderMap();
      }

      // Defer Leaflet download until the map is near the viewport (or
      // immediately if IntersectionObserver is unavailable).
      function scheduleMapWhenVisible() {
        if (mapInitStarted) return;
        const mapEl = document.getElementById('camps-map');
        if (!mapEl) return;
        mapInitStarted = true;
        const start = () => { void initMap(); };
        if (typeof IntersectionObserver === 'undefined') {
          start();
          return;
        }
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            start();
          }
        }, { rootMargin: '200px 0px' });
        io.observe(mapEl);
      }

      // Render map markers
      function renderMap() {
        if (!map || !clusterGroup || !L) return;
        const activeMap = map;
        const activeClusterGroup = clusterGroup;
        const leaflet = L;

        // Clear old markers — clearLayers empties the whole cluster group in
        // one call instead of removing pins one at a time.
        activeClusterGroup.clearLayers();

        // Track positions we've already pinned. Camps at the exact same coords get nudged
        // a tiny amount so all pins stay clickable instead of stacking under one another.
        const positionCounts: Record<string, number> = {};
        const jitterFor = (lat: number, lon: number): [number, number] => {
          const key = `${lat.toFixed(6)},${lon.toFixed(6)}`;
          const idx = positionCounts[key] || 0;
          positionCounts[key] = idx + 1;
          if (idx === 0) return [lat, lon];
          // ~0.0002 deg = ~70 ft. Spread overlapping pins in a small ring.
          const angle = (idx - 1) * (Math.PI * 2 / 6);
          const r = 0.00018;
          return [lat + r * Math.sin(angle), lon + r * Math.cos(angle)];
        };

        // Add markers for visible camps
        const pinnedCoords: [number, number][] = [];
        visibleCamps.forEach(c => {
          if (typeof c.latitude === 'number' && typeof c.longitude === 'number') {
            const [latJ, lonJ] = jitterFor(c.latitude, c.longitude);
            const marker = leaflet.marker([latJ, lonJ], { icon: campPinIcon() });
            // Escaped exactly like renderCardHtml — camp name/city/state come
            // from public submissions and moderator review does not guarantee
            // a raw script/HTML string in one of those fields gets caught, so
            // this popup is as much a stored-XSS surface as a card. Found
            // unescaped in QA (2026-07-31) and fixed here; leaflet's
            // bindPopup renders whatever string it is handed as real HTML.
            const popup = `<div style="font-size: 14px;">
              <strong>${escHtml(c.name)}</strong><br/>
              ${escHtml(c.city)}, ${escHtml(c.state)}<br/>
              ${escHtml(sportLabel(c.sport))}<br/>
              <a href="/camps/${escHtml(c.slug)}/" style="color: var(--rust); text-decoration: none;">View camp ↗</a>
            </div>`;
            marker.bindPopup(popup);
            activeClusterGroup.addLayer(marker);
            pinnedCoords.push([c.latitude, c.longitude]);
          }
        });

        // Re-fit bounds to whatever's currently visible. If a ZIP filter is
        // active, the user's center matters more than every pin, so leave the
        // existing zoom alone. Otherwise frame the visible set.
        if (pinnedCoords.length > 0 && state.zipLat == null) {
          const bounds = leaflet.latLngBounds(pinnedCoords);
          activeMap.fitBounds(bounds, { padding: [40, 40], maxZoom: 12 });
        }
      }

      // Apply all filters
      function applyFilters() {
        visibleCamps = camps.filter(c => {
          // Hide leagues unless toggled on. program_type may be undefined on
          // older rows imported before the schema was extended; treat those as 'camp'.
          const isLeague = c.program_type === 'league';
          if (isLeague && !state.showLeagues) return false;

          // Hide full programs unless toggled on.
          if (c.spots_status === 'full' && !state.showFull) return false;
          if (state.verifiedOnly && c.verified !== 1) return false;
          if (state.openOnly && c.spots_status !== 'open') return false;

          // Free-text search across name, city, and description. Case-insensitive
          // substring match. Empty string matches everything.
          if (state.search) {
            const q = state.search.toLowerCase();
            const haystack = `${c.name} ${c.city} ${c.description}`.toLowerCase();
            if (!haystack.includes(q)) return false;
          }

          // Sport
          if (state.sport && c.sport !== state.sport) return false;

          // Age range
          if ((state.ageMin !== null || state.ageMax !== null) && c.age_known !== 1) return false;
          if (state.ageMin !== null && c.age_max < state.ageMin) return false;
          if (state.ageMax !== null && c.age_min > state.ageMax) return false;

          // Date range — overlap test. Camp matches if any of its days fall
          // inside the requested window: camp.start <= filter.end AND
          // camp.end >= filter.start. Empty bound = no constraint on that side.
          if (state.dateStart && c.end_date < state.dateStart) return false;
          if (state.dateEnd && c.start_date > state.dateEnd) return false;

          // Day/overnight
          if (state.dayOvernight !== 'all' && c.day_or_overnight !== state.dayOvernight) return false;

          // State
          if (state.state && c.state !== state.state) return false;

          // Zip radius. Infinity means user picked "Any distance" — zip filter
          // is effectively off, all camps pass regardless of coordinates.
          if (state.zipLat !== null && state.zipLon !== null && Number.isFinite(state.zipRadius)) {
            if (typeof c.latitude !== 'number' || typeof c.longitude !== 'number') return false;
            const dist = haversineMiles(state.zipLat, state.zipLon, c.latitude, c.longitude);
            if (dist > state.zipRadius) return false;
          }

          return true;
        });

        // Soft "when" preference: listings with dates in the window rank
        // higher when a when chip is set, but year-long placeholders still
        // match (date honesty) — hard filter already applied above when
        // dateStart/dateEnd set. Soft prefer is handled in sortVisible().

        sortVisible();

        // Featured and Recently Added stay fully rendered (small, bounded
        // rails) and just get toggled with display:none like before. PNW
        // and National are the windowed grids — renderGrids() below rebuilds
        // their contents outright instead of hiding pre-existing nodes, so
        // skip them here to avoid doing (and then immediately overwriting)
        // the same work twice.
        document.querySelectorAll<HTMLElement>('.camp-card').forEach(card => {
          if (card.closest('#pnw-grid') || card.closest('#national-grid')) return;
          const campId = card.getAttribute('data-camp-id');
          const isVisible = visibleCamps.some(c => c.id === campId);
          card.style.display = isVisible ? '' : 'none';
        });

        // A new filter result restarts each region's window at the first
        // activeCardWindow() matches (device-sized — see its definition
        // above). "Show more" bumps pnwShown/nationalShown directly and
        // calls renderGrids() without going through here, so it isn't reset
        // out from under itself.
        pnwShown = activeCardWindow();
        nationalShown = activeCardWindow();
        renderGrids();
        updateResultsCount();
        updateEmptyState();
        renderMap();
        syncUrlFromState();
        applyViewMode();
      }

      function campDistance(c: LiteCamp): number {
        if (state.zipLat == null || state.zipLon == null) return Number.POSITIVE_INFINITY;
        if (typeof c.latitude !== 'number' || typeof c.longitude !== 'number') return Number.POSITIVE_INFINITY;
        return haversineMiles(state.zipLat, state.zipLon, c.latitude, c.longitude);
      }

      function overlapsWhen(c: LiteCamp): boolean {
        const range = whenPresetRange(state.whenChip);
        if (!range || !c.start_date || !c.end_date) return false;
        // Soft overlap; year-long placeholders often overlap everything — still ok as prefer signal.
        return c.start_date <= range.end && c.end_date >= range.start;
      }

      function sortVisible() {
        const today = ymd(new Date());
        visibleCamps = [...visibleCamps].sort((a, b) => {
          if (state.whenChip) {
            const ao = overlapsWhen(a) ? 0 : 1;
            const bo = overlapsWhen(b) ? 0 : 1;
            if (ao !== bo) return ao - bo;
          }
          if (state.sort === 'closest' && state.zipLat != null) {
            return campDistance(a) - campDistance(b);
          }
          if (state.sort === 'starting') {
            // Prefer real upcoming starts; missing/placeholder-far dates sort last.
            const as = a.start_date || '9999-12-31';
            const bs = b.start_date || '9999-12-31';
            const aPast = as < today ? 1 : 0;
            const bPast = bs < today ? 1 : 0;
            if (aPast !== bPast) return aPast - bPast;
            return as.localeCompare(bs);
          }
          // newest (default when no ZIP / honest fallback)
          return (b.date_added || '').localeCompare(a.date_added || '');
        });
      }

      function updateEmptyState() {
        const empty = document.getElementById('camps-empty-state');
        const copy = document.getElementById('camps-empty-copy');
        const browse = document.getElementById('empty-browse-state') as HTMLAnchorElement | null;
        const dir = document.getElementById('camps-directory');
        if (!empty || !copy) return;
        if (visibleCamps.length > 0) {
          empty.hidden = true;
          if (dir) dir.hidden = false;
          return;
        }
        empty.hidden = false;
        if (dir) dir.hidden = true;
        const ageBit = state.ageChip ? `age ${state.ageChip}` : (state.ageMin != null || state.ageMax != null ? 'that age' : 'any age');
        const whereBit = state.zipText ? `near ${state.zipText}` : (state.state ? `in ${state.state}` : 'anywhere');
        const whenBit = state.whenChip ? state.whenChip.replace('-', ' ') : 'any dates';
        copy.textContent = `No camps match ${ageBit} ${whereBit} for ${whenBit}.`;
        if (browse) {
          if (state.state) {
            browse.href = `/camps/${state.state.toLowerCase()}/`;
            browse.textContent = `Browse ${state.state}`;
            browse.style.display = '';
          } else if (state.zipLat != null && visibleCamps.length === 0) {
            // Keep link useful even without state — point at directory root.
            browse.href = '/camps/';
            browse.textContent = 'Browse directory';
            browse.style.display = '';
          } else {
            browse.style.display = 'none';
          }
        }
      }

      function applyViewMode() {
        const mapEl = document.getElementById('camps-map');
        const dir = document.getElementById('camps-directory');
        const listBtn = document.getElementById('view-list');
        const mapBtn = document.getElementById('view-map');
        const ACTIVE = 'background: var(--rust); color: white;';
        if (listBtn && mapBtn) {
          if (state.view === 'map') {
            listBtn.removeAttribute('data-active');
            listBtn.setAttribute('style', 'min-height: 44px;');
            mapBtn.setAttribute('data-active', 'true');
            mapBtn.setAttribute('style', `min-height: 44px; ${ACTIVE}`);
          } else {
            mapBtn.removeAttribute('data-active');
            mapBtn.setAttribute('style', 'min-height: 44px;');
            listBtn.setAttribute('data-active', 'true');
            listBtn.setAttribute('style', `min-height: 44px; ${ACTIVE}`);
          }
        }
        if (mapEl) mapEl.hidden = state.view !== 'map';
        // Keep directory visible under map unless empty-state hid it.
        if (dir && visibleCamps.length > 0) dir.hidden = false;
        if (state.view === 'map') scheduleMapWhenVisible();
      }

      function syncUrlFromState() {
        const url = new URL(window.location.href);
        const q = url.searchParams;
        const setOrDel = (key: string, val: string | null | undefined) => {
          if (val) q.set(key, val); else q.delete(key);
        };
        setOrDel('q', state.search || null);
        setOrDel('sport', state.sport || null);
        setOrDel('ages', state.ageChip || null);
        setOrDel('when', state.whenChip || null);
        setOrDel('format', state.dayOvernight !== 'all' ? state.dayOvernight : null);
        setOrDel('state', state.state || null);
        setOrDel('where', state.zipText || null);
        setOrDel('radius', state.zipLat != null ? String(Number.isFinite(state.zipRadius) ? state.zipRadius : 'all') : null);
        setOrDel('leagues', state.showLeagues ? '1' : null);
        setOrDel('soldout', state.showFull ? '1' : null);
        setOrDel('sort', state.sort !== 'newest' ? state.sort : null);
        setOrDel('view', state.view !== 'list' ? state.view : null);
        setOrDel('dateStart', state.dateStart && !state.whenChip ? state.dateStart : null);
        setOrDel('dateEnd', state.dateEnd && !state.whenChip ? state.dateEnd : null);
        const next = url.pathname + (q.toString() ? `?${q.toString()}` : '') + url.hash;
        const cur = window.location.pathname + window.location.search + window.location.hash;
        if (next !== cur) history.replaceState(null, '', next);
      }

      function readUrlIntoState() {
        const q = new URL(window.location.href).searchParams;
        state.search = q.get('q') || '';
        state.sport = q.get('sport') || '';
        state.ageChip = q.get('ages') || '';
        if (state.ageChip && AGE_CHIP_RANGES[state.ageChip]) {
          const [lo, hi] = AGE_CHIP_RANGES[state.ageChip];
          state.ageMin = lo;
          state.ageMax = hi;
        }
        state.whenChip = q.get('when') || '';
        // whenChip is soft — advanced date pickers alone set dateStart/dateEnd
        state.dateStart = q.get('dateStart') || '';
        state.dateEnd = q.get('dateEnd') || '';
        const fmt = q.get('format') || '';
        state.dayOvernight = fmt === 'day' || fmt === 'overnight' ? fmt : 'all';
        state.state = (q.get('state') || '').toUpperCase();
        state.zipText = q.get('where') || '';
        const radius = q.get('radius');
        if (radius === 'all') state.zipRadius = Infinity;
        else if (radius) state.zipRadius = parseInt(radius, 10) || 25;
        state.showLeagues = q.get('leagues') === '1';
        state.showFull = q.get('soldout') === '1';
        const sort = q.get('sort');
        state.sort = sort === 'closest' || sort === 'starting' ? sort : 'newest';
        state.view = q.get('view') === 'map' ? 'map' : 'list';
      }

      async function tryDeepLinkNearestCity(lat: number, lon: number): Promise<boolean> {
        try {
          const res = await fetch(`/api/camps/nearest?lat=${encodeURIComponent(String(lat))}&lon=${encodeURIComponent(String(lon))}`);
          if (!res.ok) return false;
          const data = await res.json() as { ok?: boolean; state?: string; city_slug?: string; count?: number };
          if (!data.ok || !data.state || !data.city_slug || !(data.count && data.count > 0)) return false;
          const ages = state.ageChip ? `?ages=${encodeURIComponent(state.ageChip)}` : '';
          window.location.assign(`/camps/${data.state.toLowerCase()}/${data.city_slug}/${ages}`);
          return true;
        } catch {
          return false;
        }
      }

      // Rebuilds the PNW and National grids from the current visibleCamps,
      // rendering only pnwShown / nationalShown cards per region through the
      // same renderCardHtml the server used for first paint. The map (see
      // renderMap) still gets every matching camp regardless of what's
      // rendered here — windowing is a DOM concern, not a data concern.
      function renderGrids() {
        const pnwMatches = visibleCamps.filter(c => PNW.has(c.state));
        const nationalMatches = visibleCamps.filter(c => !PNW.has(c.state));

        const pnwGrid = document.getElementById('pnw-grid');
        if (pnwGrid) pnwGrid.innerHTML = pnwMatches.slice(0, pnwShown).map(c => renderCardHtml(c, sportsList)).join('');

        const nationalGrid = document.getElementById('national-grid');
        if (nationalGrid) nationalGrid.innerHTML = nationalMatches.slice(0, nationalShown).map(c => renderCardHtml(c, sportsList)).join('');

        toggleShowMore('pnw-show-more', pnwMatches.length, pnwShown);
        toggleShowMore('national-show-more', nationalMatches.length, nationalShown);
      }

      function toggleShowMore(buttonId: string, totalMatches: number, shown: number) {
        const btn = document.getElementById(buttonId) as HTMLButtonElement | null;
        if (!btn) return;
        const remaining = totalMatches - shown;
        if (remaining > 0) {
          btn.hidden = false;
          btn.textContent = `Show ${Math.min(activeCardWindow(), remaining)} more (${remaining} left)`;
        } else {
          btn.hidden = true;
        }
      }

      // Screen-reader announcement for a "Show more" click — see the
      // #camps-load-announcer element in the markup above. renderGrids()
      // itself stays silent (it also runs from applyFilters(), which already
      // has its own results-count announcement) so only an actual "Show
      // more" click speaks up.
      function announceLoaded(label: string, added: number) {
        const el = document.getElementById('camps-load-announcer');
        if (el) el.textContent = `Showing ${added} more ${label} camps.`;
      }

      // Keeps the results line honest: the true total match count under the
      // current filters, not the number of cards actually in the DOM.
      function updateResultsCount() {
        const el = document.getElementById('camps-results-count');
        if (el) el.textContent = `${visibleCamps.length} camp${visibleCamps.length === 1 ? '' : 's'} listed`;
        const meta = document.getElementById('camps-results-meta');
        if (meta) {
          const bits: string[] = [];
          if (state.zipText && state.zipLat != null) {
            const r = Number.isFinite(state.zipRadius) ? `within ${state.zipRadius} mi` : 'any distance';
            bits.push(` near ${state.zipText} · ${r}`);
          }
          if (state.ageChip) bits.push(` · age ${state.ageChip}`);
          meta.textContent = bits.join('');
        }
      }

      // Populate dropdowns
      function populateFilters() {
        // Sport options
        const sportSelect = document.getElementById('filter-sport') as unknown as HTMLSelectElement;
        const uniqueSports = [...new Set(camps.map(c => c.sport))].sort();
        uniqueSports.forEach(sport => {
          const opt = document.createElement('option');
          opt.value = sport;
          opt.textContent = sportLabel(sport);
          sportSelect.appendChild(opt);
        });

        // State options
        const stateSelect = document.getElementById('filter-state') as unknown as HTMLSelectElement;
        const uniqueStates = [...new Set(camps.map(c => c.state))].sort();
        uniqueStates.forEach(st => {
          const opt = document.createElement('option');
          opt.value = st;
          opt.textContent = st;
          stateSelect.appendChild(opt);
        });
      }

      // Event listeners
      function attachListeners() {
        const ACTIVE_STYLE = 'background: var(--rust); color: white; border-color: var(--rust);';
        function setToggleActive(btn: HTMLElement, active: boolean) {
          if (active) {
            btn.setAttribute('data-active', 'true');
            btn.style.cssText = ACTIVE_STYLE;
          } else {
            btn.removeAttribute('data-active');
            btn.style.cssText = '';
          }
        }
        function setChipActive(selector: string, attr: string, value: string) {
          document.querySelectorAll<HTMLElement>(selector).forEach((btn) => {
            const v = btn.getAttribute(attr) || '';
            const on = v === value;
            btn.classList.toggle('tag-pill-active', on);
            btn.classList.toggle('tag-pill-outline', !on);
            if (on) btn.setAttribute('data-active', 'true'); else btn.removeAttribute('data-active');
          });
        }
        function paintControlsFromState() {
          const search = document.getElementById('filter-search') as HTMLInputElement | null;
          const sport = document.getElementById('filter-sport') as HTMLSelectElement | null;
          const ageMin = document.getElementById('filter-age-min') as HTMLInputElement | null;
          const ageMax = document.getElementById('filter-age-max') as HTMLInputElement | null;
          const st = document.getElementById('filter-state') as HTMLSelectElement | null;
          const zip = document.getElementById('filter-zip') as HTMLInputElement | null;
          const radius = document.getElementById('filter-radius') as HTMLSelectElement | null;
          const sort = document.getElementById('filter-sort') as HTMLSelectElement | null;
          const dateStartAdv = document.getElementById('filter-date-start-adv') as HTMLInputElement | null;
          const dateEndAdv = document.getElementById('filter-date-end-adv') as HTMLInputElement | null;
          if (search) search.value = state.search;
          if (sport) sport.value = state.sport;
          if (ageMin) ageMin.value = state.ageMin != null ? String(state.ageMin) : '';
          if (ageMax) ageMax.value = state.ageMax != null ? String(state.ageMax) : '';
          if (st) st.value = state.state;
          if (zip) zip.value = state.zipText;
          if (radius) radius.value = Number.isFinite(state.zipRadius) ? String(state.zipRadius) : 'all';
          if (sort) sort.value = state.sort;
          if (dateStartAdv) dateStartAdv.value = state.whenChip ? '' : state.dateStart;
          if (dateEndAdv) dateEndAdv.value = state.whenChip ? '' : state.dateEnd;
          const hiddenStart = document.getElementById('filter-date-start') as HTMLInputElement | null;
          const hiddenEnd = document.getElementById('filter-date-end') as HTMLInputElement | null;
          if (hiddenStart) hiddenStart.value = state.dateStart;
          if (hiddenEnd) hiddenEnd.value = state.dateEnd;
          setChipActive('.age-chip', 'data-age-chip', state.ageChip);
          setChipActive('.when-chip', 'data-when-chip', state.whenChip);
          document.querySelectorAll<HTMLElement>('[data-filter-dayovernght]').forEach((b) => {
            setToggleActive(b, b.getAttribute('data-filter-dayovernght') === state.dayOvernight);
          });
          const leagues = document.getElementById('filter-show-leagues');
          const full = document.getElementById('filter-show-full');
          if (leagues) setToggleActive(leagues, state.showLeagues);
          if (full) setToggleActive(full, state.showFull);
          applyViewMode();
        }

        // Free-text search
        document.getElementById('filter-search')?.addEventListener('input', (e) => {
          state.search = (e.target as HTMLInputElement).value.trim();
          applyFilters();
        });

        // Sport
        document.getElementById('filter-sport')?.addEventListener('change', (e) => {
          state.sport = (e.target as HTMLSelectElement).value;
          applyFilters();
        });

        // Age chips
        document.querySelectorAll<HTMLElement>('[data-age-chip]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const chip = btn.getAttribute('data-age-chip') || '';
            state.ageChip = chip;
            if (chip && AGE_CHIP_RANGES[chip]) {
              const [lo, hi] = AGE_CHIP_RANGES[chip];
              state.ageMin = lo;
              state.ageMax = hi;
            } else {
              state.ageMin = null;
              state.ageMax = null;
            }
            setChipActive('.age-chip', 'data-age-chip', chip);
            const ageMin = document.getElementById('filter-age-min') as HTMLInputElement | null;
            const ageMax = document.getElementById('filter-age-max') as HTMLInputElement | null;
            if (ageMin) ageMin.value = state.ageMin != null ? String(state.ageMin) : '';
            if (ageMax) ageMax.value = state.ageMax != null ? String(state.ageMax) : '';
            applyFilters();
          });
        });

        // Advanced age min/max (sr-only + kept for contract)
        document.getElementById('filter-age-min')?.addEventListener('input', (e) => {
          const v = (e.target as HTMLInputElement).value;
          state.ageMin = v ? parseInt(v, 10) : null;
          state.ageChip = '';
          setChipActive('.age-chip', 'data-age-chip', '');
          applyFilters();
        });
        document.getElementById('filter-age-max')?.addEventListener('input', (e) => {
          const v = (e.target as HTMLInputElement).value;
          state.ageMax = v ? parseInt(v, 10) : null;
          state.ageChip = '';
          setChipActive('.age-chip', 'data-age-chip', '');
          applyFilters();
        });

        // When chips (soft presets)
        document.querySelectorAll<HTMLElement>('[data-when-chip]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const chip = btn.getAttribute('data-when-chip') || '';
            state.whenChip = chip;
            // Soft preference only — do not hard-filter on dateStart/dateEnd.
            // Year-long placeholder sessions dominate; hard date filters feel broken.
            setChipActive('.when-chip', 'data-when-chip', chip);
            applyFilters();
          });
        });

        // Advanced date pickers
        document.getElementById('filter-date-start-adv')?.addEventListener('change', (e) => {
          state.dateStart = (e.target as HTMLInputElement).value || '';
          state.whenChip = '';
          setChipActive('.when-chip', 'data-when-chip', '');
          const hs = document.getElementById('filter-date-start') as HTMLInputElement | null;
          if (hs) hs.value = state.dateStart;
          applyFilters();
        });
        document.getElementById('filter-date-end-adv')?.addEventListener('change', (e) => {
          state.dateEnd = (e.target as HTMLInputElement).value || '';
          state.whenChip = '';
          setChipActive('.when-chip', 'data-when-chip', '');
          const he = document.getElementById('filter-date-end') as HTMLInputElement | null;
          if (he) he.value = state.dateEnd;
          applyFilters();
        });

        // Day/overnight
        document.querySelectorAll<HTMLElement>('[data-filter-dayovernght]').forEach((btn) => {
          btn.addEventListener('click', () => {
            document.querySelectorAll<HTMLElement>('[data-filter-dayovernght]').forEach((b) => setToggleActive(b, false));
            setToggleActive(btn, true);
            state.dayOvernight = btn.getAttribute('data-filter-dayovernght') || 'all';
            applyFilters();
          });
        });

        // State
        document.getElementById('filter-state')?.addEventListener('change', (e) => {
          state.state = (e.target as HTMLSelectElement).value;
          applyFilters();
        });

        // Sort
        document.getElementById('filter-sort')?.addEventListener('change', (e) => {
          const v = (e.target as HTMLSelectElement).value;
          state.sort = v === 'closest' || v === 'starting' ? v : 'newest';
          // Honest default: do not force Starting soon without ZIP/trustworthy dates —
          // user may still choose it explicitly.
          applyFilters();
        });

        // List | Map
        document.getElementById('view-list')?.addEventListener('click', () => {
          state.view = 'list';
          applyViewMode();
          syncUrlFromState();
        });
        document.getElementById('view-map')?.addEventListener('click', () => {
          state.view = 'map';
          applyViewMode();
          syncUrlFromState();
          renderMap();
        });

        // More filters disclosure
        document.getElementById('toggle-more-filters')?.addEventListener('click', () => {
          const panel = document.getElementById('more-filters');
          const btn = document.getElementById('toggle-more-filters');
          if (!panel || !btn) return;
          const open = panel.hasAttribute('hidden');
          if (open) panel.removeAttribute('hidden'); else panel.setAttribute('hidden', '');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });

        // Primary Find form — ZIP/city geocode + optional city deep-link
        document.getElementById('find-camp-form')?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const zipInput = document.getElementById('filter-zip') as HTMLInputElement;
          const raw = zipInput.value.trim();
          state.zipText = raw;
          if (!raw) {
            state.zipLat = null;
            state.zipLon = null;
            applyFilters();
            return;
          }

          const submitBtn = document.getElementById('find-camp-submit') as HTMLButtonElement | null;
          const originalLabel = submitBtn ? submitBtn.textContent : null;
          if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Searching…'; }

          // ZIP path preferred; city free-text falls through same Nominatim postalcode endpoint when digits.
          const looksLikeZip = /^\d{5}(-\d{4})?$/.test(raw);
          let geo: { lat: number; lon: number } | null = null;
          if (looksLikeZip) {
            geo = await geocodeZip(raw);
          } else {
            // City/place: structured Nominatim search, still no browser geolocation.
            try {
              const url = `https://nominatim.openstreetmap.org/search?city=${encodeURIComponent(raw)}&countrycodes=us&format=json&limit=1`;
              const r = await fetch(url, { headers: { 'Accept-Language': 'en' } });
              if (r.ok) {
                const data = (await r.json()) as Array<{ lat: string; lon: string }>;
                if (data.length) {
                  const lat = parseFloat(data[0].lat);
                  const lon = parseFloat(data[0].lon);
                  if (Number.isFinite(lat) && Number.isFinite(lon)) geo = { lat, lon };
                }
              }
            } catch { /* stay on filtered directory */ }
          }

          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalLabel; }

          if (!geo) {
            alert('Location not found. Try a 5-digit US ZIP or a city name.');
            return;
          }

          const radiusVal = (document.getElementById('filter-radius') as unknown as HTMLSelectElement).value;
          state.zipRadius = radiusVal === 'all' ? Infinity : parseInt(radiusVal, 10);
          state.zipLat = geo.lat;
          state.zipLon = geo.lon;
          if (state.sort === 'newest') {
            // Prefer Closest when a Where is set (spec default sort #1)
            state.sort = 'closest';
            const sortEl = document.getElementById('filter-sort') as HTMLSelectElement | null;
            if (sortEl) sortEl.value = 'closest';
          }

          // Deep-link to nearest city page when it has listings.
          const deepLinked = await tryDeepLinkNearestCity(geo.lat, geo.lon);
          if (deepLinked) return;

          applyFilters();
          scheduleDemandEvent();
        });

        document.getElementById('filter-zip')?.addEventListener('input', (e) => {
          const v = (e.target as HTMLInputElement).value;
          state.zipText = v.trim();
          if (!v.trim() && state.zipLat !== null) {
            state.zipLat = null;
            state.zipLon = null;
            if (state.sort === 'closest') {
              state.sort = 'newest';
              const sortEl = document.getElementById('filter-sort') as HTMLSelectElement | null;
              if (sortEl) sortEl.value = 'newest';
            }
            applyFilters();
          }
        });

        document.getElementById('filter-radius')?.addEventListener('change', (e) => {
          if (state.zipLat === null) return;
          const v = (e.target as HTMLSelectElement).value;
          state.zipRadius = v === 'all' ? Infinity : parseInt(v, 10);
          applyFilters();
        });

        document.getElementById('filter-show-leagues')?.addEventListener('click', (e) => {
          state.showLeagues = !state.showLeagues;
          setToggleActive(e.currentTarget as HTMLElement, state.showLeagues);
          applyFilters();
        });

        document.getElementById('filter-show-full')?.addEventListener('click', (e) => {
          state.showFull = !state.showFull;
          setToggleActive(e.currentTarget as HTMLElement, state.showFull);
          applyFilters();
        });

        // Empty-state coaches
        document.getElementById('empty-widen')?.addEventListener('click', () => {
          state.zipRadius = 50;
          const radius = document.getElementById('filter-radius') as HTMLSelectElement | null;
          if (radius) radius.value = '50';
          applyFilters();
        });
        document.getElementById('empty-clear-when')?.addEventListener('click', () => {
          state.whenChip = '';
          state.dateStart = '';
          state.dateEnd = '';
          setChipActive('.when-chip', 'data-when-chip', '');
          applyFilters();
        });

        // Clear filters
        document.getElementById('clear-filters')?.addEventListener('click', () => {
          state = {
            search: '', sport: '', ageMin: null, ageMax: null, ageChip: '',
            dateStart: '', dateEnd: '', whenChip: '', dayOvernight: 'all', state: '',
            zipText: '', zipLat: null, zipLon: null, zipRadius: 25,
            showLeagues: false, showFull: false, verifiedOnly: false, openOnly: false,
            sort: 'newest', view: 'list',
          };
          paintControlsFromState();
          applyFilters();
        });

        document.getElementById('pnw-show-more')?.addEventListener('click', () => {
          const step = activeCardWindow();
          pnwShown += step;
          renderGrids();
          announceLoaded('Pacific Northwest', step);
        });
        document.getElementById('national-show-more')?.addEventListener('click', () => {
          const step = activeCardWindow();
          nationalShown += step;
          renderGrids();
          announceLoaded('National', step);
        });

        const filterPanel = document.getElementById('camp-filters');
        if (filterPanel) {
          filterPanel.addEventListener('input', scheduleDemandEvent);
          filterPanel.addEventListener('change', scheduleDemandEvent);
          filterPanel.addEventListener('click', scheduleDemandEvent);
        }

        document.getElementById('camps-data-retry')?.addEventListener('click', () => {
          void loadCampsLite();
        });

        // Hydrate from shareable URL once; ZIP coords resolve after lite loads if where= present.
        readUrlIntoState();
        paintControlsFromState();
      }

      async function resolveWhereFromUrlIfNeeded() {
        if (!state.zipText || state.zipLat != null) return;
        const raw = state.zipText;
        const looksLikeZip = /^\d{5}(-\d{4})?$/.test(raw);
        let geo: { lat: number; lon: number } | null = null;
        if (looksLikeZip) geo = await geocodeZip(raw);
        else {
          try {
            const url = `https://nominatim.openstreetmap.org/search?city=${encodeURIComponent(raw)}&countrycodes=us&format=json&limit=1`;
            const r = await fetch(url, { headers: { 'Accept-Language': 'en' } });
            if (r.ok) {
              const data = (await r.json()) as Array<{ lat: string; lon: string }>;
              if (data.length) {
                const lat = parseFloat(data[0].lat);
                const lon = parseFloat(data[0].lon);
                if (Number.isFinite(lat) && Number.isFinite(lon)) geo = { lat, lon };
              }
            }
          } catch { /* ignore */ }
        }
        if (geo) {
          state.zipLat = geo.lat;
          state.zipLon = geo.lon;
          if (state.sort === 'newest') state.sort = 'closest';
          applyFilters();
        }
      }

      // ---- Background data load (2026-07-31, closes STANDARD-AUDIT.md item
      // #23 for this page) ----
      //
      // The full campsLite dataset used to arrive as an inline JSON <script>
      // island, present and parsed before this IIFE ever ran. It now comes
      // from GET /api/camps/lite, fetched here in the background after first
      // paint so the server-rendered cards above (which need none of this)
      // are never blocked on it. Everything that reads the full dataset —
      // every filter control, both "Show more" buttons, and the Leaflet map
      // — stays disabled until this resolves. Pillar 13 of the Website Build
      // Standard: a control that looks live but does nothing on click is a
      // fail, a disabled one with a stated reason is not.
      const CAMPS_LITE_ENDPOINT = '/api/camps/lite';

      // Every control the fetch above gates: the whole filter bar (search,
      // sport, age, dates, day/overnight, leagues/full/verified/open
      // toggles, state, zip + radius + its submit button, clear-filters) by
      // one selector, plus the two "Show more" buttons, which live outside
      // #camp-filters.
      function campsLiteGatedControls(): (HTMLInputElement | HTMLSelectElement | HTMLButtonElement)[] {
        const inFilterBar = Array.from(
          document.querySelectorAll('#camp-filters input, #camp-filters select, #camp-filters button'),
        ) as unknown as (HTMLInputElement | HTMLSelectElement | HTMLButtonElement)[];
        const showMore = [document.getElementById('pnw-show-more'), document.getElementById('national-show-more')]
          .filter((el): el is HTMLButtonElement => el !== null);
        return [...inFilterBar, ...showMore];
      }

      // The visible half of "state is announced, not just drawn": this text
      // is the on-screen banner itself, and (via aria-live="polite" on
      // #camps-data-status in the markup above) the same text change is what
      // a screen reader announces. One function, one source of truth for
      // both channels.
      function setDataStatus(message: string, opts: { visible: boolean; retryVisible: boolean; isError: boolean }) {
        const bar = document.getElementById('camps-data-status');
        const text = document.getElementById('camps-data-status-text');
        const retry = document.getElementById('camps-data-retry') as HTMLButtonElement | null;
        if (text) text.textContent = message;
        if (bar) {
          bar.hidden = !opts.visible;
          bar.style.borderColor = opts.isError ? 'var(--rust)' : '';
        }
        if (retry) retry.hidden = !opts.retryVisible;
      }

      function setControlsPending() {
        campsLiteGatedControls().forEach((el) => { el.disabled = true; });
        document.getElementById('camp-filters')?.setAttribute('data-pending', 'true');
        setDataStatus('Loading the full camp directory to power search, filters, and the map…', {
          visible: true,
          retryVisible: false,
          isError: false,
        });
      }

      function setControlsReady() {
        campsLiteGatedControls().forEach((el) => { el.disabled = false; });
        document.getElementById('camp-filters')?.removeAttribute('data-pending');
        // toggleShowMore() (called from renderGrids(), called from
        // applyFilters() below) already sets each "Show more" button's real
        // hidden/label state from the loaded data — the blanket `disabled =
        // false` above just lifts the pending gate; it does not override
        // that.
        setDataStatus('Full camp directory loaded. Search, filters, and the map are ready.', {
          visible: false,
          retryVisible: false,
          isError: false,
        });
      }

      function setControlsErrorState() {
        // Controls stay disabled — there is no full dataset to filter or map
        // without this fetch — but the page is still useful: every
        // server-rendered card above this point works with no JavaScript at
        // all, fetch failure or not. No raw error detail is shown (Pillar
        // 13: raw exceptions never reach the customer); the retry button is
        // the one actionable next step.
        document.getElementById('camp-filters')?.setAttribute('data-pending', 'true');
        setDataStatus(
          'Could not load the full camp directory. Search, filters, and the map are unavailable right now — the camps listed above still work. Try again, or check back shortly.',
          { visible: true, retryVisible: true, isError: true },
        );
      }

      async function loadCampsLite() {
        setControlsPending();
        try {
          const res = await fetch(CAMPS_LITE_ENDPOINT);
          if (!res.ok) throw new Error(`camps lite endpoint returned ${res.status}`);
          const data = (await res.json()) as { ok?: boolean; camps?: LiteCamp[]; sports?: SportOption[] };
          if (!data.ok || !Array.isArray(data.camps)) throw new Error('camps lite endpoint returned an unexpected shape');
          camps = data.camps;
          sportsList = data.sports ?? [];
          populateFilters();
          applyFilters(); // also renders the grids, the results count, and the map markers
          void resolveWhereFromUrlIfNeeded();
          if (state.view === 'map') scheduleMapWhenVisible();
          setControlsReady();
        } catch {
          setControlsErrorState();
        }
      }

      // requestIdleCallback (with a setTimeout fallback for Safari, which
      // has never shipped it) defers the fetch until the browser has an idle
      // moment after first paint — this is a background load, not a race
      // with rendering the page the reader actually asked for. A 2s timeout
      // caps how long a genuinely idle-starved page (heavy scroll/animation)
      // can delay it.
      function scheduleCampsLiteLoad() {
        const w = window as unknown as { requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number };
        if (typeof w.requestIdleCallback === 'function') {
          w.requestIdleCallback(() => { void loadCampsLite(); }, { timeout: 2000 });
        } else {
          setTimeout(() => { void loadCampsLite(); }, 200);
        }
      }

      // Initial setup. attachListeners() is safe to run immediately even
      // though the data it depends on hasn't arrived yet: setControlsPending()
      // (called first, synchronously, inside loadCampsLite() -> and mirrored
      // here so the disabled state exists from the first frame rather than
      // only once the fetch actually starts) disables every control these
      // listeners are bound to, and a disabled control does not fire input,
      // change, or click events in any browser this site supports.
      attachListeners();
      setControlsPending();
      scheduleCampsLiteLoad();
    })();
  </script>

  <style is:global>
    /* Pillar 14 mobile-height fix (2026-07-31 QA). At 390px the 16:9 photo
       is the single largest thing in a card (~179px + margin) and a phone
       reader can find a camp fine from the title, dates, location, and CTA
       alone — the photo is decoration at this width, not information the
       card can't work without. Hidden below md (768px, same breakpoint
       .container-px already uses); untouched on tablet/desktop. Combined
       with the smaller mobile "Show more" window in the script below and
       the Recently Added cap right after this rule — see
       reports/CAMPS-RENDERING-REBUILD-2026-07-31.md for the full
       arithmetic behind these three changes together. */
    @media (max-width: 767px) {
      .camp-card-photo { display: none; }

      /* Recently Added duplicates camps that are already in the PNW/National
         grids below it — it's a preview rail, not the only place a given
         camp appears. Capping it to 3 on a phone (from 12) removes real
         height without removing a camp from the directory; the same camp
         is still reachable through the main grids and "Show more". */
      #recently-added-grid > .camp-card:nth-child(n+4) { display: none; }
    }

    /* Pending state for the filter bar and "Show more" buttons (2026-07-31):
       disabled while the background camps-lite fetch (see loadCampsLite() in
       the client script) hasn't resolved yet. Native `disabled` already
       blocks interaction; this makes that state visibly obvious too, not
       just technically true — Pillar 6's "state is announced, not just
       drawn." */
    #camp-filters[data-pending="true"],
    .js-show-more:disabled {
      opacity: 0.55;
    }

    /* Cluster bubbles themed to the site's navy/accent palette instead of
       leaflet.markercluster's default green/yellow/orange. Pure CSS —
       no external images, so nothing here can 404 like the old marker did. */
    .marker-cluster-small,
    .marker-cluster-medium,
    .marker-cluster-large {
      background-color: color-mix(in srgb, var(--accent) 25%, transparent);
    }
    .marker-cluster-small div,
    .marker-cluster-medium div,
    .marker-cluster-large div {
      background-color: var(--accent);
      color: var(--surface);
      font-family: inherit;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }
  </style>

</BaseLayout>
