# The deploy truth source. NEVER cache this.
#
# /build-info.json exists to answer one question: what commit is actually live?
# Until 2026-09-04 it had no entry here, so it inherited the catch-all and got
# edge-cached like any other JSON. It then reported commit f9d92c37 / builtAt
# 2026-08-31 for four days straight while the site was in fact serving newer
# builds the whole time. Four separate pushes were diagnosed as "the deploy is
# broken" on the strength of that stale object. Nothing was broken.
#
# Two things read this endpoint and both are only as honest as it is:
# scripts/ci-deploy-guard.mjs (which decides whether to allow a deploy at all,
# and blocks when it thinks production is behind) and worker-cron's deploy_lag
# monitor. A cached value here does not merely mislead a human — it can wedge
# the guard into blocking deploys because of a number that was true yesterday.
/build-info.json
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex

# Static HTML: edge-cache for 5 minutes, browser-cache for 5 minutes, serve
# stale for 10 more while revalidating in the background. Cuts Asia/India TTFB
# from ~750ms to ~80ms on cache hits.
#
# These were s-maxage=86400 + stale-while-revalidate=86400 until 2026-09-04,
# on the stated assumption that "new deploys auto-purge the CF edge so readers
# always see fresh content." That assumption does not hold. On 2026-09-04 a
# deploy shipped three news items and two articles; every detail page was live
# immediately, while the homepage and /news/ index served the previous day's
# list. A manual Purge Everything was required to see them. Worst case under
# the old numbers was 48 hours of stale index pages on a site whose whole
# premise is "what's changing right now."
#
# 300 + 600 keeps almost all of the edge-cache benefit (a busy path still hits
# cache the overwhelming majority of the time) and bounds staleness at about
# 15 minutes instead of two days. If deploy-triggered purge is ever made
# reliable, these can go back up — but raise them only with a verified purge
# hook, not on the assumption that one exists.
/*.html
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=600

/
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=600

# Hashed asset bundles (Astro's _astro/ output) carry content hashes in the
# filename, so they're safe to cache for a year at the edge and in the browser.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Illustrations. Content-addressed by hand: a file's contents never change
# under a given name — a new picture gets a new filename — so these are safe to
# cache like hashed bundles. Before this rule they inherited the framework
# default (`max-age=0, must-revalidate`) and every illustration on the page
# round-tripped to the edge on every visit. Confirmed live 2026-07-30: the
# 134KB homepage hero revalidated on each load. That is the LCP image on mobile.
/illustrations/*
  Cache-Control: public, max-age=31536000, immutable

# Long-lived static assets that we update in place (no content hash). One day
# at the edge, an hour in the browser, allow stale-while-revalidate.
/og-default.jpg
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400
/og-default.webp
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400

# PDFs: same as static assets, cache aggressively at the edge.
/*.pdf
  Cache-Control: public, max-age=3600, s-maxage=86400

# Lock down admin paths even at the header layer. Belt-and-suspenders on top
# of the Cloudflare Access policy. Admin pages should never be edge-cached.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store

/api/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store
